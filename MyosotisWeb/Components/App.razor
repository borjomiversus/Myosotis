@using Microsoft.AspNetCore.DataProtection
@using MyosotisWeb.Infrastructure
@inject IDataProtectionProvider DataProtectionProvider
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Шрифти та іконки -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" href="images/favicon.png?v=2" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <!-- MudBlazor css -->
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- для Blazor -->
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MyosotisWeb.styles.css"]" />

    <!-- Tailwind css -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "prussian-blue": "#1A2235",
                            "space-indigo": "#332D57",
                            "glaucous": "#5C80BC",
                            "pearl-aqua": "#84DCC6",
                            "alice-blue": "#E2E8F0",
                            "toasted-almond": "#D4915A",

                            "background": "#1A2235",
                            "surface": "#1A2235",
                            "surface-container-lowest": "#1A2235",
                            "surface-variant": "#332D57",

                            "primary": "#84DCC6",
                            "secondary": "#5C80BC",
                            "secondary-text": "#7C98CC",
                            "secondary-fill": "#43608F",
                            "tertiary": "#D4915A",

                            "on-surface": "#E2E8F0",
                            "on-surface-variant": "#7C98CC",
                            "on-primary": "#1A2235",
                            "white": "#E2E8F0"
                        },
                        borderRadius: {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },
                        spacing: {
                            "space-lg": "1.5rem",
                            "space-md": "1rem",
                            "space-sm": "0.5rem",
                            "space-xs": "0.25rem",
                            "margin": "2.5rem",
                            "space-xl": "2rem",
                            "margin-mobile": "1rem",
                            "gutter": "1.5rem",
                            "gutter-mobile": "1rem"
                        },
                        fontFamily: {
                            "serif": ["Playfair Display", "serif"],
                            "sans": ["Montserrat", "sans-serif"],
                            "label-caps": ["Montserrat", "sans-serif"],
                            "body-md": ["Montserrat", "sans-serif"],
                            "stat-metric": ["Playfair Display", "serif"],
                            "headline-xl-mobile": ["Playfair Display", "serif"],
                            "body-lg": ["Montserrat", "sans-serif"],
                            "headline-xl": ["Playfair Display", "serif"],
                            "headline-lg-mobile": ["Playfair Display", "serif"],
                            "title-md": ["Montserrat", "sans-serif"],
                            "title-lg": ["Montserrat", "sans-serif"],
                            "label-sm": ["Montserrat", "sans-serif"],
                            "headline-lg": ["Playfair Display", "serif"],
                            "headline-md": ["Playfair Display", "serif"]
                        },
                        fontSize: {
                            "label-caps": ["11px", { lineHeight: "15px", letterSpacing: "0.10em", fontWeight: "700" }],
                            "body-md": ["13px", { lineHeight: "20px", fontWeight: "400" }],
                            "stat-metric": ["32px", { lineHeight: "36px", fontWeight: "600" }],
                            "headline-xl-mobile": ["28px", { lineHeight: "36px", letterSpacing: "-0.01em", fontWeight: "600" }],
                            "body-lg": ["15px", { lineHeight: "24px", fontWeight: "400" }],
                            "headline-xl": ["40px", { lineHeight: "48px", letterSpacing: "-0.02em", fontWeight: "600" }],
                            "headline-lg-mobile": ["22px", { lineHeight: "28px", letterSpacing: "0em", fontWeight: "500" }],
                            "title-md": ["14px", { lineHeight: "20px", letterSpacing: "0.02em", fontWeight: "600" }],
                            "title-lg": ["16px", { lineHeight: "24px", letterSpacing: "0.01em", fontWeight: "600" }],
                            "label-sm": ["11px", { lineHeight: "16px", letterSpacing: "0.02em", fontWeight: "500" }],
                            "headline-lg": ["28px", { lineHeight: "36px", letterSpacing: "-0.01em", fontWeight: "500" }],
                            "headline-md": ["20px", { lineHeight: "28px", letterSpacing: "0em", fontWeight: "500" }]
                        }
                    }
                }
            };
    </script>

    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body class="bg-background font-body-md text-body-md text-on-surface antialiased">

    <Routes @rendermode="InteractiveServer" ProtectedUserId="@_protectedUserId" />
    <ReconnectModal />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string _protectedUserId = string.Empty;

    protected override void OnInitialized()
    {
        if (HttpContext?.Items.TryGetValue("AnonUserId", out var idObj) != true ||
            idObj is not Guid userId ||
            userId == Guid.Empty)
        {
            throw new InvalidOperationException(
                "Anonymous user ID was not initialized by middleware.");
        }

        _protectedUserId = DataProtectionProvider
            .CreateProtector(UserSessionContext.ProtectionPurpose)
            .Protect(userId.ToString("N"));
    }
}