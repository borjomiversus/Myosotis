<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Шрифти та іконки -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <!-- MudBlazor CSS -->
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- Окремі стилі Blazor -->
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MyosotisWeb.styles.css"]" />

    <!-- Tailwind CSS та ПОВНА конфігурація -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "on-primary": "#00382e", "error-container": "#93000a", "surface-variant": "#2d3448", "secondary-fixed-dim": "#a9c7ff",
                            "on-tertiary-container": "#57507d", "surface": "#0b1325", "on-tertiary": "#312b54", "surface-dim": "#0b1325",
                            "surface-container-high": "#222a3d", "on-primary-fixed": "#00201a", "surface-container": "#171f32", "on-primary-fixed-variant": "#005143",
                            "primary-container": "#84dcc6", "secondary": "#a9c7ff", "error": "#ffb4ab", "primary": "#a0f9e2", "secondary-container": "#1e467f",
                            "secondary-fixed": "#d6e3ff", "inverse-surface": "#dae2fc", "on-error-container": "#ffdad6", "on-tertiary-fixed": "#1b153e",
                            "surface-bright": "#31394d", "surface-container-lowest": "#060e20", "on-background": "#dae2fc", "surface-container-highest": "#2d3448",
                            "on-surface": "#dae2fc", "on-secondary": "#003063", "inverse-primary": "#006b5a", "on-tertiary-fixed-variant": "#47416c",
                            "primary-fixed": "#9bf3dc", "on-error": "#690005", "primary-fixed-dim": "#7fd7c1", "on-secondary-fixed": "#001b3d",
                            "outline": "#88938f", "surface-tint": "#7fd7c1", "on-surface-variant": "#bdc9c4", "on-secondary-container": "#92b6f6",
                            "surface-container-low": "#131b2e", "on-primary-container": "#006252", "tertiary": "#ebe5ff", "inverse-on-surface": "#283044",
                            "outline-variant": "#3e4945", "background": "#0b1325", "tertiary-fixed": "#e5deff", "tertiary-container": "#cec6fa",
                            "on-secondary-fixed-variant": "#1e467f", "tertiary-fixed-dim": "#c9c0f4"
                        },
                        borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                        spacing: {
                            "space-lg": "1.5rem", "space-md": "1rem", "space-sm": "0.5rem", "space-xs": "0.25rem",
                            "margin": "2.5rem", "space-xl": "2rem", "margin-mobile": "1rem", "gutter": "1.5rem", "gutter-mobile": "1rem"
                        },
                        fontFamily: {
                            "label-caps": ["Montserrat"], "body-md": ["Montserrat"], "stat-metric": ["Playfair Display"],
                            "headline-xl-mobile": ["Playfair Display"], "body-lg": ["Montserrat"], "headline-xl": ["Playfair Display"],
                            "headline-lg-mobile": ["Playfair Display"], "title-md": ["Montserrat"], "title-lg": ["Montserrat"],
                            "label-sm": ["Montserrat"], "headline-lg": ["Playfair Display"], "headline-md": ["Playfair Display"]
                        },
                        fontSize: {
                            "label-caps": ["10px", { lineHeight: "14px", letterSpacing: "0.12em", fontWeight: "700" }],
                            "body-md": ["13px", { lineHeight: "20px", fontWeight: "400" }],
                            "stat-metric": ["32px", { lineHeight: "36px", fontWeight: "600" }],
                            "headline-xl-mobile": ["28px", { lineHeight: "36px", letterSpacing: "-0.01em", fontWeight: "600" }],
                            "body-lg": ["15px", { lineHeight: "24px", fontWeight: "400" }],
                            "headline-xl": ["40px", { lineHeight: "48px", letterSpacing: "-0.02em", fontWeight: "600" }],
                            "headline-lg-mobile": ["22px", { lineHeight: "28px", letterSpacing: "0em", fontWeight: "500" }],
                            "title-md": ["14px", { lineHeight: "20px", letterSpacing: "0.02em", fontWeight: "600" }],
                            "title-lg": ["16px", { lineHeight: "24px", letterSpacing: "0.01em", fontWeight: "600" }],
                            "label-sm": ["11px", { lineHeight: "16px", letterSpacing: "0.02em", fontWeight: "500" }],
                            "headline-lg": ["28px", { lineHeight: "36px", letterSpacing: "-0.01em", fontWeight: "500" }],
                            "headline-md": ["20px", { lineHeight: "28px", letterSpacing: "0em", fontWeight: "500" }]
                        }
                    }
                }
            };
    </script>

    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body class="bg-surface font-body-md text-body-md text-on-surface antialiased">

    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>