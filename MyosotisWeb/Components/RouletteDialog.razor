@using System.Globalization
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject MediaRecommendation RecService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="flex items-center gap-2.5 pr-8">
            <span class="material-symbols-outlined text-primary text-[24px]">casino</span>
            <div class="flex flex-col">
                <span class="font-headline-md text-on-surface font-serif text-lg">Cinematic Roulette</span>
                <span class="font-body-md text-[11px] text-secondary italic font-serif">Let the roulette choose tonight's story from what you've saved.</span>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="flex flex-col gap-5 py-2 w-full overflow-hidden">

            <div class="grid grid-cols-3 gap-3 w-full">

                <!-- 1. Watchlist -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-caps text-[10px] text-secondary uppercase tracking-wider px-1">Watchlist</label>
                    <select @bind="selectedWatchlistName"
                            style="background-color: #1A2235; color: #E2E8F0;"
                            class="w-full border border-secondary/30 rounded-xl px-3 py-2 bg-surface-container-lowest text-on-surface outline-none focus:border-primary hover:border-primary/60 hover:scale-[1.02] transition-all duration-200 font-body-md text-[12px] cursor-pointer truncate shadow-sm">
                        <option value="" style="background-color: #1A2235; color: #E2E8F0;">All Lists</option>
                        @foreach (var wl in Me.Watchlists)
                        {
                            <option value="@wl.Name" style="background-color: #1A2235; color: #E2E8F0;">@wl.Name</option>
                        }
                    </select>
                </div>

                <!-- 2. Genre -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-caps text-[10px] text-secondary uppercase tracking-wider px-1">Genre</label>
                    <select @bind="selectedGenre"
                            style="background-color: #1A2235; color: #E2E8F0;"
                            class="w-full border border-secondary/30 rounded-xl px-3 py-2 bg-surface-container-lowest text-on-surface outline-none focus:border-primary hover:border-primary/60 hover:scale-[1.02] transition-all duration-200 font-body-md text-[12px] cursor-pointer truncate shadow-sm">
                        <option value="" style="background-color: #1A2235; color: #E2E8F0;">Any Genre</option>
                        @foreach (var genre in availableGenres)
                        {
                            <option value="@genre" style="background-color: #1A2235; color: #E2E8F0;">@genre</option>
                        }
                    </select>
                </div>

                <!-- 3. Time -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-caps text-[10px] text-secondary uppercase tracking-wider px-1">Time</label>
                    <select @bind="selectedMaxMinutes"
                            style="background-color: #1A2235; color: #E2E8F0;"
                            class="w-full border border-secondary/30 rounded-xl px-3 py-2 bg-surface-container-lowest text-on-surface outline-none focus:border-primary hover:border-primary/60 hover:scale-[1.02] transition-all duration-200 font-body-md text-[12px] cursor-pointer truncate shadow-sm">
                        <option value="90" style="background-color: #1A2235; color: #E2E8F0;">≤ 1.5 hrs</option>
                        <option value="120" style="background-color: #1A2235; color: #E2E8F0;">≤ 2 hrs</option>
                        <option value="180" style="background-color: #1A2235; color: #E2E8F0;">≤ 3 hrs</option>
                        <option value="1000" style="background-color: #1A2235; color: #E2E8F0;">No limit</option>
                    </select>
                </div>

            </div>

            <!-- Постер-вікно -->
            <div class="relative w-full h-[250px] rounded-2xl overflow-hidden border border-secondary/30 bg-surface-container-lowest shadow-2xl flex flex-col justify-end p-5 group">

                @if (noResult)
                {
                    <div class="absolute inset-0 flex flex-col items-center justify-center bg-surface-container text-secondary gap-2 p-6 text-center">
                        <span class="material-symbols-outlined text-[36px] text-tertiary">error_outline</span>
                        <h4 class="font-headline-md text-on-surface text-[16px]">Could not load selection</h4>
                        <p class="font-body-md text-[12px] text-secondary italic">No titles match these filters. Try loosening your criteria.</p>
                    </div>
                }
                else if (displayMedia != null)
                {
                    <div class="absolute inset-0 bg-cover bg-center transition-all duration-500 @(isSpinning ? "blur-sm scale-105 opacity-60" : "opacity-80")"
                         style="@UiHelpers.CardBackground(displayMedia.PosterUrl)">
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-transparent"></div>

                    <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-primary/20 backdrop-blur-md border border-primary/30 text-primary font-label-caps text-[10px] uppercase tracking-wider font-bold z-10 shadow-sm">
                        @(isSpinning ? "Selecting..." : (pickedMedia != null ? "Tonight's Selection" : ""))
                    </div>

                    @if (!isSpinning && pickedMedia != null)
                    {
                        <div class="absolute top-3 right-3 flex items-center gap-1 z-10">
                            @if (Me.IsFavorite(pickedMedia))
                            {
                                <span class="material-symbols-outlined text-[18px] text-tertiary" style="font-variation-settings: 'FILL' 1;">favorite</span>
                            }
                        </div>
                    }

                    <div class="relative z-10 flex flex-col gap-1 animate-fadeIn">
                        <div class="font-body-md text-[11px] text-secondary flex items-center gap-2">
                            <span>@displayMedia.ReleaseYear</span>
                            <span>·</span>
                            <span>@(displayMedia is Series ? "TV Series" : "Movie")</span>
                            @if (displayMedia.Genres != null && displayMedia.Genres.Count > 0)
                            {
                                <span>·</span>
                                <span>@string.Join(", ", displayMedia.Genres)</span>
                            }
                        </div>

                        <h3 class="font-serif text-[24px] text-on-surface font-bold leading-tight drop-shadow-md">
                            @displayMedia.Title
                        </h3>

                        <p class="font-body-md text-[12px] text-on-surface-variant line-clamp-2 italic font-serif">
                            @(string.IsNullOrWhiteSpace(displayMedia.Description) ? "An immersive cinematic experience from your personal archive." : displayMedia.Description)
                        </p>
                    </div>
                }
                else
                {
                    <div class="absolute inset-0 flex flex-col items-center justify-center text-secondary gap-2">
                        <span class="material-symbols-outlined text-[36px]">movie_filter</span>
                        <p class="font-body-md text-[13px] italic">Spin the reel to reveal your next feature.</p>
                    </div>
                }
            </div>

        </div>
    </DialogContent>

    <DialogActions>
        <div class="flex justify-end w-full items-center pt-2 pb-2 pr-2 gap-3">

            @if (pickedMedia != null && !isSpinning)
            {
                <button @onclick="OpenDetails"
                        class="px-4 py-2.5 rounded-xl bg-surface-container-high text-on-surface hover:text-primary hover:border-primary/50 font-title-md text-[13px] transition-all border border-secondary/30 flex items-center gap-1.5 shadow-sm">
                    <span class="material-symbols-outlined text-[16px]">info</span>
                    <span>Open Details</span>
                </button>
            }

            <button @onclick="SpinAction"
                    disabled="@isSpinning"
                    class="px-7 py-2.5 rounded-full bg-primary text-background font-title-md font-bold hover:opacity-90 hover:scale-[1.03] transition-all shadow-[0_0_16px_rgba(132,220,198,0.3)] flex items-center gap-2 disabled:opacity-60">
                @if (isSpinning)
                {
                    <span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span>
                    <span>Spinning…</span>
                }
                else
                {
                    <span class="material-symbols-outlined text-[18px]">playing_cards</span>
                    <span>Spin</span>
                }
            </button>

        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    private string selectedWatchlistName = "";
    private string selectedGenre = "";
    private int selectedMaxMinutes = 1000;
    private bool isSpinning;
    private bool noResult;
    private Media? pickedMedia;
    private Media? displayMedia;
    private List<string> availableGenres = new List<string>();

    private User Me => DataService.CurrentUser;

    protected override void OnInitialized()
    {
        var planned = Me.GetPlannedMedia();
        foreach (var media in planned)
        {
            foreach (var genre in media.Genres)
            {
                if (!availableGenres.Contains(genre))
                    availableGenres.Add(genre);
            }
        }
        availableGenres.Sort();

        if (planned.Count > 0)
        {
            displayMedia = planned[new Random().Next(planned.Count)];
        }
        else
        {
            var all = DataService.GetAllMedia();
            if (all.Count > 0) displayMedia = all[new Random().Next(all.Count)];
        }
    }

    private bool IsInList(Media media, string listName)
    {
        foreach (var list in Me.Watchlists)
        {
            if (list.Name != listName) continue;
            foreach (var entry in list.Entries)
            {
                if (entry.Item == media) return true;
            }
        }
        return false;
    }

    private async Task SpinAction()
    {
        var pool = new List<Media>();
        foreach (var media in Me.GetPlannedMedia())
        {
            if (!string.IsNullOrEmpty(selectedWatchlistName) && !IsInList(media, selectedWatchlistName))
                continue;

            if (!string.IsNullOrEmpty(selectedGenre) && !media.Genres.Contains(selectedGenre))
                continue;

            int duration = media.TotalDurationMinutes > 0 ? media.TotalDurationMinutes : media.CalculateTimeDebt();
            if (selectedMaxMinutes < 1000 && duration > selectedMaxMinutes)
                continue;

            pool.Add(media);
        }

        if (pool.Count == 0)
        {
            noResult = true;
            pickedMedia = null;
            displayMedia = null;
            return;
        }

        isSpinning = true;
        noResult = false;
        pickedMedia = null;
        StateHasChanged();

        var rnd = new Random();
        for (int i = 0; i < 12; i++)
        {
            displayMedia = pool[rnd.Next(pool.Count)];
            StateHasChanged();
            await Task.Delay(120);
        }

        pickedMedia = pool[rnd.Next(pool.Count)];
        displayMedia = pickedMedia;
        isSpinning = false;
        StateHasChanged();
    }

    private void OpenDetails()
    {
        if (pickedMedia != null)
        {
            MudDialog.Close();
            Navigation.NavigateTo($"/media/{pickedMedia.Id}");
        }
    }
}