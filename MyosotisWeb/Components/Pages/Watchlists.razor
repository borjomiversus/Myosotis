@page "/watchlists"
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Watchlists</PageTitle>

<div class="w-full px-margin py-margin flex flex-col gap-10">

    <!-- Заголовок -->
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-secondary/25">
        <div class="flex flex-col gap-2">
            <h1 class="font-headline-xl text-headline-xl text-on-surface leading-none">Watchlists</h1>
            <p class="font-body-md text-[14px] text-secondary-text">Everything you meant to watch, sorted by status or your custom lists.</p>
        </div>

        <div class="font-body-md text-[13px] text-secondary-text flex items-center gap-2">
            <span>
                <strong class="text-on-surface font-semibold">@Me.Watchlists.Count</strong> @(Me.Watchlists.Count == 1 ? "custom list" : "custom lists")
            </span>
            <span class="text-secondary/40">·</span>
            <span>
                <strong class="text-on-surface font-semibold">@Me.MediaStates.Count</strong> tracked
            </span>
        </div>
    </header>

    <!-- статуси -->
    <section class="flex flex-col gap-4">
        <div class="flex items-center gap-4">
            <h2 class="font-serif text-[22px] text-on-surface">Library &amp; statuses</h2>
            <div class="flex-1 h-px bg-secondary/20"></div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            @foreach (var col in SmartCollections)
            {
                <a href="/collection/@col.Slug"
                   class="flex items-center gap-3 rounded-xl border border-secondary/25 bg-surface-variant/20 hover:border-primary/55 transition-colors p-4 group">

                    <div class="w-10 h-10 rounded-lg bg-background/90 border border-secondary/30 flex items-center justify-center shrink-0 @col.AccentClass">
                        <span class="material-symbols-outlined text-[20px]"
                              style="font-variation-settings: 'FILL' @(col.FillIcon ? "1" : "0");">
                            @col.Icon
                        </span>
                    </div>

                    <div class="flex flex-col min-w-0">
                        <span class="font-serif text-[16px] text-on-surface group-hover:text-primary transition-colors font-semibold truncate">
                            @col.Title
                        </span>
                        <span class="text-[12px] text-secondary-text font-body-md">
                            @col.Items.Count @(col.Items.Count == 1 ? "title" : "titles")
                        </span>
                    </div>
                </a>
            }
        </div>
    </section>

    <!-- вотчлісти -->
    <section class="flex flex-col gap-6 pt-2">
        <div class="flex items-center gap-4">
            <h2 class="font-serif text-[22px] text-on-surface">Custom lists</h2>
            <div class="flex-1 h-px bg-secondary/20"></div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 items-center bg-surface-variant/25 p-4 rounded-xl border border-secondary/30">
            <input @bind="newListName"
                   @bind:event="oninput"
                   @onkeydown="OnNewListKey"
                   placeholder="New list name…"
                   class="flex-1 w-full bg-background rounded-lg px-4 py-2.5 outline-none text-on-surface placeholder:text-secondary-text border border-secondary/30 focus:border-primary font-body-md text-[14px] transition-colors" />

            <button type="button"
                    @onclick="() => newListPrivate = !newListPrivate"
                    class="w-full sm:w-auto flex items-center justify-center px-4 py-2.5 rounded-lg border transition-colors select-none shrink-0 @(newListPrivate ? "bg-secondary-fill border-secondary/50 text-on-surface" : "bg-background border-secondary/35 text-secondary-text hover:text-on-surface")">
                <span class="font-title-md text-[13px]">
                    @(newListPrivate ? "Private" : "Public")
                </span>
            </button>

            <button @onclick="CreateList"
                    class="w-full sm:w-auto px-6 py-2.5 bg-primary text-on-primary rounded-lg font-title-md font-semibold text-[13px] hover:opacity-90 transition-opacity whitespace-nowrap">
                Create list
            </button>
        </div>

        @if (Me.Watchlists.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-14 text-center max-w-md mx-auto">
                <p class="font-body-md text-[14px] text-secondary-text leading-relaxed">
                    You don't have any custom lists yet. Enter a name above to create your first themed collection.
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var list in Me.Watchlists)
                {
                    int totalCount = list.Entries.Count;
                    int watchedCount = list.Entries.Count(e => Me.IsWatched(e.Item));
                    int unwatchedCount = totalCount - watchedCount;
                    int percent = totalCount > 0 ? (int)Math.Round((double)watchedCount / totalCount * 100) : 0;

                    <div class="relative h-[230px] rounded-xl border border-secondary/25 bg-surface-variant/25 hover:border-primary/50 transition-colors overflow-hidden group">

                        <a href="/watchlists/@Uri.EscapeDataString(list.Name)" class="absolute inset-0 z-10" aria-label="Open @list.Name"></a>

                        <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
                            <div class="absolute -right-2 -top-2 flex -space-x-10 opacity-80 group-hover:opacity-100 group-hover:-translate-y-1 transition-all duration-300 pt-6 pr-6">
                                @if (list.Entries.Any())
                                {
                                    var topEntries = list.Entries.Take(3).ToList();
                                    for (int i = 0; i < topEntries.Count; i++)
                                    {
                                        var entry = topEntries[i];
                                        string rotation = i == 0 ? "-rotate-12 mt-4" : i == 1 ? "-rotate-3 mt-1" : "rotate-12 mt-5";
                                        string zIndex = i == 0 ? "z-30" : i == 1 ? "z-20" : "z-10";

                                        <div class="@zIndex @rotation w-[80px] h-[115px] rounded-md bg-cover bg-center border border-secondary/35"
                                             style="@UiHelpers.CardBackground(entry.Item.PosterUrl)">
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <div class="absolute inset-0 bg-gradient-to-r from-background via-background/90 to-transparent z-10 pointer-events-none"></div>

                        <div class="relative z-20 h-full p-6 flex flex-col justify-between pointer-events-none">
                            <div class="flex items-center justify-between gap-2">
                                <span class="px-2.5 py-1 rounded-md bg-background/85 border border-secondary/30 font-title-md text-[11px] @(list.IsPrivate ? "text-on-surface" : "text-secondary-text")">
                                    @(list.IsPrivate ? "Private" : "Public")
                                </span>

                                <button type="button"
                                        @onclick="() => DeleteWatchlist(list)"
                                        @onclick:stopPropagation="true"
                                        @onclick:preventDefault="true"
                                        class="pointer-events-auto p-1.5 rounded-lg bg-background/85 text-secondary-text hover:text-tertiary border border-secondary/25 transition-colors opacity-0 group-hover:opacity-100 flex items-center justify-center"
                                        title="Delete watchlist">
                                    <span class="material-symbols-outlined text-[17px]">delete</span>
                                </button>
                            </div>

                            <div class="flex flex-col gap-3">
                                <div class="flex flex-col gap-1">
                                    <h3 class="font-serif text-[22px] text-on-surface group-hover:text-primary transition-colors font-semibold truncate">
                                        @list.Name
                                    </h3>
                                    <span class="text-[12px] text-secondary-text font-body-md">
                                        @totalCount @(totalCount == 1 ? "title" : "titles") · @unwatchedCount unwatched
                                    </span>
                                </div>

                                <div class="flex flex-col gap-1.5 pt-1">
                                    <div class="w-full h-1.5 rounded-full bg-secondary/20 overflow-hidden">
                                        <div class="h-full bg-primary rounded-full transition-all duration-300" style="width: @percent%;"></div>
                                    </div>
                                    <div class="flex items-center justify-between text-[12px] font-body-md">
                                        <span class="text-primary font-semibold">@percent% watched</span>
                                        <span class="text-secondary-text group-hover:text-primary font-title-md flex items-center gap-1 transition-colors">
                                            Open <span class="material-symbols-outlined text-[15px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private string newListName = "";
    private bool newListPrivate = true;

    private User Me => DataService.CurrentUser;

    private record SmartCollectionCard(
        string Slug,
        string Title,
        string Icon,
        string AccentClass,
        bool FillIcon,
        List<Media> Items);

    private List<SmartCollectionCard> SmartCollections => new()
    {
        new("favorites", "Favorites", "favorite", "text-tertiary", true,
            DataService.Library.Where(m => Me.IsFavorite(m)).ToList()),

        new("watching", "Watching", "play_circle", "text-primary", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Watching || s.Status == WatchStatus.Rewatching)
                .Select(s => s.Item)
                .ToList()),

        new("planned", "Planned", "bookmark", "text-primary", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Planned)
                .Select(s => s.Item)
                .ToList()),

        new("paused", "Paused", "pause_circle", "text-on-surface", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Paused)
                .Select(s => s.Item)
                .ToList()),

        new("dropped", "Dropped", "cancel", "text-tertiary", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Dropped)
                .Select(s => s.Item)
                .ToList()),

        new("watched", "Watched", "check_circle", "text-primary", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Watched)
                .Select(s => s.Item)
                .ToList())
    };

    private async Task OnNewListKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateList();
    }

    private async Task CreateList()
    {
        string name = newListName.Trim();
        if (string.IsNullOrEmpty(name)) return;

        if (Me.Watchlists.Any(w => w.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add("A list with this name already exists", Severity.Warning);
            return;
        }

        Me.CreateWatchlist(name, newListPrivate);

        await DataService.SaveStateAsync();

        Snackbar.Add($"List \"{name}\" created", Severity.Success);
        newListName = "";
    }

    private async Task DeleteWatchlist(Watchlist list)
    {
        bool success = Me.RemoveWatchlist(list.Id);
        if (success)
        {
            await DataService.SaveStateAsync();

            Snackbar.Add($"Watchlist \"{list.Name}\" removed", Severity.Info);
            StateHasChanged();
        }
    }
}