@page "/watchlists"
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Watchlists</PageTitle>

<div class="max-w-[1200px] mx-auto px-margin py-margin">

    <div class="mb-space-xl">
        <h1 class="font-headline-xl text-headline-xl text-on-surface">Watchlists</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant/80 italic font-serif">Everything you meant to watch, sorted your way.</p>
    </div>

    <!-- Нова підбірка -->
    <div class="flex flex-wrap gap-3 items-center bg-surface-container-high p-4 rounded-xl mb-space-xl">
        <input @bind="newListName"
               @bind:event="oninput"
               @onkeydown="OnNewListKey"
               placeholder="New list name…"
               class="flex-1 min-w-[200px] bg-surface-container-low rounded-lg px-4 py-2 outline-none text-on-surface placeholder:text-on-surface-variant/60 border border-surface-variant/40 focus:border-primary-container" />
        <label class="flex items-center gap-2 text-on-surface-variant">
            <input type="checkbox" @bind="newListPrivate" /> Private
        </label>
        <button @onclick="CreateList" class="px-4 py-2 bg-primary-container text-on-primary-container rounded-lg font-title-md hover:bg-primary transition-colors">Create list</button>
    </div>

    @foreach (var list in Me.Watchlists)
    {
        <section class="mb-space-xl">
            <div class="flex items-baseline justify-between mb-space-md">
                <h2 class="font-headline-md text-headline-md text-on-surface font-serif">@list.Name</h2>
                <span class="font-label-sm text-label-sm text-on-surface-variant">
                    @list.Entries.Count titles · @UiHelpers.FormatMinutes(list.GetTotalTimeDebt()) · @(list.IsPrivate ? "private" : "public")
                </span>
            </div>

            @if (list.Entries.Count == 0)
            {
                <p class="font-body-md text-on-surface-variant">Empty. Add titles from Search or from your Captures.</p>
            }
            else
            {
                <div class="bg-surface-container-high rounded-2xl overflow-hidden">
                    @foreach (var entry in list.Entries.ToList())
                    {
                        var item = entry.Item;
                        bool watched = Me.IsWatched(item);

                        <div class="flex items-center justify-between gap-4 px-5 py-4 border-t border-surface-variant/30 first:border-t-0">
                            <div class="min-w-0">
                                <div class="font-title-md text-title-md text-on-surface">
                                    @item.Title
                                    <span class="ml-2 font-label-sm text-label-sm text-on-surface-variant">@item.ReleaseYear · @(item is Series ? "Series" : "Movie")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.PersonalNote))
                                {
                                    <div class="mt-0.5 font-label-sm text-label-sm italic text-on-surface-variant">&ldquo;@entry.PersonalNote&rdquo;</div>
                                }
                            </div>

                            <div class="flex items-center gap-3 shrink-0">
                                <span class="font-label-sm text-label-sm text-on-surface-variant">@UiHelpers.FormatMinutes(item.CalculateTimeDebt())</span>

                                @if (watched)
                                {
                                    <span class="flex items-center gap-1 text-primary font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[16px]">task_alt</span> watched
                                    </span>
                                }
                                else
                                {
                                    <button @onclick="() => MarkWatched(item)" class="px-3 py-1.5 rounded-lg bg-surface-container-low text-on-surface hover:bg-primary-container hover:text-on-primary-container transition-colors font-label-sm text-label-sm">Watched</button>
                                }

                                <button @onclick="() => Remove(list, item)" class="w-8 h-8 rounded-full text-on-surface-variant hover:bg-surface-variant hover:text-on-surface transition-colors flex items-center justify-center">
                                    <span class="material-symbols-outlined text-[18px]">close</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private string newListName = "";
    private bool newListPrivate = true;

    private User Me => DataService.CurrentUser;

    private void OnNewListKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") CreateList();
    }

    private void CreateList()
    {
        string name = newListName.Trim();
        if (name == "") return;

        if (Me.Watchlists.Any(w => w.Name == name))
        {
            Snackbar.Add("A list with this name already exists", Severity.Warning);
            return;
        }

        Me.CreateWatchlist(name, newListPrivate);
        Snackbar.Add($"List \"{name}\" created", Severity.Success);
        newListName = "";
    }

    private void MarkWatched(Media item)
    {
        Me.CompleteWatching(item);
        Snackbar.Add($"\"{item.Title}\" marked as watched", Severity.Success);
    }

    private void Remove(Watchlist list, Media item)
    {
        list.RemoveEntry(item);
    }
}
