@page "/watchlists"
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Watchlists</PageTitle>

<div class="max-w-[1200px] mx-auto px-margin py-margin flex flex-col gap-10">

    <!-- Заголовок -->
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div class="flex flex-col">
            <h1 class="font-headline-xl text-headline-xl text-[#E2E8F0]">Watchlists</h1>
            <p class="font-body-lg text-body-lg text-secondary italic font-serif">Everything you meant to watch, sorted your way.</p>
        </div>

        
        <div class="hidden lg:flex items-center gap-2 bg-secondary/10 border border-secondary/20 px-4 py-2 rounded-lg">
            <span class="material-symbols-outlined text-secondary text-[18px]"></span>
            <span class="font-body-md text-[12px] text-secondary">Total:</span>
            <span class="text-primary font-bold">@Me.Watchlists.Count</span>
        </div>
    </header>

    <div class="flex flex-col sm:flex-row gap-3 items-center bg-secondary/10 backdrop-blur-md p-4 rounded-xl border border-secondary/30 shadow-xl">
        <input @bind="newListName"
               @bind:event="oninput"
               @onkeydown="OnNewListKey"
               placeholder="New list name…"
               class="flex-1 w-full bg-background rounded-xl px-4 py-2.5 outline-none text-[#E2E8F0] placeholder:text-secondary/60 border border-secondary/30 focus:border-primary font-body-md" />

        <button type="button" 
                @onclick="() => newListPrivate = !newListPrivate"
                class="flex items-center gap-2 px-4 py-2.5 rounded-xl border transition-all duration-300 select-none shrink-0 @(newListPrivate ? "bg-primary/15 border-primary/40 text-primary shadow-[0_0_12px_rgba(78,236,213,0.15)]" : "bg-secondary/10 border-secondary/30 text-secondary hover:text-white")">
            <span class="material-symbols-outlined text-[18px]">
                @(newListPrivate ? "lock" : "lock_open")
            </span>
            <span class="font-title-md text-[13px]">
                @(newListPrivate ? "Private" : "Public")
            </span>
        </button>

        <button @onclick="CreateList" class="w-full sm:w-auto px-6 py-2.5 bg-primary text-background rounded-xl font-title-md font-bold hover:opacity-90 transition-all shadow-[0_0_15px_rgba(132,220,198,0.2)] whitespace-nowrap">
            Create list
        </button>
    </div>

    <!-- Сітка вочлістів -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var list in Me.Watchlists)
        {
            int totalCount = list.Entries.Count;
            int watchedCount = list.Entries.Count(e => Me.IsWatched(e.Item));
            int unwatchedCount = totalCount - watchedCount;
            int percent = totalCount > 0 ? (int)Math.Round((double)watchedCount / totalCount * 100) : 0;

            <a href="/watchlists/@Uri.EscapeDataString(list.Name)"
               class="relative h-[240px] rounded-2xl border border-secondary/20 bg-gradient-to-br from-secondary/15 via-background to-secondary/5 hover:border-primary/50 transition-all duration-300 cursor-pointer overflow-hidden p-6 flex flex-col justify-between shadow-xl group">

                <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
                    <div class="absolute -right-2 -top-2 flex -space-x-10 opacity-75 group-hover:opacity-100 group-hover:-translate-y-1 group-hover:scale-105 transition-all duration-500 pt-6 pr-6">
                        @if (list.Entries.Any())
                        {
                            var topEntries = list.Entries.Take(3).ToList();
                            for (int i = 0; i < topEntries.Count; i++)
                            {
                                var entry = topEntries[i];
                                string rotation = i == 0 ? "-rotate-12 mt-4" : i == 1 ? "-rotate-3 mt-1" : "rotate-12 mt-5";
                                string zIndex = i == 0 ? "z-30" : i == 1 ? "z-20" : "z-10";

                                <div class="@zIndex @rotation w-[80px] h-[115px] rounded-lg bg-cover bg-center border border-secondary/30 shadow-2xl transition-transform duration-300"
                                     style="@UiHelpers.CardBackground(entry.Item.PosterUrl)">
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="absolute inset-0 bg-gradient-to-r from-background via-background/90 to-transparent z-10 pointer-events-none"></div>

                <div class="relative z-20 flex items-center justify-between">
                    <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-background/80 border border-secondary/30 text-secondary font-label-caps text-[10px] uppercase tracking-wider backdrop-blur-md">
                        <span class="material-symbols-outlined text-[12px]">@(list.IsPrivate ? "lock" : "lock_open")</span>
                        @(list.IsPrivate ? "Private" : "Public")
                    </span>
                </div>

                <div class="relative z-20 flex flex-col gap-3">
                    <div class="flex flex-col gap-1">
                        <h3 class="font-serif text-[22px] text-white group-hover:text-primary transition-colors font-bold truncate">
                            @list.Name
                        </h3>
                        <span class="text-[12px] text-secondary font-body-md">
                            @totalCount titles · <span class="text-secondary/80">@unwatchedCount unwatched</span>
                        </span>
                    </div>

                    <div class="flex flex-col gap-1.5 pt-1">
                        <div class="w-full h-1.5 rounded-full bg-secondary/20 overflow-hidden">
                            <div class="h-full bg-primary rounded-full transition-all duration-500" style="width: @percent%;"></div>
                        </div>
                        <div class="flex items-center justify-between text-[12px]">
                            <span class="text-primary font-bold">@percent% watched</span>
                            <span class="text-secondary group-hover:text-primary font-semibold flex items-center gap-1 transition-colors">
                                Open <span class="material-symbols-outlined text-[14px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>

</div>

@code {
    private string newListName = "";
    private bool newListPrivate = true;

    private User Me => DataService.CurrentUser;

    private void OnNewListKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") CreateList();
    }

    private void CreateList()
    {
        string name = newListName.Trim();
        if (name == "") return;

        if (Me.Watchlists.Any(w => w.Name == name))
        {
            Snackbar.Add("A list with this name already exists", Severity.Warning);
            return;
        }

        Me.CreateWatchlist(name, newListPrivate);
        Snackbar.Add($"List \"{name}\" created", Severity.Success);
        newListName = "";
    }
}