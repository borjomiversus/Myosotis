@page "/watchlists"
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Watchlists</PageTitle>

<div class="w-full px-margin py-margin flex flex-col gap-12">

    <!-- Заголовок -->
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-secondary/25">
        <div class="flex flex-col gap-2">
            <h1 class="font-headline-xl text-headline-xl text-on-surface leading-none">Watchlists</h1>
            <p class="font-body-md text-[14px] text-secondary-text">Everything you meant to watch, sorted by status or your custom lists.</p>
        </div>

        <div class="font-body-md text-[13px] text-secondary-text flex items-center gap-2">
            <span>
                <strong class="text-on-surface font-semibold">@Me.Watchlists.Count</strong> @(Me.Watchlists.Count == 1 ? "custom list" : "custom lists")
            </span>
            <span class="text-secondary/40">·</span>
            <span>
                <strong class="text-on-surface font-semibold">@Me.MediaStates.Count</strong> tracked
            </span>
        </div>
    </header>

    <section class="flex flex-col gap-4">
        <div class="flex items-center gap-4">
            <h2 class="font-serif text-[22px] text-on-surface">Library &amp; statuses</h2>
            <div class="flex-1 h-px bg-secondary/20"></div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 border border-secondary/25 rounded-lg overflow-hidden bg-surface-variant/10 divide-y sm:divide-y-0 sm:divide-x divide-secondary/20">
            @foreach (var col in SmartCollections)
            {
                <a href="/collection/@col.Slug"
                   class="relative p-5 flex flex-col justify-between gap-6 hover:bg-surface-variant/30 transition-colors group">

                    <div class="flex items-center justify-end">
                        <span class="material-symbols-outlined text-[16px] opacity-60 group-hover:opacity-100 transition-opacity @col.AccentClass"
                              style="font-variation-settings: 'FILL' @(col.FillIcon ? "1" : "0");">
                            @col.Icon
                        </span>
                    </div>

                    <div class="flex flex-col gap-0.5">
                        <span class="font-serif text-[28px] leading-none text-on-surface group-hover:text-primary transition-colors">
                            @col.Items.Count
                        </span>
                        <span class="font-title-md text-[13px] text-secondary-text group-hover:text-on-surface transition-colors mt-1.5">
                            @col.Title
                        </span>
                    </div>

                    <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-primary scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"></span>
                </a>
            }
        </div>
    </section>

    <!-- Кастомні колекції -->
    <section class="flex flex-col gap-7">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-4 border-b border-secondary/20">
            <div class="flex flex-col gap-1">
                <h2 class="font-serif text-[24px] text-on-surface leading-tight">Custom lists</h2>
                <p class="font-body-md text-[13px] text-secondary-text">Personal collections grouped by mood, director, or theme.</p>
            </div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
                <div class="relative flex-1 sm:w-64">
                    <input @bind="newListName"
                           @bind:event="oninput"
                           @onkeydown="OnNewListKey"
                           placeholder="New collection title…"
                           class="w-full bg-transparent border-b border-secondary/40 focus:border-primary px-1 py-2 outline-none text-on-surface placeholder:text-secondary-text/70 font-body-md text-[14px] transition-colors" />
                </div>

                <div class="flex items-center gap-2">
                    <button type="button"
                            @onclick="() => newListPrivate = !newListPrivate"
                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border text-[12px] font-title-md transition-colors select-none @(newListPrivate ? "border-secondary/45 text-on-surface bg-surface-variant/25" : "border-secondary/25 text-secondary-text hover:text-on-surface")"
                            title="Toggle visibility">
                        <span class="material-symbols-outlined text-[14px]">@(newListPrivate ? "lock" : "public")</span>
                        <span>@(newListPrivate ? "Private" : "Public")</span>
                    </button>

                    <button @onclick="CreateList"
                            class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-on-primary rounded-md font-title-md font-semibold text-[12px] hover:opacity-90 transition-opacity whitespace-nowrap">
                        <span class="material-symbols-outlined text-[15px]">add</span>
                        <span>Create</span>
                    </button>
                </div>
            </div>
        </div>

        @if (Me.Watchlists.Count == 0)
        {
            <div class="border border-dashed border-secondary/30 rounded-lg py-16 px-6 text-center max-w-lg mx-auto">
                <p class="font-serif text-[18px] text-on-surface mb-1">No collections yet</p>
                <p class="font-body-md text-[13px] text-secondary-text leading-relaxed">
                    Type a title above to start your first themed shelf.
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var list in Me.Watchlists)
                {
                    int totalCount = list.Entries.Count;
                    int watchedCount = list.Entries.Count(e => Me.IsWatched(e.Item));
                    int unwatchedCount = totalCount - watchedCount;
                    int percent = totalCount > 0 ? (int)Math.Round((double)watchedCount / totalCount * 100) : 0;

                    <article class="relative h-[220px] rounded-lg border border-secondary/25 bg-surface-variant/15 hover:border-primary/50 hover:bg-surface-variant/25 transition-all overflow-hidden group">

                        <a href="/watchlists/@Uri.EscapeDataString(list.Name)" class="absolute inset-0 z-10" aria-label="Open @list.Name"></a>

                        @if (list.Entries.Any())
                        {
                            var topEntries = list.Entries.Take(3).ToList();
                            <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
                                <div class="absolute right-4 top-5 flex -space-x-9 opacity-85 group-hover:opacity-100 group-hover:-translate-y-0.5 transition-all duration-300">
                                    @for (int i = 0; i < topEntries.Count; i++)
                                    {
                                        var entry = topEntries[i];
                                        string rotation = i == 0 ? "-rotate-6 mt-2" : i == 1 ? "rotate-0 mt-0" : "rotate-6 mt-3";
                                        string zIndex = i == 0 ? "z-30" : i == 1 ? "z-20" : "z-10";

                                        <div class="@zIndex @rotation w-[76px] h-[112px] rounded-sm bg-cover bg-center border border-secondary/40 shadow-lg"
                                             style="@UiHelpers.CardBackground(entry.Item.PosterUrl)">
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="absolute inset-0 bg-gradient-to-r from-background via-background/95 to-background/35 z-10 pointer-events-none"></div>
                        }

                        <div class="relative z-20 h-full p-6 flex flex-col justify-between pointer-events-none">
                            <div class="flex items-center justify-between gap-2">
                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-md @(list.IsPrivate ? "text-secondary-text" : "text-primary/90")"
                                      title="@(list.IsPrivate ? "Private collection" : "Public collection")">
                                    <span class="material-symbols-outlined text-[15px]">@(list.IsPrivate ? "lock" : "public")</span>
                                </span>

                                <button type="button"
                                        @onclick="() => DeleteWatchlist(list)"
                                        @onclick:stopPropagation="true"
                                        @onclick:preventDefault="true"
                                        class="pointer-events-auto p-1.5 rounded-md text-secondary-text hover:text-tertiary hover:bg-background/80 transition-colors opacity-0 group-hover:opacity-100 flex items-center justify-center"
                                        title="Delete collection">
                                    <span class="material-symbols-outlined text-[16px]">delete</span>
                                </button>
                            </div>

                            <div class="flex flex-col gap-3">
                                <div class="flex flex-col gap-1 @(list.Entries.Any() ? "pr-16" : "")">
                                    <h3 class="font-serif text-[22px] text-on-surface group-hover:text-primary transition-colors leading-snug truncate">
                                        @list.Name
                                    </h3>
                                    <span class="text-[12px] text-secondary-text font-body-md">
                                        @totalCount @(totalCount == 1 ? "title" : "titles") · @unwatchedCount unwatched
                                    </span>
                                </div>

                                <div class="flex flex-col gap-2 pt-1">
                                    <div class="w-full h-[2px] bg-secondary/20 overflow-hidden">
                                        <div class="h-full bg-primary transition-all duration-300" style="width: @percent%;"></div>
                                    </div>
                                    <div class="flex items-center justify-between text-[12px] font-body-md">
                                        <span class="text-secondary-text">@percent% watched</span>
                                        <span class="text-on-surface group-hover:text-primary font-title-md text-[12px] inline-flex items-center gap-1 transition-colors">
                                            <span>Open</span>
                                            <span class="material-symbols-outlined text-[14px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@code {
    private string newListName = "";
    private bool newListPrivate = true;

    private User Me => DataService.CurrentUser;

    private record SmartCollectionCard(
        string Slug,
        string Title,
        string Icon,
        string AccentClass,
        bool FillIcon,
        List<Media> Items);

    private List<SmartCollectionCard> SmartCollections => new()
    {
        new("favorites", "Favorites", "favorite", "text-tertiary", true,
            DataService.Library.Where(m => Me.IsFavorite(m)).ToList()),

        new("watching", "Watching", "play_circle", "text-primary", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Watching || s.Status == WatchStatus.Rewatching)
                .Select(s => s.Item)
                .ToList()),

        new("planned", "Planned", "bookmark", "text-primary", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Planned)
                .Select(s => s.Item)
                .ToList()),

        new("paused", "Paused", "pause_circle", "text-on-surface", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Paused)
                .Select(s => s.Item)
                .ToList()),

        new("dropped", "Dropped", "cancel", "text-tertiary", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Dropped)
                .Select(s => s.Item)
                .ToList()),

        new("watched", "Watched", "check_circle", "text-primary", false,
            Me.MediaStates
                .Where(s => s.Status == WatchStatus.Watched)
                .Select(s => s.Item)
                .ToList())
    };

    private async Task OnNewListKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateList();
    }

    private async Task CreateList()
    {
        string name = newListName.Trim();
        if (string.IsNullOrEmpty(name)) return;

        if (Me.Watchlists.Any(w => w.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add("A list with this name already exists", Severity.Warning);
            return;
        }

        Me.CreateWatchlist(name, newListPrivate);

        await DataService.SaveStateAsync();

        Snackbar.Add($"List \"{name}\" created", Severity.Success);
        newListName = "";
    }

    private async Task DeleteWatchlist(Watchlist list)
    {
        bool success = Me.RemoveWatchlist(list.Id);
        if (success)
        {
            await DataService.SaveStateAsync();

            Snackbar.Add($"Watchlist \"{list.Name}\" removed", Severity.Info);
            StateHasChanged();
        }
    }
}