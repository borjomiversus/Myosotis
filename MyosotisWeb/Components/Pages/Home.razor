@page "/"
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Myosotis · Overview</PageTitle>

<div class="max-w-[1200px] mx-auto px-margin py-margin">
    <div class="flex flex-col w-full">

        <!-- Шапка сторінки -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-lg mb-space-xl relative overflow-hidden p-6 rounded-2xl bg-surface-container-low border border-surface-variant/20 shadow-lg">
            <div class="absolute -top-24 -right-24 w-72 h-72 bg-primary/10 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
            <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="flex flex-col gap-space-xs relative z-10">
                <span class="font-label-caps text-label-caps text-on-surface-variant tracking-[0.14em]">@Today</span>
                <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight mt-1">
                    @Greeting(), <span class="italic font-normal text-primary-fixed">@Me.Username.</span>
                </h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant/80 italic font-serif">
                    What story will stay with you tonight?
                </p>
            </div>

            <div class="flex items-center gap-space-sm self-start md:self-auto relative">
                <button @onclick="ToggleCapture" class="flex items-center gap-space-xs px-4 py-2 rounded-lg bg-surface-container-high text-on-surface hover:bg-surface-variant transition-colors group">
                    <span class="material-symbols-outlined text-[16px] text-on-surface-variant group-hover:text-primary transition-colors">edit_note</span>
                    <span class="font-title-md text-title-md">Capture</span>
                </button>

                <button @onclick="OpenRouletteDialog" class="flex items-center gap-space-xs px-5 py-2 rounded-full bg-primary-container text-on-primary-container hover:bg-primary transition-all shadow-[0_0_16px_rgba(132,220,198,0.22)] active:scale-95">
                    <span class="material-symbols-outlined text-[18px]">casino</span>
                    <span class="font-title-md text-title-md font-semibold tracking-wide">Roulette</span>
                </button>
            </div>
        </div>

        <!-- Швидкий capture -->
        @if (isCaptureOpen)
        {
            <div class="bg-surface-container-high p-4 rounded-xl mb-6 flex gap-3 items-center">
                <input @bind="newCaptureText"
                       @bind:event="oninput"
                       @onkeydown="OnCaptureKey"
                       placeholder="Half-remembered scene, a title, anything…"
                       class="flex-1 bg-surface-container-low rounded-lg px-4 py-2 outline-none text-on-surface placeholder:text-on-surface-variant/60 border border-surface-variant/40 focus:border-primary-container" />
                <button @onclick="SaveCapture" class="px-4 py-2 bg-primary-container text-on-primary-container rounded-lg font-title-md">Save</button>
                <button @onclick="ToggleCapture" class="px-3 py-2 text-on-surface-variant">Cancel</button>
            </div>
        }

        <!-- Статистика -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-space-md mb-space-xl">
            <StatCard Label="LISTS" Value="@ListsCount" Caption="your collections" Icon="folder_special" IconClass="text-primary" />
            <StatCard Label="PLANNED" Value="@PlannedCount.ToString()" Caption="left to watch" Icon="bookmark" IconClass="text-secondary" />
            <StatCard Label="WATCHED" Value="@WatchedCount.ToString()" Caption="titles logged" Icon="task_alt" IconClass="text-primary-fixed" />
            <StatCard Label="CAPTURES" Value="@OpenCaptures.ToString()" Caption="waiting to be named" Icon="format_quote" IconClass="text-tertiary" />
        </div>

        <!-- Підбірки -->
        <div class="flex flex-col mb-space-xl">
            <div class="flex items-baseline justify-between mb-space-md">
                <h2 class="font-headline-md text-headline-md text-on-surface font-serif">Your watchlists</h2>
                <a class="font-title-md text-title-md text-primary-container hover:text-primary flex items-center gap-1 group transition-colors" href="/watchlists">
                    <span>View all lists</span>
                    <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                </a>
            </div>

            @if (Me.Watchlists.Count == 0)
            {
                <p class="font-body-md text-on-surface-variant">No lists yet. Create the first one on the Watchlists page.</p>
            }

            <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
                @for (int i = 0; i < Me.Watchlists.Count; i++)
                {
                    var list = Me.Watchlists[i];
                    int number = i + 1;

                    <div @onclick="OpenWatchlists"
                         class="cursor-pointer bg-cover bg-center rounded-xl h-36 relative overflow-hidden group shadow-md flex flex-col justify-between p-space-md"
                         style="@UiHelpers.CardBackground(FirstPoster(list))">
                        <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-low/70 to-transparent pointer-events-none"></div>

                        <div class="relative z-10 flex items-center justify-between">
                            <span class="px-2 py-0.5 rounded-full bg-surface-container-lowest/80 backdrop-blur-sm text-on-surface font-label-caps text-label-caps">LIST @number.ToString("D2")</span>
                            <span class="material-symbols-outlined text-[16px] text-on-surface-variant">@(list.IsPrivate ? "lock" : "public")</span>
                        </div>

                        <div class="relative z-10 flex items-end justify-between">
                            <div class="flex flex-col">
                                <h3 class="font-headline-md text-headline-md text-on-surface font-serif leading-snug">@list.Name</h3>
                                <span class="font-label-sm text-label-sm text-on-surface-variant">@list.Entries.Count titles · @UiHelpers.FormatMinutes(list.GetTotalTimeDebt())</span>
                            </div>
                            <span class="w-8 h-8 rounded-full bg-surface-container-high/80 text-on-surface group-hover:bg-primary-container group-hover:text-on-primary-container transition-all flex items-center justify-center">
                                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Нижній блок -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-stretch">

            <!-- Continue watching -->
            @if (DataService.ActiveCheckpoint is { } cp)
            {
                <div class="lg:col-span-7 flex flex-col">
                    <div class="flex items-center justify-between mb-space-md">
                        <h2 class="font-headline-md text-headline-md text-on-surface font-serif">Continue watching</h2>
                        <span class="font-label-caps text-label-caps text-on-surface-variant/70">RESUME SESSION</span>
                    </div>

                    <div class="bg-cover bg-center rounded-2xl relative overflow-hidden flex-1 min-h-[260px] p-space-lg flex flex-col justify-between shadow-lg"
                         style="@UiHelpers.CardBackground(cp.PausedSeries.PosterUrl)">
                        <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/85 to-surface-container-lowest/40"></div>

                        <div class="relative z-10 flex items-center gap-space-sm flex-wrap">
                            <span class="px-3 py-1 rounded-full bg-primary-container text-on-primary-container font-label-caps text-label-caps">SEASON @cp.Season • EPISODE @cp.Episode</span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant">@string.Join(" • ", cp.PausedSeries.Genres)</span>
                        </div>

                        <div class="relative z-10 flex flex-col gap-space-md mt-6">
                            <div>
                                <h3 class="font-headline-lg text-headline-lg text-on-surface font-serif font-bold tracking-tight">@cp.PausedSeries.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(cp.Reason))
                                {
                                    <p class="font-body-md text-body-md text-on-surface-variant/90 max-w-lg mt-1">@cp.Reason</p>
                                }
                            </div>

                            <div class="flex items-center gap-space-md pt-space-xs">
                                <button @onclick="ResumeWatching"
                                        disabled="@(!cp.IsActive)"
                                        class="w-10 h-10 rounded-full bg-primary-container text-on-primary-container hover:bg-primary transition-all flex items-center justify-center shadow-[0_0_12px_rgba(132,220,198,0.3)] shrink-0 disabled:opacity-40">
                                    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                                </button>

                                <div class="flex-1 flex flex-col gap-1.5">
                                    <div class="w-full h-1.5 bg-surface-variant rounded-full overflow-hidden">
                                        <div class="h-full bg-primary-container rounded-full transition-all duration-500" style="width: @(cp.GetProgressPercent())%;"></div>
                                    </div>
                                    <div class="flex items-center justify-between font-label-sm text-label-sm text-on-surface-variant">
                                        <span>@cp.Timecode watched</span>
                                        <span>@(cp.IsActive ? "paused" : "resumed")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- This month -->
            <div class="lg:col-span-5 flex flex-col">
                @{
                    var now = DateTime.Now;
                    int monthMinutes = Me.GetMonthlyStats(now.Year, now.Month);
                    int monthTitles = Me.GetMonthlyWatchCount(now.Year, now.Month);
                    var genres = Me.GetMonthlyGenreStats(now.Year, now.Month);
                    int maxGenre = genres.Count > 0 ? genres.Values.Max() : 1;
                    string? topDirector = Me.GetMonthlyTopDirector(now.Year, now.Month);
                    int barIndex = 0;
                }

                <div class="flex items-center justify-between mb-space-md">
                    <h2 class="font-headline-md text-headline-md text-on-surface font-serif">This month</h2>
                    <a class="font-title-md text-title-md text-primary-container hover:text-primary transition-colors flex items-center gap-1 group" href="/history">
                        <span>Full history</span>
                        <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                    </a>
                </div>

                <div class="bg-surface-container-high rounded-2xl p-space-lg flex-1 flex flex-col justify-between shadow-md">
                    <div class="flex items-baseline justify-between pb-space-md">
                        <div class="flex flex-col">
                            <span class="font-label-caps text-label-caps text-on-surface-variant">@now.ToString("MMMM", En).ToUpper() LOG</span>
                            <div class="font-stat-metric text-stat-metric text-on-surface mt-1">
                                @monthTitles <span class="font-headline-md text-headline-md font-normal text-on-surface-variant">@(monthTitles == 1 ? "title" : "titles")</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 bg-surface-container-low px-3 py-1.5 rounded-lg">
                            <span class="material-symbols-outlined text-[16px] text-primary">schedule</span>
                            <span class="font-title-md text-title-md text-primary">@UiHelpers.FormatMinutes(monthMinutes)</span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant">viewing</span>
                        </div>
                    </div>

                    @if (genres.Count == 0)
                    {
                        <p class="font-body-md text-on-surface-variant my-auto">Nothing logged this month yet.</p>
                    }
                    else
                    {
                        <div class="flex flex-col gap-space-md my-auto">
                            @foreach (var g in genres.OrderByDescending(x => x.Value))
                            {
                                int width = g.Value * 100 / maxGenre;
                                string bar = BarColors[barIndex % BarColors.Length];
                                barIndex++;

                                <div class="flex flex-col gap-1">
                                    <div class="flex justify-between font-label-sm text-label-sm">
                                        <span class="text-on-surface font-medium">@g.Key</span>
                                        <span class="text-on-surface-variant">@g.Value @(g.Value == 1 ? "title" : "titles")</span>
                                    </div>
                                    <div class="w-full h-1.5 bg-surface-variant rounded-full overflow-hidden">
                                        <div class="h-full @bar rounded-full" style="width: @(width)%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="pt-space-md mt-space-md border-t border-surface-variant/40 font-label-sm text-label-sm text-on-surface-variant">
                        Top director: @(topDirector ?? "—")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo En = new CultureInfo("en-US");
    private static readonly string[] BarColors = { "bg-primary-container", "bg-secondary", "bg-tertiary", "bg-surface-variant" };

    private bool isCaptureOpen;
    private string newCaptureText = "";

    private User Me => DataService.CurrentUser;

    private string Today => DateTime.Now.ToString("dddd, MMMM dd", En).ToUpper();
    private string ListsCount => Me.Watchlists.Count.ToString("D2");
    private int PlannedCount => Me.GetPlannedMedia().Count;
    private int WatchedCount => Me.MediaStates.Count(s => s.Status == WatchStatus.Watched);
    private int OpenCaptures => Me.GetUnresolvedCaptures().Count;

    private string Greeting()
    {
        int hour = DateTime.Now.Hour;
        if (hour < 12) return "Good morning";
        if (hour < 18) return "Good afternoon";
        return "Good evening";
    }

    // Перший постер зі списку (якщо є), щоб картка підбірки мала обкладинку.
    private static string? FirstPoster(Watchlist list)
    {
        foreach (var entry in list.Entries)
        {
            if (!string.IsNullOrWhiteSpace(entry.Item.PosterUrl))
                return entry.Item.PosterUrl;
        }
        return null;
    }

    private void ToggleCapture()
    {
        isCaptureOpen = !isCaptureOpen;
    }

    private void OnCaptureKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveCapture();
    }

    private void SaveCapture()
    {
        if (string.IsNullOrWhiteSpace(newCaptureText)) return;

        Me.AddCapture(newCaptureText.Trim(), "Quick add");
        Snackbar.Add("Capture saved", Severity.Success);
        newCaptureText = "";
        isCaptureOpen = false;
    }

    private void OpenWatchlists()
    {
        Navigation.NavigateTo("/watchlists");
    }

    private void ResumeWatching()
    {
        var cp = DataService.ActiveCheckpoint;
        if (cp == null || !cp.IsActive) return;

        Me.RecordView(cp.PausedSeries);
        Snackbar.Add(cp.ResumeWatching(), Severity.Info);
    }

    private async Task OpenRouletteDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<RouletteDialog>("Cinematic Roulette", options);
    }
}
