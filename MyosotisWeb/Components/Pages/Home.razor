@page "/"
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Overview</PageTitle>

<div class="max-w-[1200px] mx-auto px-margin py-margin flex flex-col gap-10">

    <!-- БАНЕР -->
    @if (FeaturedMedia != null)
    {
        <div class="relative w-full h-[300px] rounded-lg overflow-hidden border border-secondary/30 shadow-xl flex items-center group bg-gradient-to-br from-secondary/20 via-background to-secondary/10">

            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
                 style="@UiHelpers.CardBackground(FeaturedMedia.PosterUrl)">
            </div>

            <div class="absolute inset-0 bg-background/40 mix-blend-overlay"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-background via-background/90 to-transparent"></div>

            <div class="relative z-10 w-full p-10 flex flex-col max-w-2xl">

                <span class="px-2 py-1 rounded bg-primary/15 text-primary font-label-caps tracking-widest text-[10px] w-fit border border-primary/30 mb-4 backdrop-blur-sm">
                    RECOMMENDATION
                </span>

                <!-- Заголовок банера з посиланням -->
                <a href="/media/@FeaturedMedia.Id" class="hover:text-primary transition-colors">
                    <h1 class="font-headline-xl text-headline-xl text-[#E2E8F0] drop-shadow-lg mb-3">
                        @FeaturedMedia.Title
                    </h1>
                </a>

                <!-- Метадані -->
                <div class="flex items-center gap-2 font-body-md text-[13px] text-secondary mb-4 drop-shadow-md">
                    <span>@FeaturedMedia.ReleaseYear</span>

                    @if (FeaturedMedia.Genres != null && FeaturedMedia.Genres.Count > 0)
                    {
                        <span>·</span>
                        <span>@string.Join(" · ", FeaturedMedia.Genres)</span>
                    }

                    <span>·</span>

                    @if (FeaturedMedia is Movie movie)
                    {
                        <span>@UiHelpers.FormatMinutes(movie.DurationMinutes)</span>
                    }
                    else if (FeaturedMedia is Series series)
                    {
                        int totalSeasons = series.Seasons.Count;
                        int totalEpisodes = 0;
                        foreach (var s in series.Seasons)
                        {
                            totalEpisodes += s.Episodes.Count;
                        }

                        <span>@totalSeasons сезонів · @totalEpisodes епізодів</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(FeaturedMedia.Description))
                {
                    <p class="font-body-lg text-body-lg text-[#E2E8F0]/80 italic font-serif max-w-xl line-clamp-3 mb-8 drop-shadow-md">
                        @FeaturedMedia.Description
                    </p>
                }

                <!-- Кнопки -->
                <div class="flex items-center gap-4">
                    <button class="px-5 py-2.5 rounded-lg bg-primary text-background font-title-md font-bold text-[14px] hover:opacity-90 transition-opacity flex items-center gap-2 shadow-md">
                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">add</span>
                        Add to list
                    </button>

                    <!-- Посилання на деталі медіа -->
                    <a href="/media/@FeaturedMedia.Id" class="px-5 py-2.5 rounded-lg border border-secondary text-secondary font-title-md text-[14px] hover:bg-secondary/10 transition-colors flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">info</span>
                        Details
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- ВОТЧЛІСТИ -->
    <div class="flex flex-col">

        <div class="flex items-center gap-4 mb-6">
            <h2 class="font-serif text-[24px] text-white">Your watchlists</h2>

            <div class="flex-1 h-px bg-secondary/30"></div>

            <a href="/watchlists"
               class="text-[13px] text-secondary hover:text-primary transition-colors flex items-center gap-1 group font-body-md">
                <span>View all</span>
                <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">
                    arrow_forward
                </span>
            </a>
        </div>

        <div class="flex gap-6 overflow-x-auto pb-4 snap-x" style="scrollbar-width: none;">

            @foreach (var list in Me.Watchlists)
            {
                <div @onclick="() => OpenList(list.Name)"
                     class="snap-start shrink-0 w-[340px] h-[200px] rounded-lg border border-secondary/20 shadow-lg cursor-pointer group relative overflow-hidden flex flex-col justify-end p-6 bg-gradient-to-br from-secondary/15 via-background to-secondary/5">

                    <div class="absolute inset-0 z-0 overflow-hidden">
                        <div class="absolute -right-4 -top-2 flex -space-x-12 opacity-80 group-hover:opacity-100 group-hover:-translate-y-2 group-hover:scale-105 transition-all duration-500 pt-6 pr-6">
                            @if (list.Entries.Count > 0)
                            {
                                int maxCount = list.Entries.Count < 3 ? list.Entries.Count : 3;
                                for (int i = 0; i < maxCount; i++)
                                {
                                    var entry = list.Entries[i];
                                    string rotation = i == 0 ? "-rotate-12 mt-4" : i == 1 ? "-rotate-3 mt-1" : "rotate-12 mt-5";
                                    string zIndex = i == 0 ? "z-30" : i == 1 ? "z-20" : "z-10";

                                    <div class="@zIndex @rotation w-[85px] h-[125px] rounded bg-cover bg-center border border-secondary/30 shadow-2xl transition-transform duration-300"
                                         style="@UiHelpers.CardBackground(entry.Item.PosterUrl)">
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="absolute inset-0 bg-gradient-to-r from-background via-background/90 to-transparent z-10"></div>

                    <div class="relative z-20 flex items-end justify-between">

                        <div class="flex flex-col">

                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="font-serif text-[20px] text-white group-hover:text-primary transition-colors">
                                    @list.Name
                                </h3>

                                @if (list.IsPrivate)
                                {
                                    <span class="material-symbols-outlined text-[14px] text-secondary">
                                        lock
                                    </span>
                                }
                            </div>

                            <span class="text-[13px] text-secondary font-body-md">
                                @list.Entries.Count titles
                            </span>

                        </div>

                        <div class="w-10 h-10 rounded-lg border border-secondary/40 flex items-center justify-center text-secondary backdrop-blur-sm group-hover:bg-primary group-hover:text-background group-hover:border-primary transition-colors shadow-lg">
                            <span class="material-symbols-outlined text-[20px]">
                                arrow_forward
                            </span>
                        </div>

                    </div>
                </div>
            }

            <div class="snap-start shrink-0 w-[200px] h-[200px] rounded-lg bg-background border border-dashed border-secondary/40 shadow-lg cursor-pointer hover:bg-secondary/10 transition-colors flex flex-col items-center justify-center gap-4 group">
                <div class="w-12 h-12 rounded-full border border-secondary/40 flex items-center justify-center text-secondary group-hover:text-primary group-hover:border-primary transition-colors">
                    <span class="material-symbols-outlined text-[24px]">
                        add
                    </span>
                </div>
                <span class="text-[14px] text-secondary group-hover:text-white transition-colors text-center font-body-md">
                    Create new<br />watchlist
                </span>
            </div>

        </div>
    </div>

    <!-- НИЖНІ БЛОКИ -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

        <!-- Вечір (Рекомендації з посиланнями на деталі) -->
        <div class="bg-gradient-to-b from-secondary/15 via-secondary/5 to-background rounded-lg border border-secondary/20 p-6 flex flex-col shadow-lg">
            <div class="flex items-center justify-between mb-6">
                <h3 class="font-serif text-[18px] text-white">
                    For your next evening
                </h3>
                <a href="/search" class="text-[12px] text-secondary hover:text-primary transition-colors flex items-center font-body-md">
                    See all
                    <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                </a>
            </div>

            <div class="grid grid-cols-2 gap-4">
                @foreach (var media in SuggestedMedia)
                {
                    <a href="/media/@media.Id" class="flex flex-col gap-2 group cursor-pointer block">
                        <div class="aspect-[2/3] rounded bg-cover bg-center shadow-md border border-secondary/20 group-hover:border-primary transition-all group-hover:scale-[1.02]"
                             style="@UiHelpers.CardBackground(media.PosterUrl)"
                             title="@media.Title">
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[13px] text-white font-title-md font-medium truncate group-hover:text-primary transition-colors">
                                @media.Title
                            </span>
                            <span class="text-[11px] text-secondary font-body-md">
                                @media.ReleaseYear
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>

        <!-- Нотатки -->
        <div class="bg-gradient-to-b from-secondary/15 via-secondary/5 to-background rounded-lg border border-secondary/20 p-6 flex flex-col shadow-lg">
            <div class="flex items-center justify-between mb-6">
                <h3 class="font-serif text-[18px] text-white">
                    Recent captures
                </h3>
                <a href="/captures" class="text-[12px] text-secondary hover:text-primary transition-colors flex items-center font-body-md">
                    View all
                    <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                </a>
            </div>
            <div class="flex flex-col gap-4">
                @if (RecentCaptures.Count > 0)
                {
                    @foreach (var capture in RecentCaptures)
                    {
                        <div class="flex flex-col gap-1 pb-3 border-b border-secondary/20 last:border-b-0">
                            <p class="text-[13px] text-white font-title-md font-medium">
                                "@capture.RawNote"
                            </p>
                            <div class="flex items-center gap-1.5 text-[11px] text-secondary font-body-md">
                                @if (!string.IsNullOrWhiteSpace(capture.Source))
                                {
                                    <span class="text-primary">@capture.Source</span>
                                    <span>·</span>
                                }
                                <span>@capture.CapturedAt.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-[13px] text-secondary font-body-md">
                        No captures logged yet.
                    </p>
                }
            </div>
        </div>

        <!-- Швидкі дії -->
        <div class="bg-gradient-to-b from-secondary/15 via-secondary/5 to-background rounded-lg border border-secondary/20 p-6 flex flex-col shadow-lg">
            <div class="flex items-center mb-6">
                <h3 class="font-serif text-[18px] text-white">
                    Quick actions
                </h3>
            </div>
            <div class="flex flex-col gap-3">

                <button @onclick="GoToCaptures"
                        class="flex items-center justify-between p-4 rounded-lg border border-secondary/20 hover:border-primary hover:bg-secondary/20 transition-all group text-left">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary text-[24px]">
                            edit_note
                        </span>
                        <div class="flex flex-col">
                            <span class="text-[14px] text-white font-title-md">Capture</span>
                            <span class="text-[12px] text-secondary font-body-md">Save a thought</span>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-secondary text-[18px] group-hover:text-primary group-hover:translate-x-1 transition-all">
                        chevron_right
                    </span>
                </button>

                <button @onclick="OpenRouletteDialog"
                        class="flex items-center justify-between p-4 rounded-lg border border-secondary/20 hover:border-tertiary hover:bg-secondary/20 transition-all group text-left">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-tertiary text-[24px]">
                            casino
                        </span>
                        <div class="flex flex-col">
                            <span class="text-[14px] text-white font-title-md">Roulette</span>
                            <span class="text-[12px] text-secondary font-body-md">Random pick</span>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-secondary text-[18px] group-hover:text-tertiary group-hover:translate-x-1 transition-all">
                        chevron_right
                    </span>
                </button>

            </div>
        </div>

    </div>

    <!-- ІСТОРІЯ -->
    @{
        var now = DateTime.Now;
        int monthMinutes = Me.GetMonthlyStats(now.Year, now.Month);
        int monthTitles = Me.GetMonthlyWatchCount(now.Year, now.Month);
    }

    <div class="bg-gradient-to-r from-secondary/15 via-background to-secondary/10 rounded-lg border border-secondary/20 px-8 py-5 flex items-center justify-between shadow-lg">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-secondary text-[24px]">
                bar_chart
            </span>
            <span class="text-[15px] font-title-md text-white">
                This month
            </span>
        </div>

        <div class="flex items-center gap-12">
            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-secondary text-[20px]">
                    visibility
                </span>
                <div class="flex flex-col">
                    <span class="text-[15px] text-white font-title-md font-bold leading-none">
                        @monthTitles
                    </span>
                    <span class="text-[11px] text-secondary font-body-md">
                        watched
                    </span>
                </div>
            </div>

            <div class="w-px h-8 bg-secondary/30"></div>

            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-secondary text-[20px]">
                    schedule
                </span>
                <div class="flex flex-col">
                    <span class="text-[15px] text-white font-title-md font-bold leading-none">
                        @UiHelpers.FormatMinutes(monthMinutes)
                    </span>
                    <span class="text-[11px] text-secondary font-body-md">
                        total time
                    </span>
                </div>
            </div>
        </div>

        <a href="/history"
           class="text-[13px] text-primary hover:text-white transition-colors flex items-center gap-1 font-body-md font-bold">
            <span>View history</span>
            <span class="material-symbols-outlined text-[16px]">
                arrow_forward
            </span>
        </a>
    </div>

</div>

@code {
    private User Me => DataService.CurrentUser;

    // Без LINQ (індексація за списком)
    private Media? FeaturedMedia => DataService.Library.Count > 0 ? DataService.Library[0] : null;

    // Без LINQ (звичайний цикл for)
    private List<Media> SuggestedMedia
    {
        get
        {
            var result = new List<Media>();
            for (int i = 1; i < DataService.Library.Count && result.Count < 2; i++)
            {
                result.Add(DataService.Library[i]);
            }
            return result;
        }
    }

    // Без LINQ для нотаток
    private List<CaptureEntry> RecentCaptures
    {
        get
        {
            var result = new List<CaptureEntry>();
            if (Me.Captures != null)
            {
                for (int i = 0; i < Me.Captures.Count && result.Count < 3; i++)
                {
                    result.Add(Me.Captures[i]);
                }
            }
            return result;
        }
    }

    private void OpenList(string listName) =>
        Navigation.NavigateTo($"/watchlists/{Uri.EscapeDataString(listName)}");

    private void GoToCaptures() =>
        Navigation.NavigateTo("/captures");

    private async Task OpenRouletteDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        await DialogService.ShowAsync<RouletteDialog>(
            "Random Pick",
            options);
    }
}