@page "/"
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Overview</PageTitle>

<div class="max-w-[1200px] mx-auto px-margin pb-margin">
    <div class="flex flex-col w-full gap-12">

        <!-- Шапка -->
        <div class="flex flex-col gap-4 pt-4 pb-6 border-b border-surface-variant/30 relative">
            <div class="flex items-center justify-between">
                <div class="flex flex-col gap-1.5">
                    <span class="font-label-caps text-on-surface-variant tracking-[0.15em] uppercase text-[11px]">@Today</span>
                    <h1 class="font-serif text-[32px] md:text-[40px] text-on-surface tracking-tight leading-none">
                        @Greeting(), <span class="italic font-normal text-primary">@Me.Username.</span>
                    </h1>
                </div>
                
                <button @onclick="OpenRouletteDialog" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-surface-container-low border border-surface-variant/40 text-on-surface hover:text-primary hover:border-primary transition-colors">
                    <span class="material-symbols-outlined text-[20px]">casino</span>
                    <span class="font-title-md font-medium tracking-wide">Roulette</span>
                </button>
            </div>
        </div>

        <!-- Trending Now -->
        <div class="flex flex-col">
            <div class="flex items-baseline justify-between mb-5">
                <h2 class="font-serif text-[24px] text-on-surface">Trending Now</h2>
                <span class="font-label-sm text-on-surface-variant uppercase tracking-wider">Powered by TMDB</span>
            </div>

            <div class="flex gap-5 overflow-x-auto pb-4 snap-x" style="scrollbar-width: none;">
                @foreach (var media in TrendingMedia)
                {
                    <div class="snap-start shrink-0 w-[150px] flex flex-col gap-3 cursor-pointer group">
                        <div class="w-full aspect-[2/3] rounded-lg bg-cover bg-center shadow-md border border-surface-variant/20 transition-all group-hover:border-primary/50 relative overflow-hidden"
                             style="@UiHelpers.CardBackground(media.PosterUrl)">
                            <div class="absolute inset-0 bg-surface/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]">
                                <span class="material-symbols-outlined text-primary text-[32px]">add</span>
                            </div>
                        </div>
                        <div>
                            <h4 class="font-title-md text-[15px] text-on-surface truncate group-hover:text-primary transition-colors">@media.Title</h4>
                            <div class="text-[12px] text-on-surface-variant mt-0.5 truncate">@media.ReleaseYear · @media.Genres.FirstOrDefault()</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- тематичний ряд  -->
        @if (ActionPicks.Any())
        {
            <div class="flex flex-col">
                <div class="flex items-baseline justify-between mb-5">
                    <h2 class="font-serif text-[24px] text-on-surface">Action & Sci-Fi Picks</h2>
                </div>

                <div class="flex gap-5 overflow-x-auto pb-4 snap-x" style="scrollbar-width: none;">
                    @foreach (var media in ActionPicks)
                    {
                        <div class="snap-start shrink-0 w-[150px] flex flex-col gap-3 cursor-pointer group">
                            <div class="w-full aspect-[2/3] rounded-lg bg-cover bg-center shadow-md border border-surface-variant/20 transition-all group-hover:border-primary/50 relative overflow-hidden"
                                 style="@UiHelpers.CardBackground(media.PosterUrl)">
                                <div class="absolute inset-0 bg-surface/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]">
                                    <span class="material-symbols-outlined text-primary text-[32px]">add</span>
                                </div>
                            </div>
                            <div>
                                <h4 class="font-title-md text-[15px] text-on-surface truncate group-hover:text-primary transition-colors">@media.Title</h4>
                                <div class="text-[12px] text-on-surface-variant mt-0.5 truncate">@media.ReleaseYear · @media.Genres.FirstOrDefault()</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Підбірки -->
        <div class="flex flex-col">
            <div class="flex items-baseline justify-between mb-5">
                <h2 class="font-serif text-[24px] text-on-surface">Your watchlists</h2>
                <a class="text-[14px] text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1 group" href="/watchlists">
                    <span>View all</span>
                    <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                </a>
            </div>

            @if (Me.Watchlists.Count == 0)
            {
                <p class="font-body-md text-on-surface-variant">No lists yet. Create the first one on the Watchlists page.</p>
            }

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                @foreach (var list in Me.Watchlists)
                {
                    <div @onclick="() => OpenList(list.Name)" class="cursor-pointer group flex flex-col gap-4">
                        <div class="flex gap-2 h-32">
                            @if (list.Entries.Any())
                            {
                                @foreach (var entry in list.Entries.Take(3))
                                {
                                    <div class="flex-1 rounded bg-cover bg-center shadow-sm border border-surface-variant/30 group-hover:-translate-y-1 transition-transform duration-300" 
                                         style="@UiHelpers.CardBackground(entry.Item.PosterUrl)"></div>
                                }
                                @for (int j = list.Entries.Count; j < 3; j++)
                                {
                                    <div class="flex-1 rounded bg-surface-container-low border border-surface-variant/20 opacity-50"></div>
                                }
                            }
                            else
                            {
                                <div class="w-full h-full rounded bg-surface-container-low border border-surface-variant/20 flex items-center justify-center text-on-surface-variant/40 text-[12px]">EMPTY</div>
                            }
                        </div>
                        
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="font-serif text-[18px] text-on-surface group-hover:text-primary transition-colors">@list.Name</h3>
                                @if (list.IsPrivate)
                                {
                                    <span class="material-symbols-outlined text-[14px] text-on-surface-variant">lock</span>
                                }
                            </div>
                            <span class="text-[13px] text-on-surface-variant">@list.Entries.Count titles · @UiHelpers.FormatMinutes(list.GetTotalTimeDebt())</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Нижній блок -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch border-t border-surface-variant/30 pt-10">

            <!-- Continue watching -->
           @if (DataService.ActiveCheckpoint is { IsActive: true } cp)
{
    <div class="lg:col-span-7 flex flex-col">
        <h2 class="font-serif text-[24px] text-on-surface mb-5">Continue watching</h2>

        <div class="rounded-xl overflow-hidden relative border border-surface-variant/20 shadow-lg min-h-[320px] flex flex-col justify-end p-7 group cursor-pointer">
            <img src="@cp.PausedSeries.PosterUrl" alt="@cp.PausedSeries.Title" class="absolute inset-0 w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b1325] via-[#0b1325]/80 to-transparent"></div>

            <div class="relative z-10 flex flex-col gap-4 text-white">
                <div class="flex items-center gap-3">
                    <span class="px-3 py-1.5 rounded bg-primary/20 text-primary font-label-caps tracking-widest text-[10px] backdrop-blur-sm border border-primary/20">
                        SEASON @cp.Season · EPISODE @cp.Episode
                    </span>
                </div>

                <div>
                    <h3 class="font-serif text-[32px] md:text-[38px] text-white font-bold leading-tight mb-2 group-hover:text-primary transition-colors">@cp.PausedSeries.Title</h3>
                    @if (!string.IsNullOrWhiteSpace(cp.Reason))
                    {
                        <p class="text-[14px] text-gray-300 mb-4 max-w-[85%]">@cp.Reason</p>
                    }
                </div>

                <div class="flex items-center gap-5 mt-2">
                    <button @onclick="ResumeWatching" class="w-12 h-12 rounded-full bg-primary text-[#0b1325] hover:bg-primary-fixed-dim transition-colors flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                    </button>
                    <div class="flex-1 flex flex-col gap-2">
                        <div class="w-full h-1.5 bg-white/20 rounded-full overflow-hidden">
                            <div class="h-full bg-primary rounded-full transition-all duration-500" style="width: @(cp.GetProgressPercent())%;"></div>
                        </div>
                        <div class="flex justify-between text-[13px] text-gray-400">
                            <span class="text-white font-medium">@cp.Timecode watched</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

            <!-- This month -->
            <div class="@(DataService.ActiveCheckpoint?.IsActive == true ? "lg:col-span-5" : "lg:col-span-12") flex flex-col transition-all duration-500">
                @{
                    var now = DateTime.Now;
                    int monthMinutes = Me.GetMonthlyStats(now.Year, now.Month);
                    int monthTitles = Me.GetMonthlyWatchCount(now.Year, now.Month);
                    var genres = Me.GetMonthlyGenreStats(now.Year, now.Month);
                    string? topDirector = Me.GetMonthlyTopDirector(now.Year, now.Month);
                }

                <div class="flex items-center justify-between mb-5">
                    <h2 class="font-serif text-[24px] text-on-surface">This month</h2>
                    <a class="text-[14px] text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1 group" href="/history">
                        <span>Full history</span>
                        <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                    </a>
                </div>

                <div class="bg-surface-container-lowest rounded-xl border border-surface-variant/30 p-7 flex-1 flex flex-col">
                    <div class="flex justify-between items-start mb-8">
                        <div class="flex flex-col gap-1">
                            <span class="font-label-caps text-on-surface-variant tracking-widest text-[11px]">@now.ToString("MMMM", En).ToUpper()</span>
                            <div class="font-serif text-[38px] text-on-surface leading-none mt-1">
                                @monthTitles <span class="text-[20px] font-sans text-on-surface-variant font-normal">titles</span>
                            </div>
                        </div>
                        <div class="text-right flex flex-col items-end">
                            <span class="material-symbols-outlined text-[20px] text-on-surface-variant mb-1">schedule</span>
                            <span class="text-[15px] font-medium text-on-surface">@UiHelpers.FormatMinutes(monthMinutes)</span>
                        </div>
                    </div>

                    @if (genres.Count > 0)
                    {
                        <div class="w-full h-2 rounded flex overflow-hidden gap-[2px] mb-5 bg-surface-variant/30">
                            @{ int barIndex = 0; }
                            @foreach (var g in genres.OrderByDescending(x => x.Value))
                            {
                                int width = (g.Value * 100) / monthTitles;
                                string bar = BarColors[barIndex % BarColors.Length];
                                <div class="h-full @bar" style="width: @(width)%;" title="@g.Key (@g.Value)"></div>
                                barIndex++;
                            }
                        </div>
                        
                        <div class="grid grid-cols-2 gap-y-3 gap-x-6 mb-auto">
                            @{ barIndex = 0; }
                            @foreach (var g in genres.OrderByDescending(x => x.Value))
                            {
                                string bar = BarColors[barIndex % BarColors.Length];
                                <div class="flex items-center gap-2 text-[13px]">
                                    <span class="w-2.5 h-2.5 rounded-full @bar shrink-0"></span>
                                    <span class="text-on-surface-variant truncate">@g.Key</span>
                                    <span class="text-on-surface ml-auto font-medium">@g.Value</span>
                                </div>
                                barIndex++;
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-[14px] text-on-surface-variant my-auto">Nothing logged this month yet.</p>
                    }

                    <div class="pt-5 mt-6 border-t border-surface-variant/30 flex justify-between text-[13px] text-on-surface-variant">
                        <span>Top Director: <strong class="text-on-surface font-medium">@(topDirector ?? "—")</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo En = new CultureInfo("en-US");
    private static readonly string[] BarColors = { "bg-primary", "bg-secondary", "bg-tertiary", "bg-primary-container", "bg-surface-variant" };

    private User Me => DataService.CurrentUser;
    private string Today => DateTime.Now.ToString("dddd, MMMM dd", En).ToUpper();
    
    private IEnumerable<Media> TrendingMedia => DataService.Library.Take(6);
    
    private IEnumerable<Media> ActionPicks => DataService.Library
        .Where(m => m.Genres.Contains("Action") || m.Genres.Contains("Sci-Fi"))
        .Take(6);

    private string Greeting()
    {
        int hour = DateTime.Now.Hour;
        if (hour < 12) return "Good morning";
        if (hour < 18) return "Good afternoon";
        return "Good evening";
    }

    private void OpenList(string listName)
    {
        Navigation.NavigateTo($"/watchlists/{Uri.EscapeDataString(listName)}");
    }

    private void ResumeWatching()
    {
        var cp = DataService.ActiveCheckpoint;
        if (cp == null || !cp.IsActive) return;

        Me.RecordView(cp.PausedSeries);
        Snackbar.Add(cp.ResumeWatching(), Severity.Info);
    }

    private async Task OpenRouletteDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<RouletteDialog>("Random Pick", options);
    }
}