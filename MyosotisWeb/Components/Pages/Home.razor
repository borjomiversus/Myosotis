@page "/"
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Overview</PageTitle>

<div class="max-w-[1200px] mx-auto px-margin py-margin flex flex-col gap-10">

    <!-- банер -->
    @if (FeaturedMedia != null)
    {
        <div class="relative w-full h-[300px] rounded-2xl overflow-hidden border border-surface-variant/20 shadow-lg flex items-center group bg-surface-container-lowest">

            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
                 style="@UiHelpers.CardBackground(FeaturedMedia.PosterUrl)">
            </div>

            <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/85 to-transparent"></div>

            <div class="relative z-10 w-full p-10 flex flex-col max-w-2xl">

                <span class="px-2 py-1 rounded bg-primary/10 text-primary font-label-caps tracking-widest text-[10px] w-fit border border-primary/20 mb-3">
                    Reccommendation
                </span>

                <h1 class="font-serif text-[40px] md:text-[48px] text-white font-bold leading-tight mb-3 drop-shadow-lg">
                    @FeaturedMedia.Title
                </h1>

                <div class="flex items-center gap-2 text-[12px] text-on-surface-variant font-body-md mb-3">
                    <span>@FeaturedMedia.ReleaseYear</span>

                    @if (FeaturedMedia.Genres.Any())
                    {
                        <span>·</span>
                        <span>@string.Join(" · ", FeaturedMedia.Genres)</span>
                    }

                    <span>·</span>
                    <span>@UiHelpers.FormatMinutes(FeaturedMedia.CalculateTimeDebt())</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(FeaturedMedia.Description))
                {
                    <p class="font-body-md text-[13px] leading-6 text-on-surface-variant max-w-xl line-clamp-3 mb-6">
                        @FeaturedMedia.Description
                    </p>
                }

                <div class="flex items-center gap-4">
                    <button class="px-5 py-2.5 rounded-lg bg-primary text-on-primary font-title-md text-[14px] hover:bg-primary-fixed-dim transition-colors flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">add</span>
                        Add to list
                    </button>

                    <button class="px-5 py-2.5 rounded-lg border border-surface-variant/40 text-white font-title-md text-[14px] hover:bg-surface-variant/20 transition-colors flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">info</span>
                        Details
                    </button>
                </div>

            </div>
        </div>
    }

    <!-- вотчліст -->
    <div class="flex flex-col">

        <div class="flex items-center gap-4 mb-6">
            <h2 class="font-serif text-[24px] text-white">Your watchlists</h2>

            <div class="flex-1 h-px bg-surface-variant/20"></div>

            <a href="/watchlists"
               class="text-[13px] text-on-surface-variant hover:text-white transition-colors flex items-center gap-1 group font-body-md">
                <span>View all</span>
                <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">
                    arrow_forward
                </span>
            </a>
        </div>

        <div class="flex gap-6 overflow-x-auto pb-4 snap-x" style="scrollbar-width: none;">

            @foreach (var list in Me.Watchlists)
            {
                <div @onclick="() => OpenList(list.Name)"
                     class="snap-start shrink-0 w-[340px] h-[200px] rounded-2xl bg-surface-container-lowest border border-surface-variant/20 shadow-lg cursor-pointer group relative overflow-hidden flex flex-col justify-end p-6">

                    <div class="absolute inset-0 flex opacity-50 group-hover:opacity-80 transition-opacity duration-500 z-0">
                        @if (list.Entries.Any())
                        {
                            @foreach (var entry in list.Entries.Take(3))
                            {
                                <div class="flex-1 bg-cover bg-center border-l border-surface first:border-l-0"
                                     style="@UiHelpers.CardBackground(entry.Item.PosterUrl)">
                                </div>
                            }
                        }
                    </div>

                    <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/85 to-transparent z-10"></div>

                    <div class="relative z-20 flex items-end justify-between">

                        <div class="flex flex-col">

                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="font-serif text-[20px] text-white group-hover:text-primary transition-colors">
                                    @list.Name
                                </h3>

                                @if (list.IsPrivate)
                                {
                                    <span class="material-symbols-outlined text-[14px] text-on-surface-variant">
                                        lock
                                    </span>
                                }
                            </div>

                            <span class="text-[13px] text-on-surface-variant font-body-md">
                                @list.Entries.Count titles
                            </span>

                        </div>

                        <div class="w-10 h-10 rounded-lg border border-white/20 flex items-center justify-center text-white backdrop-blur-sm group-hover:bg-primary group-hover:text-on-primary group-hover:border-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]">
                                arrow_forward
                            </span>
                        </div>

                    </div>
                </div>
            }

            <div class="snap-start shrink-0 w-[200px] h-[200px] rounded-2xl bg-surface-container-lowest border border-surface-variant/20 shadow-lg cursor-pointer hover:bg-surface-container-low transition-colors flex flex-col items-center justify-center gap-4 group">

                <div class="w-12 h-12 rounded-full border border-surface-variant/40 flex items-center justify-center text-on-surface-variant group-hover:text-primary group-hover:border-primary/50 transition-colors">
                    <span class="material-symbols-outlined text-[24px]">
                        add
                    </span>
                </div>

                <span class="text-[14px] text-on-surface-variant group-hover:text-white transition-colors text-center font-body-md">
                    Create new<br />watchlist
                </span>

            </div>

        </div>
    </div>

    <!-- нижні блоки -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

        <!-- вечір -->
        <div class="bg-surface-container-lowest rounded-2xl border border-surface-variant/20 p-6 flex flex-col">

            <div class="flex items-center justify-between mb-6">
                <h3 class="font-serif text-[18px] text-white">
                    For your next evening
                </h3>

                <a href="#"
                   class="text-[12px] text-on-surface-variant hover:text-white transition-colors flex items-center font-body-md">
                    See all
                    <span class="material-symbols-outlined text-[14px]">
                        arrow_forward
                    </span>
                </a>
            </div>

            <div class="grid grid-cols-4 gap-3">
                @foreach (var media in SuggestedMedia)
                {
                    <div class="aspect-[2/3] rounded-lg bg-cover bg-center shadow-sm border border-surface-variant/10 hover:border-primary/50 transition-colors"
                         style="@UiHelpers.CardBackground(media.PosterUrl)"
                         title="@media.Title">
                    </div>
                }
            </div>

        </div>

        <!-- нотатки-->
        <div class="bg-surface-container-lowest rounded-2xl border border-surface-variant/20 p-6 flex flex-col">

            <div class="flex items-center justify-between mb-6">
                <h3 class="font-serif text-[18px] text-white">
                    Recent captures
                </h3>

                <a href="/captures"
                   class="text-[12px] text-on-surface-variant hover:text-white transition-colors flex items-center font-body-md">
                    View all
                    <span class="material-symbols-outlined text-[14px]">
                        arrow_forward
                    </span>
                </a>
            </div>

            <div class="flex flex-col gap-4">

                @if (Me.Captures != null && Me.Captures.Any())
                {
                    @foreach (var capture in Me.Captures.Take(3))
                    {
                        <div class="flex flex-col gap-1 pb-3 border-b border-surface-variant/20 last:border-b-0">

                            <p class="text-[13px] text-white font-title-md font-medium">
                                "@capture.RawNote"
                            </p>

                            <div class="flex items-center gap-1.5 text-[11px] text-on-surface-variant font-body-md">

                                @if (!string.IsNullOrWhiteSpace(capture.Source))
                                {
                                    <span class="text-secondary">@capture.Source</span>
                                    <span>·</span>
                                }

                                <span>
                                    @capture.CapturedAt.ToString("MMM d, yyyy")
                                </span>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <p class="text-[13px] text-on-surface-variant font-body-md">
                        No captures logged yet.
                    </p>
                }

            </div>
        </div>

        <!-- дії швидкі -->
        <div class="bg-surface-container-lowest rounded-2xl border border-surface-variant/20 p-6 flex flex-col">

            <div class="flex items-center mb-6">
                <h3 class="font-serif text-[18px] text-white">
                    Quick actions
                </h3>
            </div>

            <div class="flex flex-col gap-3">

                <button @onclick="GoToCaptures"
                        class="flex items-center justify-between p-4 rounded-xl border border-surface-variant/20 hover:border-primary/50 hover:bg-surface-container-low transition-all group text-left">

                    <div class="flex items-center gap-4">

                        <span class="material-symbols-outlined text-primary text-[24px]">
                            edit_note
                        </span>

                        <div class="flex flex-col">
                            <span class="text-[14px] text-white font-title-md">
                                Capture
                            </span>

                            <span class="text-[12px] text-on-surface-variant font-body-md">
                                Save a thought
                            </span>
                        </div>

                    </div>

                    <span class="material-symbols-outlined text-on-surface-variant text-[18px] group-hover:translate-x-1 transition-transform">
                        chevron_right
                    </span>

                </button>

                <button @onclick="OpenRouletteDialog"
                        class="flex items-center justify-between p-4 rounded-xl border border-surface-variant/20 hover:border-tertiary/50 hover:bg-surface-container-low transition-all group text-left">

                    <div class="flex items-center gap-4">

                        <span class="material-symbols-outlined text-tertiary text-[24px]">
                            casino
                        </span>

                        <div class="flex flex-col">
                            <span class="text-[14px] text-white font-title-md">
                                Roulette
                            </span>

                            <span class="text-[12px] text-on-surface-variant font-body-md">
                                Random pick
                            </span>
                        </div>

                    </div>

                    <span class="material-symbols-outlined text-on-surface-variant text-[18px] group-hover:translate-x-1 transition-transform">
                        chevron_right
                    </span>

                </button>

            </div>
        </div>

    </div>

    <!-- історія -->
    @{
        var now = DateTime.Now;
        int monthMinutes = Me.GetMonthlyStats(now.Year, now.Month);
        int monthTitles = Me.GetMonthlyWatchCount(now.Year, now.Month);
    }

    <div class="bg-surface-container-lowest rounded-2xl border border-surface-variant/20 px-8 py-5 flex items-center justify-between">

        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-secondary text-[24px]">
                bar_chart
            </span>

            <span class="text-[15px] font-title-md text-white">
                This month
            </span>
        </div>

        <div class="flex items-center gap-12">

            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-on-surface-variant text-[20px]">
                    visibility
                </span>

                <div class="flex flex-col">
                    <span class="text-[15px] text-white font-title-md font-bold leading-none">
                        @monthTitles
                    </span>

                    <span class="text-[11px] text-on-surface-variant font-body-md">
                        watched
                    </span>
                </div>
            </div>

            <div class="w-px h-8 bg-surface-variant/20"></div>

            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-on-surface-variant text-[20px]">
                    schedule
                </span>

                <div class="flex flex-col">
                    <span class="text-[15px] text-white font-title-md font-bold leading-none">
                        @UiHelpers.FormatMinutes(monthMinutes)
                    </span>

                    <span class="text-[11px] text-on-surface-variant font-body-md">
                        total time
                    </span>
                </div>
            </div>

        </div>

        <a href="/history"
           class="text-[13px] text-primary hover:text-primary-fixed-dim transition-colors flex items-center gap-1 font-body-md">
            <span>View history</span>
            <span class="material-symbols-outlined text-[16px]">
                arrow_forward
            </span>
        </a>

    </div>

</div>

@code {
    private User Me => DataService.CurrentUser;

    private Media? FeaturedMedia => DataService.Library.FirstOrDefault();

    private IEnumerable<Media> SuggestedMedia =>
        DataService.Library.Skip(1).Take(4);

    private void OpenList(string listName) =>
        Navigation.NavigateTo($"/watchlists/{Uri.EscapeDataString(listName)}");

    private void GoToCaptures() =>
        Navigation.NavigateTo("/captures");

    private async Task OpenRouletteDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        await DialogService.ShowAsync<RouletteDialog>(
            "Random Pick",
            options);
    }
}