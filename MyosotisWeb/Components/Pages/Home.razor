@page "/"
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject TmdbApiService TmdbService
@inject DemoDataService DataService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Overview</PageTitle>

<div class="w-full px-margin-mobile md:px-margin py-margin-mobile md:py-margin flex flex-col gap-12">

    <!-- банер -->
    @if (isLoading)
    {
        <div class="w-full h-[340px] rounded-lg border border-secondary/25 bg-surface-variant/20 flex flex-col items-center justify-center gap-3">
            <span class="w-7 h-7 border-2 border-primary border-t-transparent rounded-full animate-spin"></span>
            <span class="text-secondary-text font-body-md text-[13px]">Loading recommendations...</span>
        </div>
    }
    else if (FeaturedMedia != null)
    {
        var bannerBgUrl = !string.IsNullOrEmpty(FeaturedMedia.BackdropUrl)
            ? FeaturedMedia.BackdropUrl
            : FeaturedMedia.PosterUrl;

        <div class="relative w-full flex items-center">
            <button @onclick="PrevPick"
                    title="Previous recommendation"
                    aria-label="Previous recommendation"
                    class="absolute left-3 lg:left-4 z-20 w-9 h-9 rounded-full bg-background/90 border border-secondary/35 text-secondary-text hover:text-primary hover:border-primary/60 transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">chevron_left</span>
            </button>

            <div class="relative w-full min-h-[340px] rounded-lg overflow-hidden border border-secondary/30 flex items-center bg-surface-variant/30">
                <div class="absolute inset-0 bg-cover bg-center"
                     style="@UiHelpers.CardBackground(bannerBgUrl)">
                </div>
                <div class="absolute inset-0 bg-background/55"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-background via-background/90 to-background/35"></div>

                <div class="relative z-10 w-full p-7 pl-14 md:p-10 md:pl-16 flex flex-col max-w-2xl">

                    <div class="flex items-center gap-3 mb-3 text-[12px] font-body-md text-secondary-text">
                        <span>Recommendation @(currentIndex + 1) of @trendingList.Count</span>
                        @if (FeaturedMedia.TmdbRating.HasValue)
                        {
                            <span class="text-secondary/40">·</span>
                            <span class="text-tertiary font-semibold">★ @FeaturedMedia.TmdbRating.Value.ToString("0.0", En)</span>
                        }
                    </div>

                    <a href="/media/@FeaturedMedia.Id" class="hover:text-primary transition-colors w-fit">
                        <h1 class="font-headline-xl-mobile md:font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-surface mb-2 line-clamp-1">
                            @FeaturedMedia.Title
                        </h1>
                    </a>

                    <!-- Метадані -->
                    <div class="flex items-center gap-2 font-body-md text-[13px] text-secondary-text mb-4 flex-wrap">
                        <span>@FeaturedMedia.ReleaseYear</span>
                        <span class="text-secondary/40">·</span>
                        <span class="text-on-surface/90">@(FeaturedMedia is Series ? "TV Series" : "Movie")</span>

                        @if (FeaturedMedia.Genres != null && FeaturedMedia.Genres.Count > 0)
                        {
                            <span class="text-secondary/40">·</span>
                            <span>@string.Join(" · ", FeaturedMedia.Genres)</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(FeaturedMedia.Description))
                    {
                        <p class="font-serif italic text-[15px] leading-relaxed text-on-surface/85 max-w-xl line-clamp-2 mb-6">
                            @FeaturedMedia.Description
                        </p>
                    }

                    <div class="flex flex-wrap items-center gap-3">
                        @if (Me.Watchlists.Count > 0)
                        {
                            <div class="flex items-center gap-2 bg-background/95 p-1 rounded-lg border border-secondary/35">
                                <select @bind="selectedWatchlist"
                                        aria-label="Choose watchlist"
                                        class="bg-transparent text-on-surface font-title-md text-[13px] px-2.5 py-1 outline-none cursor-pointer">
                                    @foreach (var list in Me.Watchlists)
                                    {
                                        <option value="@list.Name" class="bg-background text-on-surface">@list.Name</option>
                                    }
                                </select>

                                <button @onclick="AddFeaturedToWatchlist"
                                        class="px-4 py-1.5 rounded-md bg-primary text-on-primary font-title-md font-semibold text-[13px] hover:opacity-90 transition-opacity">
                                    Add to list
                                </button>
                            </div>
                        }

                        <a href="/media/@FeaturedMedia.Id"
                           class="px-4 py-2 rounded-lg border border-secondary/40 text-on-surface hover:text-primary hover:border-primary/60 font-title-md text-[13px] bg-background/70 transition-colors">
                            Details
                        </a>
                    </div>
                </div>
            </div>

            <button @onclick="NextPick"
                    title="Next recommendation"
                    aria-label="Next recommendation"
                    class="absolute right-3 lg:right-4 z-20 w-9 h-9 rounded-full bg-background/90 border border-secondary/35 text-secondary-text hover:text-primary hover:border-primary/60 transition-colors flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">chevron_right</span>
            </button>
        </div>
    }

<!-- вотчлісти -->
    <section class="flex flex-col">
        <div class="flex items-center gap-4 mb-6">
            <h2 class="font-serif text-[24px] text-on-surface">Your watchlists</h2>
            <div class="flex-1 h-px bg-secondary/25"></div>

            @if (Me.Watchlists.Count > 0)
            {
                <div class="flex items-center gap-4 text-[13px] font-body-md">
                    <a href="/watchlists"
                       class="inline-flex items-center gap-1 text-primary hover:underline underline-offset-4 transition-colors">
                        <span class="material-symbols-outlined text-[16px]">add</span>
                        <span>New list</span>
                    </a>
                    <span class="text-secondary/40">·</span>
                    <a href="/watchlists"
                       class="text-secondary-text hover:text-primary transition-colors">
                        View all (@Me.Watchlists.Count)
                    </a>
                </div>
            }
        </div>

        @if (Me.Watchlists.Count == 0)
        {
            <a href="/watchlists"
               class="w-full py-10 px-6 rounded-lg border border-dashed border-secondary/40 hover:border-primary/60 hover:bg-surface-variant/20 transition-colors flex flex-col items-center justify-center gap-3 group text-center">
                <svg class="w-11 h-11 text-primary/85" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M32 56C32 45 31 38 32 32" stroke="#5C80BC" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="32" cy="19" r="6" stroke="currentColor" stroke-width="1.4" fill="#1A2235" />
                    <circle cx="43" cy="27" r="6" stroke="currentColor" stroke-width="1.4" fill="#1A2235" />
                    <circle cx="39" cy="40" r="6" stroke="currentColor" stroke-width="1.4" fill="#1A2235" />
                    <circle cx="25" cy="40" r="6" stroke="currentColor" stroke-width="1.4" fill="#1A2235" />
                    <circle cx="21" cy="27" r="6" stroke="currentColor" stroke-width="1.4" fill="#1A2235" />
                    <circle cx="32" cy="31" r="3.2" fill="#D4915A" />
                </svg>
                <span class="text-[14px] text-secondary-text group-hover:text-on-surface transition-colors font-body-md">
                    You don't have any watchlists yet — create your first one
                </span>
            </a>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var list in TopWatchlists)
                {
                    int totalCount = list.Entries.Count;
                    int watchedCount = list.Entries.Count(e => Me.IsWatched(e.Item));
                    int unwatchedCount = totalCount - watchedCount;
                    int percent = totalCount > 0 ? (int)Math.Round((double)watchedCount / totalCount * 100) : 0;

                    <article @onclick="() => OpenList(list.Name)"
                             class="relative h-[205px] rounded-lg border border-secondary/25 bg-surface-variant/15 hover:border-primary/50 hover:bg-surface-variant/25 cursor-pointer transition-all overflow-hidden group">

                        @if (list.Entries.Count > 0)
                        {
                            var topEntries = list.Entries.Take(3).ToList();
                            <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
                                <div class="absolute right-4 top-4 flex -space-x-9 opacity-85 group-hover:opacity-100 group-hover:-translate-y-0.5 transition-all duration-300">
                                    @for (int i = 0; i < topEntries.Count; i++)
                                    {
                                        var entry = topEntries[i];
                                        string rotation = i == 0 ? "-rotate-6 mt-2" : i == 1 ? "rotate-0 mt-0" : "rotate-6 mt-3";
                                        string zIndex = i == 0 ? "z-30" : i == 1 ? "z-20" : "z-10";

                                        <div class="@zIndex @rotation w-[74px] h-[108px] rounded-sm bg-cover bg-center border border-secondary/40 shadow-lg"
                                             style="@UiHelpers.CardBackground(entry.Item.PosterUrl)">
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="absolute inset-0 bg-gradient-to-r from-background via-background/95 to-background/35 z-10 pointer-events-none"></div>
                        }

                        <div class="relative z-20 h-full p-5 flex flex-col justify-between">
                            <div class="flex items-center">
                                @if (list.IsPrivate)
                                {
                                    <span class="material-symbols-outlined text-[15px] text-secondary-text" title="Private list">lock</span>
                                }
                            </div>

                            <div class="flex flex-col gap-2.5">
                                <div class="flex flex-col gap-0.5 @(list.Entries.Count > 0 ? "pr-16" : "")">
                                    <h3 class="font-serif text-[21px] text-on-surface group-hover:text-primary transition-colors leading-snug truncate">
                                        @list.Name
                                    </h3>
                                    <span class="text-[12px] text-secondary-text font-body-md">
                                        @totalCount @(totalCount == 1 ? "title" : "titles") · @unwatchedCount unwatched
                                    </span>
                                </div>

                                <div class="flex flex-col gap-1.5 pt-0.5">
                                    <div class="w-full h-[2px] bg-secondary/20 overflow-hidden">
                                        <div class="h-full bg-primary transition-all duration-300" style="width: @percent%;"></div>
                                    </div>
                                    <div class="flex items-center justify-between text-[12px] font-body-md">
                                        <span class="text-secondary-text">@percent% watched</span>
                                        <span class="text-on-surface group-hover:text-primary font-title-md text-[12px] inline-flex items-center gap-1 transition-colors">
                                            <span>Open</span>
                                            <span class="material-symbols-outlined text-[14px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pt-2">

        <section class="lg:col-span-5 flex flex-col">
            <div class="flex items-baseline justify-between pb-3 mb-5 border-b border-secondary/20">
                <h3 class="font-serif text-[20px] text-on-surface">
                    For your movie night
                </h3>
                <a href="/search" class="text-[12px] text-secondary-text hover:text-primary transition-colors font-body-md">
                    See all
                </a>
            </div>

            <div class="grid grid-cols-2 gap-5">
                @foreach (var media in SuggestedMedia)
                {
                    <a href="/media/@media.Id" class="flex flex-col gap-2.5 group">
                        <div class="aspect-[2/3] rounded bg-cover bg-center border border-secondary/25 group-hover:border-primary/60 transition-colors"
                             style="@UiHelpers.CardBackground(media.PosterUrl)"
                             title="@media.Title">
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[14px] text-on-surface font-serif font-medium truncate group-hover:text-primary transition-colors">
                                @media.Title
                            </span>
                            <span class="text-[12px] text-secondary-text font-body-md">
                                @media.ReleaseYear
                            </span>
                        </div>
                    </a>
                }
            </div>
        </section>

        <!-- Нотатки -->
        <section class="lg:col-span-4 flex flex-col">
            <div class="flex items-baseline justify-between pb-3 mb-5 border-b border-secondary/20">
                <h3 class="font-serif text-[20px] text-on-surface">
                    Recent captures
                </h3>
                <a href="/captures" class="text-[12px] text-secondary-text hover:text-primary transition-colors font-body-md">
                    View all
                </a>
            </div>

            @if (RecentCaptures.Count > 0)
            {
                <div class="flex flex-col divide-y divide-secondary/15">
                    @foreach (var capture in RecentCaptures)
                    {
                        <a href="/captures" class="py-3.5 first:pt-0 flex flex-col gap-1.5 group">
                            <p class="font-body-md text-[13px] text-on-surface group-hover:text-primary transition-colors line-clamp-3 break-words">
                                "@capture.RawNote"
                            </p>
                            <span class="text-[11px] text-secondary-text font-body-md">
                                @capture.CapturedAt.ToString("MMM d, yyyy", En)
                            </span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="py-6 flex flex-col gap-2">
                    <p class="font-body-md text-[13px] text-secondary-text">
                        No captures saved yet.
                    </p>
                    <a href="/captures" class="text-[13px] text-primary hover:underline underline-offset-4 w-fit font-body-md">
                        Add a note →
                    </a>
                </div>
            }
        </section>

        <!-- Швидкі дії  -->
        <section class="lg:col-span-3 flex flex-col">
            <div class="flex items-baseline justify-between pb-3 mb-5 border-b border-secondary/20">
                <h3 class="font-serif text-[20px] text-on-surface">
                    Quick actions
                </h3>
            </div>

            <div class="flex flex-col divide-y divide-secondary/15">
                <button @onclick="GoToCaptures"
                        class="py-4 first:pt-0 flex items-center justify-between gap-3 group text-left">
                    <div class="flex flex-col gap-0.5">
                        <span class="text-[14px] text-on-surface group-hover:text-primary transition-colors font-title-md">
                            Capture
                        </span>
                        <span class="text-[12px] text-secondary-text font-body-md">
                            Save a thought
                        </span>
                    </div>
                    <span class="material-symbols-outlined text-primary text-[20px] group-hover:translate-x-1 transition-transform">
                        edit_note
                    </span>
                </button>

                <button @onclick="OpenRouletteDialog"
                        class="py-4 flex items-center justify-between gap-3 group text-left">
                    <div class="flex flex-col gap-0.5">
                        <span class="text-[14px] text-on-surface group-hover:text-tertiary transition-colors font-title-md">
                            Roulette
                        </span>
                        <span class="text-[12px] text-secondary-text font-body-md">
                            Random pick
                        </span>
                    </div>
                    <span class="material-symbols-outlined text-tertiary text-[20px] group-hover:translate-x-1 transition-transform">
                        casino
                    </span>
                </button>
            </div>
        </section>

    </div>

    @{
        var now = DateTime.Now;
        int monthMinutes = Me.GetMonthlyStats(now.Year, now.Month);
        int monthTitles = Me.GetMonthlyWatchCount(now.Year, now.Month);
    }

    <footer class="pt-6 border-t border-secondary/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-[13px] font-body-md text-secondary-text">
        <div class="flex flex-wrap items-center gap-2">
            <span class="font-title-md text-[14px] text-on-surface">This month:</span>
            <span>
                <strong class="text-on-surface font-semibold">@monthTitles</strong> watched
            </span>
            @if (monthMinutes > 0)
            {
                <span class="text-secondary/40">·</span>
                <span>@UiHelpers.FormatMinutes(monthMinutes) total time</span>
            }
        </div>

        <a href="/history"
           class="text-primary hover:underline underline-offset-4 transition-colors font-title-md w-fit">
            View history →
        </a>
    </footer>

</div>

@code {
    private List<Media> trendingList = new();
    private Media? FeaturedMedia;
    private int currentIndex = 0;
    private bool isLoading = true;
    private string selectedWatchlist = "";
    private static readonly CultureInfo En = new CultureInfo("en-US");

    private User Me => DataService.CurrentUser;

    protected override async Task OnInitializedAsync()
    {
        await DataService.InitializeAsync();
        isLoading = true;
        var fetchedList = await TmdbService.GetTrendingMediaAsync();

        trendingList.Clear();
        foreach (var item in fetchedList)
        {
            var trackedItem = DataService.GetOrAddToLibrary(item);
            trendingList.Add(trackedItem);
        }

        if (trendingList.Count > 0)
        {
            currentIndex = 0;
            FeaturedMedia = trendingList[currentIndex];
        }

        if (Me.Watchlists.Count > 0)
        {
            selectedWatchlist = Me.Watchlists[0].Name;
        }

        isLoading = false;
    }

    private void PrevPick()
    {
        if (trendingList.Count <= 1) return;
        currentIndex--;
        if (currentIndex < 0) currentIndex = trendingList.Count - 1;
        FeaturedMedia = trendingList[currentIndex];
    }

    private void NextPick()
    {
        if (trendingList.Count <= 1) return;
        currentIndex++;
        if (currentIndex >= trendingList.Count) currentIndex = 0;
        FeaturedMedia = trendingList[currentIndex];
    }

    private async Task AddFeaturedToWatchlist()
    {
        if (FeaturedMedia == null) return;

        Watchlist? target = null;
        foreach (var w in Me.Watchlists)
        {
            if (w.Name == selectedWatchlist)
            {
                target = w;
                break;
            }
        }

        if (target == null) return;

        bool alreadyIn = false;
        foreach (var entry in target.Entries)
        {
            if ((entry.Item.TmdbId.HasValue && FeaturedMedia.TmdbId.HasValue && entry.Item.TmdbId == FeaturedMedia.TmdbId) ||
                entry.Item.Id == FeaturedMedia.Id)
            {
                alreadyIn = true;
                break;
            }
        }

        if (alreadyIn)
        {
            Snackbar.Add($"«{FeaturedMedia.Title}» already in «{selectedWatchlist}»", Severity.Warning);
            return;
        }

        if (FeaturedMedia.TmdbId.HasValue)
        {
            await TmdbService.EnrichMediaDetailsAsync(FeaturedMedia);
        }

        Me.AddMediaToWatchlist(target, FeaturedMedia, null);

        await DataService.SaveStateAsync();

        Snackbar.Add($"«{FeaturedMedia.Title}» added to watchlist «{selectedWatchlist}»", Severity.Success);

        NextPick();
    }

    private List<Media> SuggestedMedia
    {
        get
        {
            var result = new List<Media>();
            var recommender = new MediaRecommendation();

            var userLibrary = new List<Media>();

            void AddUnique(Media? item)
            {
                if (item == null) return;

                if (!userLibrary.Any(x => x.Id == item.Id))
                    userLibrary.Add(item);
            }

            if (Me.Watchlists != null)
            {
                foreach (var watchlist in Me.Watchlists)
                {
                    if (watchlist.Entries == null) continue;

                    foreach (var entry in watchlist.Entries)
                        AddUnique(entry.Item);
                }
            }

            if (Me.RecentlyViewed != null)
            {
                foreach (var item in Me.RecentlyViewed)
                    AddUnique(item);
            }

            if (Me.WatchHistory != null)
            {
                foreach (var entry in Me.WatchHistory)
                    AddUnique(entry.WatchedItem);
            }

            if (userLibrary.Count > 1 && Me.RecentlyViewed != null)
            {
                foreach (var viewed in Me.RecentlyViewed)
                {
                    var similar = recommender.FindSimilar(userLibrary, viewed, 2);

                    foreach (var item in similar)
                    {
                        if (!result.Any(x => x.Id == item.Id))
                            result.Add(item);

                        if (result.Count >= 2) break;
                    }

                    if (result.Count >= 2) break;
                }
            }

            if (result.Count < 2 && userLibrary.Count > 0)
            {
                var topRated = recommender.GetTopRated(userLibrary, userLibrary.Count);

                foreach (var item in topRated)
                {
                    if (!result.Any(x => x.Id == item.Id))
                        result.Add(item);

                    if (result.Count >= 2) break;
                }
            }

            if (result.Count < 2 && userLibrary.Count == 0)
            {
                foreach (var item in trendingList)
                {
                    if (item != FeaturedMedia && !result.Any(x => x.Id == item.Id))
                        result.Add(item);

                    if (result.Count >= 2) break;
                }
            }

            return result;
        }
    }

    private List<CaptureEntry> RecentCaptures
    {
        get
        {
            var result = new List<CaptureEntry>();
            if (Me.Captures != null)
            {
                for (int i = 0; i < Me.Captures.Count && result.Count < 3; i++)
                {
                    result.Add(Me.Captures[i]);
                }
            }
            return result;
        }
    }

    private void OpenList(string listName) =>
        Navigation.NavigateTo($"/watchlists/{Uri.EscapeDataString(listName)}");

    private void GoToCaptures() =>
        Navigation.NavigateTo("/captures");

    private async Task OpenRouletteDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        await DialogService.ShowAsync<RouletteDialog>(
            "Random Pick",
            options);
    }

    private IEnumerable<Watchlist> TopWatchlists =>
        Me.Watchlists.OrderByDescending(w => w.Entries.Count).Take(3);
}