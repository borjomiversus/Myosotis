@page "/captures"
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Captures</PageTitle>

<div class="max-w-[1200px] mx-auto px-margin py-margin flex flex-col gap-10">

    <!-- Заголовок -->
    <div class="flex flex-col gap-2">
        <h1 class="font-serif text-[40px] text-[#E2E8F0] leading-tight">Captures</h1>
        <p class="font-body-md text-secondary italic">Everything you noted down, ready to be linked and sorted.</p>
    </div>

    <!-- Рядок швидкого додавання з довільним текстовим полем для Source -->
    <div class="flex flex-col sm:flex-row gap-3 items-center bg-secondary/10 backdrop-blur-md p-4 rounded-lg border border-secondary/20 shadow-lg">
        <input @bind="newCaptureText"
               @bind:event="oninput"
               @onkeydown="OnCaptureKey"
               placeholder="Half-remembered scene, a title, anything…"
               class="flex-1 w-full bg-background rounded-lg px-4 py-2.5 outline-none text-[#E2E8F0] placeholder:text-[#E2E8F0]/50 border border-secondary/30 focus:border-primary font-body-md" />
        
        <!-- Довільний текст для джерела -->
        <input @bind="customSource"
               placeholder="Source (e.g. TikTok, a friend...)"
               class="w-full sm:w-[220px] bg-background rounded-lg px-4 py-2.5 outline-none text-[#E2E8F0] placeholder:text-[#E2E8F0]/50 border border-secondary/30 focus:border-primary font-body-md text-[13px]" />

        <button @onclick="AddCapture" class="w-full sm:w-auto px-6 py-2.5 bg-primary text-background rounded-lg font-title-md font-bold hover:opacity-90 transition-opacity shadow-md whitespace-nowrap">
            Catch it
        </button>
    </div>

    @if (VisibleCaptures().Count == 0)
    {
        <p class="font-body-md text-[#E2E8F0]/70">No captures yet. Write down the first thing that caught your eye.</p>
    }

    <!-- Список капчерів -->
    <div class="flex flex-col gap-4">
        @foreach (var c in VisibleCaptures())
        {
            <div class="bg-gradient-to-r from-secondary/10 via-background to-secondary/5 rounded-lg border border-secondary/20 p-5 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-md backdrop-blur-md relative">

                <!-- Ліва частина: Текст думки, дата та твоє довільне джерело -->
                <div class="flex flex-col gap-1.5 max-w-lg">
                    <div class="font-serif text-[17px] text-[#E2E8F0]">&ldquo;@c.RawNote&rdquo;</div>
                    <div class="flex items-center gap-2 text-[11px] text-secondary font-body-md">
                        <span class="text-primary font-medium">@(string.IsNullOrWhiteSpace(c.Source) ? "Manual" : c.Source)</span>
                        <span>·</span>
                        <span class="text-[#E2E8F0]/60">@c.CapturedAt.ToString("MMM d, HH:mm", En)</span>
                    </div>
                </div>

                 <!-- Права частина: Пошук або картка розпізнаного фільму з міні-постером -->
                <div class="flex items-center gap-3 shrink-0 flex-wrap relative z-40">
                    @if (c.Status == CaptureStatus.Unresolved)
                    {
                        <span class="px-2.5 py-1 rounded bg-tertiary/15 text-tertiary font-label-caps tracking-wider text-[10px] border border-tertiary/30">
                            UNRESOLVED
                        </span>

                        <!-- Поле пошуку з абсолютним позиціюванням поверх інших карток -->
                        <div class="relative">
                            <input type="text"
                                   placeholder="Знайти фільм за описом..."
                                   @value="@GetSearchQuery(c)"
                                   @oninput="e => UpdateSearchQuery(c, e.Value?.ToString())"
                                   class="bg-background border border-secondary/30 rounded-lg px-3.5 py-2 text-[#E2E8F0] outline-none focus:border-primary font-body-md text-[13px] w-[210px] placeholder:text-[#E2E8F0]/40" />

                            @if (IsSearching(c))
                            {
                                <div class="absolute left-0 top-full mt-2 w-full min-w-[280px] bg-[#1A2235] border border-secondary/30 rounded-lg shadow-2xl z-[100] max-h-48 overflow-y-auto flex flex-col">
                                    @foreach (var m in FilteredLibrary(c))
                                    {
                                        <button @onclick="() => SelectAndLink(c, m.Title)"
                                                class="text-left px-3 py-2.5 text-[13px] text-[#E2E8F0] hover:bg-secondary/20 hover:text-primary transition-colors border-b border-secondary/10 last:border-b-0 flex items-center gap-3 cursor-pointer">
                                            @if (!string.IsNullOrEmpty(m.PosterUrl))
                                            {
                                                <div class="w-7 h-10 rounded bg-cover bg-center shrink-0 border border-secondary/30" style="@UiHelpers.CardBackground(m.PosterUrl)"></div>
                                            }
                                            <div class="flex flex-col truncate">
                                                <span class="truncate font-medium">@m.Title</span>
                                                <span class="text-secondary text-[11px]">@m.ReleaseYear</span>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (c.ResolvedMedia != null)
                    {
                        <!-- Після зв'язування: красива картка з міні-постером -->
                        <div class="flex items-center gap-3 bg-secondary/15 px-3 py-1.5 rounded-lg border border-secondary/30">
                            @if (!string.IsNullOrEmpty(c.ResolvedMedia.PosterUrl))
                            {
                                <div class="w-8 h-12 rounded bg-cover bg-center shrink-0 border border-secondary/30 shadow-md" style="@UiHelpers.CardBackground(c.ResolvedMedia.PosterUrl)"></div>
                            }
                            <div class="flex flex-col">
                                <span class="text-[13px] text-white font-bold truncate max-w-[150px]">@c.ResolvedMedia.Title</span>
                                <span class="text-[11px] text-secondary">@c.ResolvedMedia.ReleaseYear</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            @if (Me.Watchlists.Count == 0)
                            {
                                <span class="text-[12px] text-[#E2E8F0]/70">No lists available</span>
                            }
                            else
                            {
                                <select @onchange="e => PickList(c, e.Value?.ToString())" class="bg-background border border-secondary/30 rounded-lg px-3 py-2 text-[#E2E8F0] outline-none focus:border-primary font-body-md text-[13px]">
                                    @foreach (var list in Me.Watchlists)
                                    {
                                        <option value="@list.Name">@list.Name</option>
                                    }
                                </select>
                                <button @onclick="() => AddToList(c)" class="px-3.5 py-2 rounded-lg bg-primary text-background hover:opacity-90 transition-opacity font-title-md font-bold text-[13px] shadow-md whitespace-nowrap">
                                    + Додати у список
                                </button>
                            }
                        </div>
                    }
                </div>

            </div>
        }
    </div>

</div>

@code {
    private static readonly CultureInfo En = new CultureInfo("en-US");

    private string newCaptureText = "";
    private string customSource = "";
    private readonly Dictionary<CaptureEntry, string> searchQueries = new Dictionary<CaptureEntry, string>();
    private readonly Dictionary<CaptureEntry, string> pickedLists = new Dictionary<CaptureEntry, string>();

    private User Me => DataService.CurrentUser;

    private List<CaptureEntry> VisibleCaptures()
    {
        return Me.Captures
            .Where(c => c.Status != CaptureStatus.Archived)
            .OrderByDescending(c => c.CapturedAt)
            .ToList();
    }

    private void OnCaptureKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddCapture();
    }

    private void AddCapture()
    {
        if (string.IsNullOrWhiteSpace(newCaptureText)) return;

        string finalSource = string.IsNullOrWhiteSpace(customSource) ? "Manual" : customSource.Trim();
        Me.AddCapture(newCaptureText.Trim(), finalSource);
        
        newCaptureText = "";
        customSource = "";
    }

    private string GetSearchQuery(CaptureEntry c)
    {
        searchQueries.TryGetValue(c, out var q);
        return q ?? "";
    }

    private void UpdateSearchQuery(CaptureEntry c, string? query)
    {
        searchQueries[c] = query ?? "";
    }

    private bool IsSearching(CaptureEntry c)
    {
        var q = GetSearchQuery(c);
        return !string.IsNullOrWhiteSpace(q);
    }

    private IEnumerable<Media> FilteredLibrary(CaptureEntry c)
    {
        var q = GetSearchQuery(c).ToLowerInvariant();
        return DataService.Library
            .Where(m => m.Title.ToLowerInvariant().Contains(q) || (m.Genres != null && m.Genres.Any(g => g.ToLowerInvariant().Contains(q))));
    }

    private void SelectAndLink(CaptureEntry c, string title)
    {
        searchQueries[c] = "";
        Media? media = DataService.Library.FirstOrDefault(m => m.Title == title);
        if (media == null) return;

        c.Resolve(media);
        Snackbar.Add($"Recognized as \"{media.Title}\"", Severity.Success);
    }

    private void PickList(CaptureEntry capture, string? listName)
    {
        pickedLists[capture] = listName ?? "";
    }

    private void AddToList(CaptureEntry capture)
    {
        string listName;
        if (!pickedLists.TryGetValue(capture, out listName!) || string.IsNullOrEmpty(listName))
            listName = Me.Watchlists[0].Name;
        if (Me.MoveResolvedCaptureToWatchlist(capture, listName))
            Snackbar.Add($"Added to \"{listName}\"", Severity.Success);
    }
}