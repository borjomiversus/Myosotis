@page "/captures"
@using System.Globalization
@using System.Text.RegularExpressions
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Captures</PageTitle>

<div class="w-full px-margin py-margin flex flex-col gap-10">

    @{
        var waiting = Me.Captures.Where(c => c.Status == CaptureStatus.Unresolved).OrderByDescending(c => c.CapturedAt).ToList();
        var named = Me.Captures.Where(c => c.Status == CaptureStatus.Resolved).OrderByDescending(c => c.CapturedAt).ToList();
    }

    <!-- Заголовок -->
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-secondary/25">
        <div class="flex flex-col gap-2">
            <h1 class="font-headline-xl text-headline-xl text-on-surface leading-none">Captures & notes</h1>
            <p class="font-body-md text-[14px] text-secondary-text">Save it now. Figure out what it is later.</p>
        </div>

        @if (Me.Captures.Count > 0)
        {
            <div class="font-body-md text-[13px] text-secondary-text flex items-center gap-2">
                <span>
                    <strong class="text-on-surface font-semibold">@waiting.Count</strong> unresolved
                </span>
                <span class="text-secondary/40">·</span>
                <span>
                    <strong class="text-on-surface font-semibold">@named.Count</strong> linked
                </span>
                <span class="text-secondary/40">·</span>
                <span>
                    <strong class="text-on-surface font-semibold">@Me.Captures.Count</strong> total
                </span>
            </div>
        }
    </header>

    <!-- Форма швидкого запису -->
    <div class="flex flex-col lg:flex-row gap-3 items-center bg-surface-variant/25 p-4 rounded-xl border border-secondary/30">
        <input @bind="newCaptureText"
               @bind:event="oninput"
               @onkeydown="OnCaptureKey"
               placeholder="Half-remembered scene, a dialogue line, a thought…"
               class="flex-1 w-full bg-background rounded-lg px-4 py-2.5 outline-none text-on-surface placeholder:text-secondary-text border border-secondary/30 focus:border-primary font-body-md text-[14px] transition-colors" />

        <div class="flex w-full lg:w-auto gap-3">
            <select @bind="selectedKind"
                    aria-label="Note type"
                    class="w-full lg:w-[130px] bg-background border border-secondary/30 rounded-lg px-3 py-2.5 text-on-surface outline-none focus:border-primary font-body-md text-[13px] cursor-pointer">
                @foreach (CaptureKind kind in Enum.GetValues(typeof(CaptureKind)))
                {
                    <option value="@kind" class="bg-background text-on-surface">@kind</option>
                }
            </select>

            <input value="@newTimecode"
                   @oninput="OnTimecodeInput"
                   maxlength="8"
                   placeholder="00:00:00"
                   title="Format: mm:ss or hh:mm:ss"
                   class="w-full lg:w-[100px] bg-background rounded-lg px-3 py-2.5 outline-none text-on-surface placeholder:text-secondary-text border border-secondary/30 focus:border-primary font-body-md text-[13px] text-center transition-colors" />

            <input @bind="customSource"
                   placeholder="Source"
                   class="w-full lg:w-[150px] bg-background rounded-lg px-3 py-2.5 outline-none text-on-surface placeholder:text-secondary-text border border-secondary/30 focus:border-primary font-body-md text-[13px] transition-colors" />
        </div>

        <button @onclick="AddCapture"
                class="w-full lg:w-auto px-6 py-2.5 bg-primary text-on-primary rounded-lg font-title-md font-semibold text-[13px] hover:opacity-90 transition-opacity whitespace-nowrap">
            Catch it
        </button>
    </div>

    @if (waiting.Count == 0 && named.Count == 0)
    {
        <div class="flex flex-col items-center justify-center py-20 text-center max-w-md mx-auto">
            <p class="font-body-md text-[14px] text-secondary-text leading-relaxed">
                Nothing here yet. Write down the first thing that caught your eye.
            </p>
        </div>
    }

    <!-- Нерозпізнані нотатки -->
    @if (waiting.Count > 0)
    {
        <section class="flex flex-col gap-6">
            <div class="flex items-center gap-4">
                <h2 class="font-serif text-[24px] text-on-surface">Waiting to be named</h2>
                <span class="text-secondary-text font-body-md text-[13px]">(@waiting.Count)</span>
                <div class="flex-1 h-px bg-secondary/25"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var c in waiting)
                {
                    bool isExpanded = expandedCaptures.Contains(c);

                    <article class="relative flex flex-col justify-between rounded-xl bg-surface-variant/20 border border-dashed border-secondary/40 p-6 hover:border-primary/50 transition-colors group">

                        <div class="flex flex-col gap-4 mb-6">
                            <div class="flex items-center justify-between gap-2">
                                <span class="bg-secondary-fill text-on-surface font-title-md text-[11px] px-2.5 py-0.5 rounded-md">
                                    Unresolved · @c.Kind
                                </span>

                                <div class="flex items-center gap-2">
                                    @if (!string.IsNullOrEmpty(c.Timecode))
                                    {
                                        <span class="text-secondary-text font-body-md text-[12px]">
                                            @c.Timecode
                                        </span>
                                    }
                                    <button @onclick="() => Delete(c.Id)"
                                            class="text-secondary-text hover:text-error transition-colors p-1"
                                            title="Delete note">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(c.RawNote))
                            {
                                <div>
                                    <p class="font-body-md text-[14px] text-on-surface leading-relaxed break-words @(isExpanded ? "" : "line-clamp-4")">
                                        &ldquo;@c.RawNote&rdquo;
                                    </p>

                                    @if (c.RawNote.Length > 140)
                                    {
                                        <button @onclick="() => ToggleExpand(c)"
                                                class="text-primary hover:underline underline-offset-4 text-[12px] font-title-md mt-2 inline-flex items-center gap-1">
                                            <span>@(isExpanded ? "Show less" : "Read full note")</span>
                                        </button>
                                    }
                                </div>
                            }

                            <div class="text-[12px] text-secondary-text font-body-md flex items-center justify-between gap-2 pt-3 border-t border-secondary/15">
                                <div class="flex items-center gap-1.5 truncate flex-1 min-w-0">
                                    @{
                                        string source = string.IsNullOrWhiteSpace(c.Source) ? "Manual" : c.Source.Trim();
                                        bool isUrl = source.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                                                     source.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                                    }

                                    @if (isUrl)
                                    {
                                        <a href="@source" target="_blank" rel="noopener noreferrer"
                                           class="inline-flex items-center gap-1 text-primary hover:underline underline-offset-4 font-title-md text-[12px] shrink-0">
                                            <span>Open link</span>
                                            <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                                        </a>
                                    }
                                    else
                                    {
                                        bool isLong = source.Length > 28;
                                        bool isSourceExpanded = expandedSources.Contains(c.Id);

                                        <span class="truncate @(isSourceExpanded ? "whitespace-normal break-words" : "")">@source</span>

                                        @if (isLong)
                                        {
                                            <button @onclick="() => ToggleSourceExpand(c.Id)"
                                                    class="text-primary hover:underline text-[11px] ml-1 shrink-0 font-title-md">
                                                @(isSourceExpanded ? "Less" : "Full")
                                            </button>
                                        }
                                    }
                                </div>
                                <span class="text-[11px] text-secondary-text shrink-0">@c.CapturedAt.ToString("MMM d", En)</span>
                            </div>
                        </div>

                        <!-- Пошук для прив'язки до фільму/серіалу -->
                        <div class="relative mt-auto pt-4 border-t border-secondary/20">
                            <input type="text"
                                   placeholder="Search title to link..."
                                   value="@GetSearchQuery(c)"
                                   @oninput="e => UpdateSearchQuery(c, e.Value?.ToString())"
                                   class="w-full bg-background border border-secondary/35 rounded-lg px-3.5 py-2 text-on-surface outline-none focus:border-primary transition-colors font-body-md text-[13px] placeholder:text-secondary-text" />

                            @if (IsSearching(c))
                            {
                                var matches = GetMatches(c).ToList();
                                <div class="absolute left-0 right-0 top-full mt-2 bg-surface-variant border border-secondary/40 rounded-xl max-h-72 overflow-y-auto flex flex-col z-50">
                                    @if (matches.Count == 0)
                                    {
                                        <div class="px-4 py-4 text-[13px] text-secondary-text font-body-md text-center">
                                            No titles found matching "@GetSearchQuery(c)".
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var m in matches)
                                        {
                                            <button @onclick="() => SelectAndLink(c, m)"
                                                    class="text-left px-3.5 py-2.5 text-[13px] text-on-surface hover:bg-secondary/20 hover:text-primary transition-colors border-b border-secondary/15 last:border-b-0 flex items-center gap-3">
                                                @if (!string.IsNullOrEmpty(m.PosterUrl))
                                                {
                                                    <div class="w-9 h-[54px] rounded bg-cover bg-center shrink-0 border border-secondary/30" style="@UiHelpers.CardBackground(m.PosterUrl)"></div>
                                                }
                                                else
                                                {
                                                    <div class="w-9 h-[54px] rounded bg-background flex items-center justify-center shrink-0 text-secondary-text text-[11px]">
                                                        —
                                                    </div>
                                                }
                                                <div class="flex flex-col truncate">
                                                    <span class="truncate font-serif font-semibold text-[15px]">@m.Title</span>
                                                    <span class="text-secondary-text font-body-md text-[12px]">@m.ReleaseYear · @(m is Series ? "Series" : "Movie")</span>
                                                </div>
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <!-- Розпізнаний каталог -->
    @if (named.Count > 0)
    {
        <section class="flex flex-col gap-6">
            <div class="flex items-center gap-4">
                <h2 class="font-serif text-[24px] text-on-surface">Linked notes</h2>
                <span class="text-secondary-text font-body-md text-[13px]">(@named.Count)</span>
                <div class="flex-1 h-px bg-secondary/25"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var c in named)
                {
                    bool isExpanded = expandedCaptures.Contains(c);

                    <article class="flex flex-col justify-between rounded-xl bg-surface-variant/25 border border-secondary/25 overflow-hidden hover:border-primary/50 transition-colors group">

                        @if (c.Kind == CaptureKind.Scene && !string.IsNullOrEmpty(c.ResolvedMedia?.PosterUrl))
                        {
                            <div class="relative h-44 w-full bg-background overflow-hidden border-b border-secondary/20">
                                <div class="absolute inset-0 bg-cover bg-center opacity-85" style="@UiHelpers.CardBackground(c.ResolvedMedia.PosterUrl)"></div>
                                <div class="absolute inset-0 bg-gradient-to-t from-background via-background/30 to-transparent"></div>

                                <span class="absolute top-3 left-3 bg-background/85 text-primary font-title-md text-[11px] px-2.5 py-0.5 rounded-md border border-secondary/30">
                                    @c.Kind
                                </span>

                                <div class="absolute top-3 right-3 flex items-center gap-2">
                                    @if (!string.IsNullOrEmpty(c.Timecode))
                                    {
                                        <span class="font-body-md text-[11px] text-on-surface bg-background/85 px-2.5 py-0.5 rounded-md border border-secondary/30">
                                            @c.Timecode
                                        </span>
                                    }
                                    <button @onclick="() => Delete(c.Id)"
                                            class="text-secondary-text hover:text-error bg-background/85 p-1 rounded-md border border-secondary/30 transition-colors"
                                            title="Delete note">
                                        <span class="material-symbols-outlined text-[16px]">delete</span>
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="p-6 flex flex-col gap-4 h-full">

                            @if (c.Kind != CaptureKind.Scene || string.IsNullOrEmpty(c.ResolvedMedia?.PosterUrl))
                            {
                                <div class="flex items-center justify-between gap-2">
                                    <span class="bg-secondary-fill text-primary font-title-md text-[11px] px-2.5 py-0.5 rounded-md">
                                        @c.Kind
                                    </span>
                                    <div class="flex items-center gap-2">
                                        @if (!string.IsNullOrEmpty(c.Timecode))
                                        {
                                            <span class="text-secondary-text font-body-md text-[12px]">
                                                @c.Timecode
                                            </span>
                                        }
                                        <button @onclick="() => Delete(c.Id)"
                                                class="text-secondary-text hover:text-error transition-colors p-1"
                                                title="Delete note">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </div>
                                </div>
                            }

                            <div class="flex items-baseline justify-between gap-2 border-b border-secondary/20 pb-3">
                                <a href="/media/@c.ResolvedMedia?.Id" class="font-serif font-semibold text-[18px] text-on-surface hover:text-primary transition-colors truncate">
                                    @c.ResolvedMedia?.Title
                                </a>
                                <span class="font-body-md text-[12px] text-secondary-text shrink-0">@c.ResolvedMedia?.ReleaseYear</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(c.RawNote))
                            {
                                <div>
                                    <p class="font-body-md text-[14px] text-on-surface/90 leading-relaxed break-words @(isExpanded ? "" : "line-clamp-4")">
                                        &ldquo;@c.RawNote&rdquo;
                                    </p>

                                    @if (c.RawNote.Length > 140)
                                    {
                                        <button @onclick="() => ToggleExpand(c)"
                                                class="text-primary hover:underline underline-offset-4 text-[12px] font-title-md mt-2 inline-flex items-center gap-1">
                                            <span>@(isExpanded ? "Show less" : "Read full note")</span>
                                        </button>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(c.Annotation))
                            {
                                <p class="font-body-md text-[13px] text-secondary-text leading-relaxed bg-background/60 p-3 rounded-lg border border-secondary/20 line-clamp-2 break-words" title="@c.Annotation">
                                    @c.Annotation
                                </p>
                            }

                            <div class="text-[12px] text-secondary-text font-body-md flex items-center justify-between gap-2 pt-3 border-t border-secondary/15">
                                <div class="flex items-center gap-1.5 truncate flex-1 min-w-0">
                                    @{
                                        string source = string.IsNullOrWhiteSpace(c.Source) ? "Manual" : c.Source.Trim();
                                        bool isUrl = source.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                                                     source.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
                                    }

                                    @if (isUrl)
                                    {
                                        <a href="@source" target="_blank" rel="noopener noreferrer"
                                           class="inline-flex items-center gap-1 text-primary hover:underline underline-offset-4 font-title-md text-[12px] shrink-0">
                                            <span>Open link</span>
                                            <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                                        </a>
                                    }
                                    else
                                    {
                                        bool isLong = source.Length > 28;
                                        bool isSourceExpanded = expandedSources.Contains(c.Id);

                                        <span class="truncate @(isSourceExpanded ? "whitespace-normal break-words" : "")">@source</span>

                                        @if (isLong)
                                        {
                                            <button @onclick="() => ToggleSourceExpand(c.Id)"
                                                    class="text-primary hover:underline text-[11px] ml-1 shrink-0 font-title-md">
                                                @(isSourceExpanded ? "Less" : "Full")
                                            </button>
                                        }
                                    }
                                </div>
                                <span class="text-[11px] text-secondary-text shrink-0">@c.CapturedAt.ToString("MMM d", En)</span>
                            </div>

                            <!-- Панель додавання у Watchlist -->
                            <div class="mt-auto pt-3 flex flex-wrap gap-2 items-center justify-between w-full">
                                @{
                                    var containingList = c.ResolvedMedia != null
                                        ? Me.Watchlists.FirstOrDefault(w => w.Entries.Any(e => e.Item.Id == c.ResolvedMedia.Id))
                                        : null;
                                }

                                @if (containingList != null)
                                {
                                    <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-secondary-fill/60 border border-secondary/30 text-primary w-full">
                                        <span class="font-title-md text-[12px] truncate">In list: @containingList.Name</span>
                                        <button @onclick='() => Navigation.NavigateTo($"/watchlists/{Uri.EscapeDataString(containingList.Name)}")'
                                                class="text-[12px] text-on-surface hover:text-primary underline underline-offset-4 font-title-md shrink-0 ml-2">
                                            Open
                                        </button>
                                    </div>
                                }
                                else if (Me.Watchlists.Count == 0)
                                {
                                    <span class="text-[12px] text-secondary-text font-body-md">Create a watchlist first.</span>
                                }
                                else
                                {
                                    <div class="flex items-center gap-2 w-full">
                                        <select @onchange="e => PickList(c, e.Value?.ToString())"
                                                aria-label="Choose watchlist"
                                                class="flex-1 min-w-0 bg-background border border-secondary/35 rounded-lg px-3 py-1.5 text-on-surface outline-none focus:border-primary font-body-md text-[12px] cursor-pointer">
                                            @foreach (var list in Me.Watchlists)
                                            {
                                                <option value="@list.Name" class="bg-background text-on-surface">@list.Name</option>
                                            }
                                        </select>
                                        <button @onclick="() => AddToList(c)"
                                                class="px-3.5 py-1.5 rounded-lg border border-primary/50 text-primary hover:bg-primary hover:text-on-primary font-title-md font-semibold text-[12px] transition-colors whitespace-nowrap">
                                            Add
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string newCaptureText = "";
    private string customSource = "";
    private string newTimecode = "";
    private CaptureKind selectedKind = CaptureKind.Thought;
    private static readonly CultureInfo En = new CultureInfo("en-US");
    private readonly Dictionary<CaptureEntry, string> searchQueries = new();
    private readonly Dictionary<CaptureEntry, string> pickedLists = new();
    private readonly HashSet<CaptureEntry> expandedCaptures = new();
    private readonly HashSet<Guid> expandedSources = new();

    private User Me => DataService.CurrentUser;

    private async Task OnCaptureKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddCapture();
    }

    private async Task AddCapture()
    {
        if (string.IsNullOrWhiteSpace(newCaptureText)) return;

        string source = string.IsNullOrWhiteSpace(customSource) ? "Manual" : customSource.Trim();

        Me.AddCapture(newCaptureText.Trim(), source, selectedKind, newTimecode);

        newCaptureText = customSource = newTimecode = "";
        selectedKind = CaptureKind.Thought;

        await DataService.SaveStateAsync();
    }

    private string GetSearchQuery(CaptureEntry c) => searchQueries.TryGetValue(c, out var q) ? q : "";
    private void UpdateSearchQuery(CaptureEntry c, string? query) => searchQueries[c] = query ?? "";
    private bool IsSearching(CaptureEntry c) => !string.IsNullOrWhiteSpace(GetSearchQuery(c));

    private IEnumerable<Media> GetMatches(CaptureEntry c)
    {
        string q = GetSearchQuery(c)?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(q)) return Enumerable.Empty<Media>();

        return DataService.SearchLibrary(q) ?? Enumerable.Empty<Media>();
    }

    private async Task SelectAndLink(CaptureEntry c, Media m)
    {
        searchQueries[c] = "";
        c.Resolve(m);
        Snackbar.Add($"Recognized as \"{m.Title}\"", Severity.Success);

        await DataService.SaveStateAsync();
    }

    private void PickList(CaptureEntry c, string? listName) => pickedLists[c] = listName ?? "";

    private async Task AddToList(CaptureEntry c)
    {
        if (c.ResolvedMedia == null) return;

        pickedLists.TryGetValue(c, out string? listName);
        if (string.IsNullOrEmpty(listName)) listName = Me.Watchlists.FirstOrDefault()?.Name;

        var list = Me.Watchlists.FirstOrDefault(w => w.Name == listName);
        if (list != null)
        {
            Me.AddMediaToWatchlist(list, c.ResolvedMedia, c.RawNote);
            Snackbar.Add($"Added \"{c.ResolvedMedia.Title}\" to \"{list.Name}\"", Severity.Success);

            await DataService.SaveStateAsync();
            StateHasChanged();
        }
    }

    private void ToggleExpand(CaptureEntry c)
    {
        if (expandedCaptures.Contains(c))
            expandedCaptures.Remove(c);
        else
            expandedCaptures.Add(c);
    }

    private async Task Delete(Guid captureId)
    {
        Me.DeleteCapture(captureId);
        Snackbar.Add("Note deleted", Severity.Info);

        await DataService.SaveStateAsync();
        StateHasChanged();
    }

    private void ToggleSourceExpand(Guid captureId)
    {
        if (expandedSources.Contains(captureId))
            expandedSources.Remove(captureId);
        else
            expandedSources.Add(captureId);
    }

    private void OnTimecodeInput(ChangeEventArgs e)
    {
        string? val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val))
        {
            newTimecode = "";
            return;
        }

        string digits = new string(val.Where(char.IsDigit).ToArray());
        if (digits.Length > 6) digits = digits.Substring(0, 6);

        if (digits.Length > 4)
        {
            newTimecode = $"{digits.Substring(0, 2)}:{digits.Substring(2, 2)}:{digits.Substring(4)}";
        }
        else if (digits.Length > 2)
        {
            newTimecode = $"{digits.Substring(0, 2)}:{digits.Substring(2)}";
        }
        else
        {
            newTimecode = digits;
        }
    }
}