@page "/captures"
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Captures</PageTitle>

<div class="max-w-[1200px] mx-auto px-margin py-margin flex flex-col gap-10">

    <!-- Заголовок -->
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div class="flex flex-col max-w-2xl">
            <h1 class="font-headline-xl text-headline-xl text-[#E2E8F0]">Captures & notes</h1>
            <p class="font-body-lg text-body-lg text-secondary italic font-serif">Save it now. Figure out what it is later.</p>
        </div>

        <div class="hidden lg:flex items-center gap-2 bg-secondary/10 border border-secondary/20 px-4 py-2 rounded-lg">
            <span class="material-symbols-outlined text-secondary text-[18px]">history_edu</span>
            <span class="font-body-md text-[12px] text-secondary">Total saved:</span>
            <span class="font-title-md text-[14px] text-[#E2E8F0] font-bold">@Me.Captures.Count()</span>
        </div>
    </header>

    <div class="flex flex-col gap-3 bg-secondary/10 backdrop-blur-md p-5 rounded-xl border border-secondary/30 shadow-xl">
        <div class="flex flex-col lg:flex-row gap-3 items-center">
            
            <input @bind="newCaptureText"
                   @bind:event="oninput"
                   @onkeydown="OnCaptureKey"
                   placeholder="Half-remembered scene, a dialogue line, a thought…"
                   class="flex-1 w-full bg-background rounded-xl px-4 py-3 outline-none text-[#E2E8F0] placeholder:text-secondary/60 border border-secondary/30 focus:border-primary font-body-md shadow-inner" />
            
            <div class="flex w-full lg:w-auto gap-3">
                <select @bind="selectedKind" class="w-full lg:w-[130px] bg-background border border-secondary/30 rounded-xl px-3 py-3 text-[#E2E8F0] outline-none focus:border-primary font-body-md text-[13px]">
                    @foreach (CaptureKind kind in Enum.GetValues(typeof(CaptureKind)))
                    {
                        <option value="@kind">@kind</option>
                    }
                </select>

                <input @bind="newTimecode"
                       pattern="[0-9]{2}:[0-9]{2}(:[0-9]{2})?"
                       placeholder="00:00:00"
                       title="Format: mm:ss or hh:mm:ss"
                       class="w-full lg:w-[100px] bg-background rounded-xl px-3 py-3 outline-none text-[#E2E8F0] placeholder:text-secondary/50 border border-secondary/30 focus:border-primary font-body-md text-[13px] text-center" />

                <input @bind="customSource"
                       placeholder="Source..."
                       class="w-full lg:w-[150px] bg-background rounded-xl px-3 py-3 outline-none text-[#E2E8F0] placeholder:text-secondary/50 border border-secondary/30 focus:border-primary font-body-md text-[13px]" />
            </div>

            <button @onclick="AddCapture" class="w-full lg:w-auto px-8 py-3 bg-primary text-background rounded-xl font-title-md font-bold hover:opacity-90 transition-all shadow-[0_0_15px_rgba(132,220,198,0.2)] whitespace-nowrap">
                Catch it
            </button>
        </div>
    </div>

    @{
        var waiting = Me.ActiveCaptures.Where(c => c.Status == CaptureStatus.Unresolved).ToList();
        var named = Me.ActiveCaptures.Where(c => c.Status == CaptureStatus.Resolved).ToList();
    }

    @if (waiting.Count == 0 && named.Count == 0)
    {
        <div class="flex flex-col items-center justify-center py-20 opacity-50">
            <span class="material-symbols-outlined text-[48px] text-secondary mb-4">movie_filter</span>
            <p class="font-body-md text-[#E2E8F0]">Nothing here yet. Write down the first thing that caught your eye.</p>
        </div>
    }

    <!-- ОЧІКУЮТЬ РОЗПІЗНАВАННЯ -->
    @if (waiting.Count > 0)
    {
        <section class="flex flex-col gap-6 mt-4">
            <div class="flex items-center gap-4">
                <h2 class="font-serif text-[24px] text-white">Waiting to be named</h2>
                <span class="bg-[#C9C0F4]/20 text-[#C9C0F4] px-2 py-0.5 rounded text-[12px] font-bold">@waiting.Count</span>
                <div class="flex-1 h-px bg-secondary/20"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var c in waiting)
                {
                    <article class="relative flex flex-col justify-between rounded-xl bg-background border-2 border-dashed border-secondary/30 p-6 hover:border-[#C9C0F4]/50 transition-colors shadow-lg group overflow-visible">
                        
                        <div class="flex flex-col gap-4 mb-6">
                            <div class="flex items-center justify-between">
                                <span class="bg-[#C9C0F4]/15 text-[#C9C0F4] font-label-caps text-[10px] px-2.5 py-1 rounded-full uppercase tracking-widest font-bold">
                                    UNRESOLVED
                                </span>
                                @if (!string.IsNullOrEmpty(c.Timecode))
                                {
                                    <div class="flex items-center gap-1 text-secondary font-label-caps text-[10px]">
                                        <span class="material-symbols-outlined text-[14px]">timer</span>
                                        <span>@c.Timecode</span>
                                    </div>
                                }
                            </div>

                            <div class="relative pl-4">
                                <div class="absolute left-0 top-0 bottom-0 w-1 rounded-full bg-secondary/30"></div>
                                <p class="font-serif text-[18px] text-[#E2E8F0] leading-snug italic">&ldquo;@c.RawNote&rdquo;</p>
                            </div>
                            
                            <span class="text-[11px] text-secondary font-body-md flex items-center gap-2">
                                <span class="material-symbols-outlined text-[14px]">edit_note</span>
                                @(string.IsNullOrWhiteSpace(c.Source) ? "Manual entry" : c.Source) 
                                <span class="text-secondary/50">· @c.CapturedAt.ToString("MMM d", En)</span>
                            </span>
                        </div>

                        <!-- Пошук для розпізнавання -->
                        <div class="relative mt-auto pt-4 border-t border-secondary/20">
                            <input type="text"
                                   placeholder="Search title to link..."
                                   value="@GetSearchQuery(c)"
                                   @oninput="e => UpdateSearchQuery(c, e.Value?.ToString())"
                                   class="w-full bg-secondary/10 border border-secondary/30 rounded-xl px-4 py-2.5 text-[#E2E8F0] outline-none focus:border-[#C9C0F4] focus:bg-background transition-all text-[13px] placeholder:text-secondary/60" />
                            
                            @if (IsSearching(c))
                            {
                                var matches = GetMatches(c).ToList();
                                <div class="absolute left-0 right-0 top-full mt-2 bg-surface-container border border-secondary/40 rounded-2xl shadow-2xl max-h-72 overflow-y-auto flex flex-col z-[999] backdrop-blur-xl">
                                    @if (matches.Count == 0)
                                    {
                                        <div class="px-4 py-4 text-[13px] text-secondary text-center italic">No films or series found matching "@GetSearchQuery(c)".</div>
                                    }
                                    else
                                    {
                                        @foreach (var m in matches)
                                        {
                                            <button @onclick="() => SelectAndLink(c, m)"
                                                    class="text-left px-4 py-3 text-[13px] text-[#E2E8F0] hover:bg-secondary/20 hover:text-primary transition-colors border-b border-secondary/10 last:border-b-0 flex items-center gap-3 group/item">
                                                @if (!string.IsNullOrEmpty(m.PosterUrl))
                                                {
                                                    <div class="w-10 h-14 rounded-lg bg-cover bg-center shrink-0 border border-secondary/30 shadow-sm" style="@UiHelpers.CardBackground(m.PosterUrl)"></div>
                                                }
                                                else
                                                {
                                                    <div class="w-10 h-14 rounded-lg bg-secondary/20 flex items-center justify-center shrink-0 text-secondary">
                                                        <span class="material-symbols-outlined text-[18px]">movie</span>
                                                    </div>
                                                }
                                                <div class="flex flex-col truncate">
                                                    <span class="truncate font-bold group-hover/item:text-primary">@m.Title</span>
                                                    <span class="text-secondary text-[11px]">@m.ReleaseYear · @(m is Series ? "Series" : "Movie")</span>
                                                </div>
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <!-- РОЗПІЗНАНІ / КАТАЛОГ -->
    @if (named.Count > 0)
    {
        <section class="flex flex-col gap-6 mt-4">
            <div class="flex items-center gap-4">
                <h2 class="font-serif text-[24px] text-white">The Catalog</h2>
                <span class="bg-primary/20 text-primary px-2 py-0.5 rounded text-[12px] font-bold">@named.Count</span>
                <div class="flex-1 h-px bg-secondary/20"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var c in named)
                {
                    <article class="flex flex-col justify-between rounded-xl bg-secondary/10 border border-secondary/20 overflow-hidden hover:bg-secondary/15 hover:border-secondary/40 transition-all duration-300 shadow-xl group">
                        
                        @if (c.Kind == CaptureKind.Scene && !string.IsNullOrEmpty(c.ResolvedMedia?.PosterUrl))
                        {
                            <div class="relative h-48 w-full bg-surface-container-lowest overflow-hidden">
                                <div class="absolute inset-0 bg-cover bg-center opacity-80 group-hover:scale-105 transition-transform duration-700 blur-sm scale-110" style="@UiHelpers.CardBackground(c.ResolvedMedia.PosterUrl)"></div>
                                <div class="absolute inset-0 bg-cover bg-center opacity-90 group-hover:scale-105 transition-transform duration-700 shadow-inner border-b border-secondary/30" style="@UiHelpers.CardBackground(c.ResolvedMedia.PosterUrl)"></div>
                                <div class="absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent"></div>
                                
                                <span class="absolute top-4 left-4 bg-primary/20 backdrop-blur-md text-primary font-label-caps text-[10px] px-2.5 py-1 rounded-full uppercase tracking-widest font-bold border border-primary/20">
                                    @c.Kind
                                </span>
                                @if (!string.IsNullOrEmpty(c.Timecode))
                                {
                                    <span class="absolute bottom-3 right-4 font-label-caps text-[10px] text-[#E2E8F0] bg-background/80 px-2 py-1 rounded backdrop-blur-md">
                                        @c.Timecode
                                    </span>
                                }
                            </div>
                        }

                        <div class="p-6 flex flex-col gap-4 h-full">
                            
                            @if (c.Kind != CaptureKind.Scene || string.IsNullOrEmpty(c.ResolvedMedia?.PosterUrl))
                            {
                                <div class="flex items-center justify-between">
                                    <span class="bg-primary/15 text-primary font-label-caps text-[10px] px-2.5 py-1 rounded-full uppercase tracking-widest font-bold border border-primary/10">
                                        @c.Kind
                                    </span>
                                    @if (!string.IsNullOrEmpty(c.Timecode))
                                    {
                                        <div class="flex items-center gap-1 text-secondary font-label-caps text-[10px]">
                                            <span class="material-symbols-outlined text-[14px]">timer</span>
                                            <span>@c.Timecode</span>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="flex items-baseline justify-between gap-2 border-b border-secondary/20 pb-3">
                                <h3 class="font-title-md text-[17px] text-[#E2E8F0] group-hover:text-primary transition-colors font-bold truncate">@c.ResolvedMedia?.Title</h3>
                                <span class="font-label-sm text-[11px] text-secondary shrink-0">@c.ResolvedMedia?.ReleaseYear</span>
                            </div>

                            <div class="relative pl-4 my-2">
                                <div class="absolute left-0 top-0 bottom-0 w-[3px] rounded-full bg-gradient-to-b from-primary to-secondary"></div>
                                <p class="font-serif text-[18px] text-[#E2E8F0]/90 leading-snug italic">&ldquo;@c.RawNote&rdquo;</p>
                            </div>

                            @if (!string.IsNullOrEmpty(c.Annotation))
                            {
                                <p class="font-body-md text-[13px] text-secondary leading-relaxed mt-2 bg-background/50 p-3 rounded-xl border border-secondary/20">
                                    @c.Annotation
                                </p>
                            }

                            <div class="mt-auto pt-4 flex flex-wrap gap-2 items-center justify-between">
                                @if (Me.Watchlists.Count == 0)
                                {
                                    <span class="text-[12px] text-secondary">Create a list first.</span>
                                }
                                else
                                {
                                    <div class="flex items-center gap-2 w-full">
                                        <select @onchange="e => PickList(c, e.Value?.ToString())"
                                                class="flex-1 min-w-0 bg-background border border-secondary/30 rounded-xl px-3 py-2 text-[#E2E8F0] outline-none focus:border-primary text-[12px]">
                                            @foreach (var list in Me.Watchlists)
                                            {
                                                <option value="@list.Name">@list.Name</option>
                                            }
                                        </select>
                                        <button @onclick="() => AddToList(c)"
                                                class="px-4 py-2 rounded-xl bg-primary/10 text-primary border border-primary/20 font-bold text-[12px] hover:bg-primary hover:text-background transition-all whitespace-nowrap">
                                            + Add
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

</div>

@code {
    private string newCaptureText = "";
    private string customSource = "";
    private string newTimecode = "";
    private CaptureKind selectedKind = CaptureKind.Thought;
    private static readonly CultureInfo En = new CultureInfo("en-US");
    private readonly Dictionary<CaptureEntry, string> searchQueries = new();
    private readonly Dictionary<CaptureEntry, string> pickedLists = new();

    private User Me => DataService.CurrentUser;

    private void OnCaptureKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddCapture();
    }

    private void AddCapture()
    {
        if (string.IsNullOrWhiteSpace(newCaptureText)) return;

        string source = string.IsNullOrWhiteSpace(customSource) ? "Manual" : customSource.Trim();
        
        Me.AddCapture(newCaptureText.Trim(), source, selectedKind, newTimecode);

        newCaptureText = customSource = newTimecode = "";
        selectedKind = CaptureKind.Thought;
    }

    private string GetSearchQuery(CaptureEntry c) => searchQueries.TryGetValue(c, out var q) ? q : "";
    private void UpdateSearchQuery(CaptureEntry c, string? query) => searchQueries[c] = query ?? "";
    private bool IsSearching(CaptureEntry c) => !string.IsNullOrWhiteSpace(GetSearchQuery(c));

private IEnumerable<Media> GetMatches(CaptureEntry c)
{
    string q = GetSearchQuery(c)?.Trim() ?? "";
    if (string.IsNullOrWhiteSpace(q)) return Enumerable.Empty<Media>();

    return DataService.SearchLibrary(q) ?? Enumerable.Empty<Media>();
}

    private void SelectAndLink(CaptureEntry c, Media m)
    {
        searchQueries[c] = "";
        c.Resolve(m);
        Snackbar.Add($"Recognized as \"{m.Title}\"", Severity.Success);
    }

    private void PickList(CaptureEntry c, string? listName) => pickedLists[c] = listName ?? "";

    private void AddToList(CaptureEntry c)
    {
        pickedLists.TryGetValue(c, out string? listName);
        if (string.IsNullOrEmpty(listName)) listName = Me.Watchlists.FirstOrDefault()?.Name;

        if (listName != null && Me.MoveResolvedCaptureToWatchlist(c, listName))
            Snackbar.Add($"Added to \"{listName}\"", Severity.Success);
    }
}