private int CurrentMaxDurationMinutes
{
    get
    {
        if (MediaItem is Movie movie)
            return movie.TotalDurationMinutes;

        if (MediaItem is Series series)
        {
            var season = series.Seasons.FirstOrDefault(s => s.Number == inputSeason);
            var ep = season?.Episodes.FirstOrDefault(e => e.Number == inputEpisode);
            if (ep != null && ep.RuntimeMinutes > 0)
                return ep.RuntimeMinutes;
        }

        return 0;
    }
}

private static string FormatMinutesAsTimecode(int totalMinutes)
{
    int hours = totalMinutes / 60;
    int mins = totalMinutes % 60;
    return hours > 0 ? $"{hours:D2}:{mins:D2}:00" : $"{mins:D2}:00";
}

private void CloseCheckpointModal()
