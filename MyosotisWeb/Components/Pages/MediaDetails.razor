    checkpointError = null;
    showCheckpointModal = false;
}

private bool TryParseTimecodeSeconds(string tc, out int totalSeconds, out string error)
{
    totalSeconds = 0;
    error = "";

    var parts = tc.Split(':');
    if (parts.Length is < 2 or > 3)
    {
        error = "Enter timecode as MM:SS or HH:MM:SS.";
        return false;
    }

    if (parts.Length == 2)
    {
        if (!int.TryParse(parts[0], out int mins) || !int.TryParse(parts[1], out int secs) || secs >= 60 || mins < 0 || secs < 0)
        {
            error = "Invalid timecode. Seconds must be between 00 and 59.";
            return false;
        }
        totalSeconds = mins * 60 + secs;
        return true;
    }
    else
    {
        if (!int.TryParse(parts[0], out int hours) || !int.TryParse(parts[1], out int mins) || !int.TryParse(parts[2], out int secs)
            || hours < 0 || mins < 0 || mins >= 60 || secs < 0 || secs >= 60)
        {
            error = "Invalid timecode. Minutes and seconds must be between 00 and 59.";
            return false;
        }
        totalSeconds = hours * 3600 + mins * 60 + secs;
        return true;
    }
}

private async Task SaveCheckpoint()
{
    checkpointError = null;
    if (MediaItem == null) return;

    if (string.IsNullOrWhiteSpace(inputTimecode))
    {
        checkpointError = "Please enter a timecode.";
        return;
    }

    if (!TryParseTimecodeSeconds(inputTimecode.Trim(), out int enteredSeconds, out string parseError))
    {
        checkpointError = parseError;
        return;
    }

    if (MediaItem is Series series)
    {
        var validSeasons = series.Seasons.Where(s => s.Number > 0 && s.Number < 100).ToList();
        var seasonObj = validSeasons.FirstOrDefault(s => s.Number == inputSeason);

        if (validSeasons.Count > 0 && seasonObj == null)
        {
            checkpointError = $"Season {inputSeason} does not exist.";
            return;
        }

        if (seasonObj != null && seasonObj.Episodes.Count > 0 && !seasonObj.Episodes.Any(e => e.Number == inputEpisode))
        {
            checkpointError = $"Episode {inputEpisode} does not exist in Season {inputSeason}.";
            return;
        }
    }

    int maxMinutes = CurrentMaxDurationMinutes;
    if (maxMinutes > 0 && enteredSeconds > maxMinutes * 60)
    {
        checkpointError = $"Timecode exceeds total duration ({FormatMinutesAsTimecode(maxMinutes)} / {maxMinutes} mins).";
        return;
    }

    WatchCheckpoint cp;
    if (MediaItem is Series sItem)
    {
        cp = new WatchCheckpoint(sItem, inputSeason, inputEpisode, inputTimecode.Trim(), inputReason);
    }
    else if (MediaItem is Movie movie)
    {
        cp = new WatchCheckpoint(movie, inputTimecode.Trim(), inputReason);
    }
    else return;

    Me.SetCheckpoint(cp);
    showCheckpointModal = false;
    await DataService.SaveStateAsync();
}

