@page "/media/{Id:guid}"
@inject TmdbApiService TmdbService
@using System.Globalization
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService

<PageTitle>Myosotis · @(MediaItem?.Title ?? "Media Details")</PageTitle>

@if (MediaItem == null)
{
    <div class="max-w-7xl mx-auto px-margin py-20 text-center text-secondary">
        <span class="material-symbols-outlined text-[48px] mb-2">find_in_page</span>
        <p class="font-headline-md">Media item not found in the sanctuary archive.</p>
    </div>
}
else
{
    <div class="flex flex-col w-full">
        <!-- HEADER BACKGROUND & MAIN METADATA -->
        <div class="relative w-full -mt-16 pt-16 bg-surface-container-lowest overflow-hidden">
            @if (!string.IsNullOrEmpty(MediaItem.PosterUrl))
            {
                <div class="absolute inset-0 bg-cover bg-center opacity-25 mix-blend-luminosity scale-105 filter blur-sm"
                     style="background-image: url('@MediaItem.PosterUrl')"></div>
            }
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/80 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/60 to-transparent"></div>

            <div class="relative max-w-7xl mx-auto px-margin pt-10 pb-12 flex flex-col md:flex-row gap-10 items-start">

                <!-- Poster Column -->
                <div class="w-full md:w-72 shrink-0 flex flex-col gap-3 group">
                    <div class="relative rounded-2xl overflow-hidden shadow-2xl bg-surface-container-high transition-transform duration-500 group-hover:-translate-y-1 border border-secondary/20">
                        <div class="aspect-[2/3] w-full relative">
                            @if (!string.IsNullOrEmpty(MediaItem.PosterUrl))
                            {
                                <img src="@MediaItem.PosterUrl" alt="@MediaItem.Title" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center bg-surface-container-highest text-secondary">
                                    <span class="material-symbols-outlined text-[48px]">movie</span>
                                </div>
                            }
                            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent"></div>
                            <div class="absolute top-3 left-3 bg-background/80 backdrop-blur-md px-3 py-1 rounded-full border border-secondary/20">
                                <span class="font-label-caps text-[10px] text-primary tracking-widest uppercase">ID: #@MediaItem.Id.ToString().Substring(0, 8)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Details ->
                <div class="flex-1 min-w-0 flex flex-col gap-5">

                    <!-- Navigation -->
                    <nav class="flex items-center gap-2 text-secondary font-label-sm text-[13px]">
                        <a href="/watchlists" class="hover:text-primary transition-colors">Watchlists</a>
                        <span class="material-symbols-outlined text-[14px] opacity-40">chevron_right</span>
                        <span class="text-primary font-medium">@MediaItem.Title</span>
                    </nav>

                    <!-- Title -->
                    <div class="flex flex-col gap-2.5">
                        <div class="flex flex-wrap items-baseline gap-3">
                            <div class="flex items-center gap-3">
                                <h1 class="font-headline-xl text-[36px] md:text-[36px] text-white font-serif font-bold tracking-tight drop-shadow-md">
                                    @MediaItem.Title
                                </h1>

                                <button @onclick="ToggleFavorite"
                                        class="flex items-center justify-center p-2 rounded-full transition-all duration-300 @(IsFav ? "text-tertiary bg-tertiary/10" : "text-secondary hover:text-tertiary hover:bg-surface-variant")"
                                        title="@(IsFav ? "Remove from Favorites" : "Add to Favorites")">
                                    <span class="material-symbols-outlined text-[28px] transition-all"
                                          style="font-variation-settings: 'FILL' @(IsFav ? "1" : "0");">
                                        favorite
                                    </span>
                                </button>
                            </div>
                            <span class="font-headline-md text-[24px] text-secondary/70 font-serif">(@MediaItem.ReleaseYear)</span>
                        </div>

                        <div class="flex flex-wrap items-center gap-3 text-secondary text-[13px]">
                            <span class="px-2.5 py-0.5 rounded-md bg-primary/15 text-primary font-label-caps text-[11px] border border-primary/30 uppercase tracking-wider backdrop-blur-sm">
                                @(MediaItem is Series ? "TV Series" : "Film")
                            </span>

                            @if (MediaItem is Series series)
                            {
                                <span class="font-body-md text-white/90">@series.TotalSeasons Seasons • @series.Seasons.Sum(s => s.Episodes.Count) Episodes</span>
                            }
                            else if (MediaItem is Movie movie)
                            {
                                <span class="font-body-md text-white/90">@movie.TotalDurationMinutes mins</span>
                            }

                            @if (MediaItem.TmdbRating.HasValue)
                            {
                                <span class="opacity-40">·</span>
                                <div class="flex items-center gap-1.5 text-primary font-bold">
                                    <span class="font-label-caps text-[10px] bg-primary/20 border border-primary/30 px-1.5 py-0.5 rounded text-primary">TMDB</span>
                                    <span>★ @MediaItem.TmdbRating.Value.ToString("0.0", En)</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Description -->
                    <p class="font-body-lg text-[15px] text-[#E2E8F0]/90 leading-relaxed max-w-3xl">
                        @(string.IsNullOrWhiteSpace(MediaItem.Description) ? "No editorial logline provided for this entry." : MediaItem.Description)
                    </p>

                    <!-- Action Bar -->
                    <div class="flex flex-wrap items-center gap-3 pt-1">
                        @if (ContainingWatchlist != null)
                        {
                            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary/15 text-primary border border-primary/30 font-title-md text-[13px] backdrop-blur-sm">
                                <span class="material-symbols-outlined text-[18px]">bookmark_added</span>
                                <span>In Watchlist: @ContainingWatchlist.Name</span>
                            </span>
                        }

                        <button @onclick="ToggleWatched" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg @(IsWatched ? "bg-primary text-background font-bold" : "bg-secondary/15 text-secondary border border-secondary/30") font-title-md text-[13px] hover:opacity-90 transition-all">
                            <span class="material-symbols-outlined text-[18px]">check_circle</span>
                            <span>@(IsWatched ? "Watched" : "Mark Watched")</span>
                        </button>
                    </div>

                    <!-- Genres-->
                    @if (MediaItem.Genres != null && MediaItem.Genres.Count > 0)
                    {
                        <div class="flex flex-wrap items-center gap-2 pt-1">
                            @foreach (var genre in MediaItem.Genres)
                            {
                                <span class="px-2.5 py-0.5 rounded-md bg-secondary/15 text-primary font-label-caps text-[11px] border border-primary/30 uppercase tracking-wider backdrop-blur-sm">
                                    @genre
                                </span>
                            }
                        </div>
                    }

                    <div class="flex flex-col gap-4 pt-4 border-t border-secondary/15">
                        <!-- tabs -->
                        <div class="flex items-center gap-6 border-b border-secondary/15 pb-2 text-[12px] font-label-caps tracking-widest uppercase">
                            <button @onclick='() => SetActiveTab("cast")'
                                    class="transition-colors pb-1 relative @(activeTab == "cast" ? "text-primary font-bold" : "text-secondary hover:text-white")">
                                Cast
                                @if (activeTab == "cast")
                                {
                                    <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-primary rounded-full"></span>
                                }
                            </button>

                            <button @onclick='() => SetActiveTab("crew")'
                                    class="transition-colors pb-1 relative @(activeTab == "crew" ? "text-primary font-bold" : "text-secondary hover:text-white")">
                                Crew
                                @if (activeTab == "crew")
                                {
                                    <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-primary rounded-full"></span>
                                }
                            </button>

                            <button @onclick='() => SetActiveTab("details")'
                                    class="transition-colors pb-1 relative @(activeTab == "details" ? "text-primary font-bold" : "text-secondary hover:text-white")">
                                Details
                                @if (activeTab == "details")
                                {
                                    <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-primary rounded-full"></span>
                                }
                            </button>
                        </div>

                        <!-- tabs content -->
                        <div class="min-h-[100px]">
                            @if (activeTab == "cast")
                            {
                                @if (MediaItem.Cast != null && MediaItem.Cast.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var actor in MediaItem.Cast)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-white font-body-md text-[13px] border border-secondary/10 transition-colors">
                                                <span class="font-medium">@actor.FullName</span>
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-secondary/70 text-[13px] italic">No cast information available.</p>
                                }
                            }

                            @if (activeTab == "crew")
                            {
                                <div class="flex flex-col gap-2.5 text-[13px] font-body-md">
                                    <div class="flex items-center gap-4">
                                        <span class="text-secondary/70 font-label-caps text-[11px] tracking-wider uppercase w-24 shrink-0">Director</span>
                                        <span class="px-3 py-1 rounded-lg bg-surface-container-high text-white font-medium border border-secondary/10">
                                            @(MediaItem.MediaDirector?.FullName ?? "Unknown")
                                        </span>
                                    </div>
                                </div>
                            }

                            @if (activeTab == "details")
                            {
                                <div class="flex flex-col gap-3 text-[13px] font-body-md">
                                    <div class="flex items-center gap-4">
                                        <span class="text-secondary/70 font-label-caps text-[11px] tracking-wider uppercase w-24 shrink-0">Studio</span>
                                        <span class="px-3 py-1 rounded-lg bg-surface-container-high text-white font-medium border border-secondary/10">
                                            @(string.IsNullOrEmpty(MediaItem.ProductionStudio) ? "N/A" : MediaItem.ProductionStudio)
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <span class="text-secondary/70 font-label-caps text-[11px] tracking-wider uppercase w-24 shrink-0">Country</span>
                                        <span class="px-3 py-1 rounded-lg bg-surface-container-high text-white font-medium border border-secondary/10">
                                            @(string.IsNullOrEmpty(MediaItem.Country) ? "N/A" : MediaItem.Country)
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <span class="text-secondary/70 font-label-caps text-[11px] tracking-wider uppercase w-24 shrink-0">Status</span>
                                        <span class="px-3 py-1 rounded-lg bg-surface-container-high text-white font-medium border border-secondary/10">
                                            @(string.IsNullOrEmpty(MediaItem.ContentRating) ? "Released" : MediaItem.ContentRating)
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN BODY CONTENT -->
        <div class="max-w-7xl mx-auto w-full px-margin py-8 flex flex-col gap-10">

            <!-- Watch Checkpoint Banner -->
            @if (ActiveCheckpoint != null)
            {
                <div class="relative w-full rounded-xl bg-surface-container-low p-6 overflow-hidden shadow-lg border-l-4 border-primary">
                    <div class="relative flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary shrink-0">
                                <span class="material-symbols-outlined text-[26px]">play_circle</span>
                            </div>
                            <div class="flex flex-col gap-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">Continue Watching — Active Checkpoint</span>
                                    <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                                </div>
                                <h2 class="font-headline-md text-headline-md text-on-surface">
                                    @if (MediaItem is Series && ActiveCheckpoint.Season.HasValue)
                                    {
                                        <span>Season @ActiveCheckpoint.Season · Episode @ActiveCheckpoint.Episode</span>
                                    }
                                    else
                                    {
                                        <span>@MediaItem.Title</span>
                                    }
                                </h2>
                                <div class="flex items-center gap-3 text-on-surface-variant font-label-sm text-label-sm">
                                    <span class="text-on-surface font-semibold">Timecode: @ActiveCheckpoint.Timecode</span>
                                    @if (!string.IsNullOrEmpty(ActiveCheckpoint.Reason))
                                    {
                                        <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
                                        <span class="italic text-secondary">"@ActiveCheckpoint.Reason"</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 min-w-[320px]">
                            <div class="flex-1 flex flex-col gap-1.5">
                                <div class="flex justify-between items-center font-label-caps text-label-caps text-on-surface-variant">
                                    <span>PROGRESS</span>
                                    <span class="text-primary font-semibold">@ActiveCheckpoint.GetProgressPercent()%</span>
                                </div>
                                <div class="w-full h-2 rounded-full bg-surface-container-highest overflow-hidden">
                                    <div class="h-full bg-primary-container rounded-full" style="width: @(ActiveCheckpoint.GetProgressPercent())%;"></div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button @onclick="ClearCheckpoint" class="px-5 py-2.5 rounded-full bg-primary text-background font-title-md hover:opacity-90 transition-colors flex items-center gap-1.5 shadow-sm">
                                    <span class="material-symbols-outlined text-[18px]">play_arrow</span>
                                    <span>Resume (@ActiveCheckpoint.GetProgressPercent()%)</span>
                                </button>
                                <button @onclick="OpenCheckpointModal" class="p-2.5 rounded-lg bg-surface-container-high text-on-surface hover:text-primary transition-colors" title="Update Checkpoint">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Diary & Vibe Rating -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-5">

                <div class="md:col-span-4 rounded-xl bg-surface-container p-6 flex flex-col justify-between shadow-sm border border-secondary/10 hover:border-primary/40 hover:-translate-y-1 transition-all duration-300">
                    <div class="flex flex-col gap-4">
                        <div class="flex items-center justify-between">
                            <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Actions</span>
                            <span class="material-symbols-outlined text-primary text-[20px]">movie_edit</span>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <button @onclick="() => ChangeUserStatus(WatchStatus.Planned)"
                                    class="px-3 py-2 rounded-lg text-[12px] font-title-md transition-all text-left flex items-center justify-between @(CurrentWatchStatus == WatchStatus.Planned ? "bg-primary/20 text-primary border border-primary/40" : "bg-surface-container-high text-secondary hover:text-white")">
                                <span>Planned</span>
                                @if (CurrentWatchStatus == WatchStatus.Planned)
                                {
                                    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                }
                            </button>

                            <button @onclick="() => ChangeUserStatus(WatchStatus.Watching)"
                                    class="px-3 py-2 rounded-lg text-[12px] font-title-md transition-all text-left flex items-center justify-between @(CurrentWatchStatus == WatchStatus.Watching ? "bg-primary/20 text-primary border border-primary/40" : "bg-surface-container-high text-secondary hover:text-white")">
                                <span>Watching</span>
                                @if (CurrentWatchStatus == WatchStatus.Watching)
                                {
                                    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                }
                            </button>

                            <button @onclick="() => ChangeUserStatus(WatchStatus.Watched)"
                                    class="px-3 py-2 rounded-lg text-[12px] font-title-md transition-all text-left flex items-center justify-between @(CurrentWatchStatus == WatchStatus.Watched ? "bg-primary text-background font-bold shadow-sm" : "bg-surface-container-high text-secondary hover:text-white")">
                                <span>Watched</span>
                                @if (CurrentWatchStatus == WatchStatus.Watched)
                                {
                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                }
                            </button>

                            <button @onclick="() => ChangeUserStatus(WatchStatus.Paused)"
                                    class="px-3 py-2 rounded-lg text-[12px] font-title-md transition-all text-left flex items-center justify-between @(CurrentWatchStatus == WatchStatus.Paused ? "bg-secondary/20 text-secondary border border-secondary/40" : "bg-surface-container-high text-secondary hover:text-white")">
                                <span>Paused</span>
                                @if (CurrentWatchStatus == WatchStatus.Paused)
                                {
                                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                }
                            </button>

                            <button @onclick="() => ChangeUserStatus(WatchStatus.Dropped)"
                                    class="px-3 py-2 rounded-lg text-[12px] font-title-md transition-all text-left flex items-center justify-between @(CurrentWatchStatus == WatchStatus.Dropped ? "bg-tertiary/20 text-tertiary border border-tertiary/40" : "bg-surface-container-high text-secondary hover:text-white")">
                                <span>Dropped</span>
                                @if (CurrentWatchStatus == WatchStatus.Dropped)
                                {
                                    <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                                }
                            </button>

                            <button @onclick="() => ChangeUserStatus(WatchStatus.Rewatching)"
                                    class="px-3 py-2 rounded-lg text-[12px] font-title-md transition-all text-left flex items-center justify-between @(CurrentWatchStatus == WatchStatus.Rewatching ? "bg-primary/20 text-primary border border-primary/40" : "bg-surface-container-high text-secondary hover:text-white")">
                                <span>Rewatch</span>
                                @if (CurrentWatchStatus == WatchStatus.Rewatching)
                                {
                                    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                }
                            </button>

                            @if (CurrentMediaState != null)
                            {
                                <button @onclick="ClearUserStatus"
                                        class="col-span-2 mt-2 px-3 py-2 rounded-lg text-[12px] font-title-md transition-all text-center flex items-center justify-center gap-2 bg-surface-variant text-tertiary hover:bg-secondary/20 border border-tertiary/30">
                                    <span class="material-symbols-outlined text-[16px]">delete_outline</span>
                                    <span>Remove Status & History</span>
                                </button>
                            }
                        </div>
                    </div>


                <div class="pt-5 mt-4 border-t border-secondary/20 flex flex-col gap-3">
                    <button @onclick="OpenCheckpointModal"
                            class="w-full flex items-center justify-between px-3.5 py-3 rounded-xl bg-background hover:bg-surface-variant border border-secondary/30 hover:border-primary text-on-surface font-title-md text-[13px] transition-all group">

                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-[18px] text-primary">
                                pause_circle
                            </span>

                            <span>
                                @(ActiveCheckpoint != null ? "Update Checkpoint" : "Set Checkpoint")
                            </span>
                        </div>

                        @if (ActiveCheckpoint != null)
                        {
                            <span class="text-[11px] font-label-caps text-secondary group-hover:text-primary transition-colors">
                                @ActiveCheckpoint.Timecode
                            </span>
                        }
                    </button>
                </div>

                </div>

                <div class="md:col-span-4 rounded-xl bg-surface-container p-6 flex flex-col justify-between shadow-sm border border-secondary/10 hover:border-primary/40 hover:-translate-y-1 transition-all duration-300">
                    <div class="flex items-center justify-between mb-4">
                        <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">MY RATING</span>
                        <div class="flex items-baseline gap-1">
                            <span class="font-serif text-3xl md:text-4xl text-primary font-normal">
                                @CurrentVibeAverage.ToString("0.0", En)
                            </span>
                            <span class="font-label-sm text-label-sm text-on-surface-variant">/10</span>
                        </div>
                    </div>

                    <div class="flex flex-col gap-3">
                        <div class="flex flex-col gap-1">
                            <div class="flex justify-between font-label-sm text-label-sm">
                                <span class="text-on-surface font-medium">Characters</span>
                                <span class="text-on-surface font-bold">@vibeCharacters / 10</span>
                            </div>
                            <input type="range" min="1" max="10" @bind="vibeCharacters" @bind:event="oninput" @bind:after="SaveVibeRating"
                                   style="background: linear-gradient(90deg, #84DCC6 @(vibeCharacters * 10)%, rgba(92, 128, 188, 0.2) @(vibeCharacters * 10)%);"
                                   class="w-full h-2 rounded-lg appearance-none cursor-pointer accent-primary" />
                        </div>

                        <div class="flex flex-col gap-1">
                            <div class="flex justify-between font-label-sm text-label-sm">
                                <span class="text-on-surface font-medium">Plot</span>
                                <span class="text-on-surface font-bold">@vibePlot / 10</span>
                            </div>
                            <input type="range" min="1" max="10" @bind="vibePlot" @bind:event="oninput" @bind:after="SaveVibeRating"
                                   style="background: linear-gradient(90deg, #84DCC6 @(vibePlot * 10)%, rgba(92, 128, 188, 0.2) @(vibePlot * 10)%);"
                                   class="w-full h-2 rounded-lg appearance-none cursor-pointer accent-primary" />
                        </div>

                        <div class="flex flex-col gap-1">
                            <div class="flex justify-between font-label-sm text-label-sm">
                                <span class="text-on-surface font-medium">Visuals</span>
                                <span class="text-on-surface font-bold">@vibeVisuals / 10</span>
                            </div>
                            <input type="range" min="1" max="10" @bind="vibeVisuals" @bind:event="oninput" @bind:after="SaveVibeRating"
                                   style="background: linear-gradient(90deg, #84DCC6 @(vibeVisuals * 10)%, rgba(92, 128, 188, 0.2) @(vibeVisuals * 10)%);"
                                   class="w-full h-2 rounded-lg appearance-none cursor-pointer accent-primary" />
                        </div>

                        <div class="flex flex-col gap-1">
                            <div class="flex justify-between font-label-sm text-label-sm">
                                <span class="text-on-surface font-medium">Pacing</span>
                                <span class="text-on-surface font-bold">@vibePacing / 10</span>
                            </div>
                            <input type="range" min="1" max="10" @bind="vibePacing" @bind:event="oninput" @bind:after="SaveVibeRating"
                                   style="background: linear-gradient(90deg, #5C80BC @(vibePacing * 10)%, rgba(92, 128, 188, 0.2) @(vibePacing * 10)%);"
                                   class="w-full h-2 rounded-lg appearance-none cursor-pointer accent-secondary" />
                        </div>

                        <div class="flex flex-col gap-1">
                            <div class="flex justify-between font-label-sm text-label-sm">
                                <span class="text-on-surface font-medium">Vibe</span>
                                <span class="text-on-surface font-bold">@vibeVibe / 10</span>
                            </div>
                            <input type="range" min="1" max="10" @bind="vibeVibe" @bind:event="oninput" @bind:after="SaveVibeRating"
                                   style="background: linear-gradient(90deg, #5C80BC @(vibeVibe * 10)%, rgba(92, 128, 188, 0.2) @(vibeVibe * 10)%);"
                                   class="w-full h-2 rounded-lg appearance-none cursor-pointer accent-secondary" />
                        </div>

                        <div class="flex flex-col gap-1">
                            <div class="flex justify-between font-label-sm text-label-sm">
                                <span class="text-on-surface font-medium">Soundtrack</span>
                                <span class="text-on-surface font-bold">@vibeSoundtrack / 10</span>
                            </div>
                            <input type="range" min="1" max="10" @bind="vibeSoundtrack" @bind:event="oninput" @bind:after="SaveVibeRating"
                                   style="background: linear-gradient(90deg, #5C80BC @(vibeSoundtrack * 10)%, rgba(92, 128, 188, 0.2) @(vibeSoundtrack * 10)%);"
                                   class="w-full h-2 rounded-lg appearance-none cursor-pointer accent-secondary" />
                        </div>
                    </div>
                  </div>

                <div class="md:col-span-4 rounded-xl bg-surface-container p-6 flex flex-col justify-between shadow-sm border border-secondary/10 hover:border-primary/40 hover:-translate-y-1 transition-all duration-300">
                    <div class="flex flex-col gap-3">
                        <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Watchlists</span>
                        <div class="flex flex-col gap-2">
                            @foreach (var list in Me.Watchlists)
                            {
                                bool inList = list.Entries.Any(entry => entry.Item.Id == MediaItem.Id);

                                <div class="flex items-center justify-between p-3 rounded-lg bg-surface-container-high">
                                    <span class="font-title-md text-title-md text-on-surface">@list.Name</span>
                                    @if (inList)
                                    {
                                        <span class="material-symbols-outlined text-primary text-[18px]">check_circle</span>
                                    }
                                    else
                                    {
                                        <button @onclick="() => AddToList(list)" class="text-label-sm text-secondary hover:text-primary transition-colors">+ Add</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

                <!-- Seasons for Series -->
                @if (MediaItem is Series currentSeries && currentSeries.Seasons.Count > 0)
                {
                    <div class="flex flex-col gap-4 mt-6">
                        <div class="flex flex-col gap-3 border-b border-secondary/20 pb-4">
                            <span class="font-headline-lg text-[22px] text-on-surface font-serif">Seasons & Episodes</span>
            
                            <div class="flex items-center gap-2 overflow-x-auto pb-2 custom-scrollbar">
                                @for (int i = 0; i < currentSeries.Seasons.Count; i++)
                                {
                                    int seasonIdx = i;
                                    var season = currentSeries.Seasons[i];
                                    <button @onclick="() => activeSeasonIndex = seasonIdx"
                                            class="px-4 py-2 rounded-xl font-title-md text-[13px] whitespace-nowrap transition-all border @(activeSeasonIndex == seasonIdx ? "bg-primary text-background font-bold border-primary shadow-md" : "bg-surface-container-high text-secondary border-secondary/20 hover:text-white hover:border-secondary/40")">
                                        Season @season.Number <span class="opacity-75 text-[11px]">(@season.Episodes.Count Ep)</span>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (activeSeasonIndex < currentSeries.Seasons.Count)
                        {
                            var selectedSeason = currentSeries.Seasons[activeSeasonIndex];

                            <div class="flex flex-col gap-2.5 max-h-[480px] overflow-y-auto pr-2 custom-scrollbar">
                                @foreach (var ep in selectedSeason.Episodes)
                                {
                                    bool isCheckpointEp = ActiveCheckpoint != null && ActiveCheckpoint.Season == selectedSeason.Number && ActiveCheckpoint.Episode == ep.Number;

                                    <div class="flex flex-col md:flex-row md:items-center justify-between p-3.5 rounded-xl transition-colors gap-4 shrink-0 @(isCheckpointEp ? "bg-surface-container-high border-l-4 border-primary" : "bg-surface-container/60 hover:bg-surface-container border border-secondary/10")">
                                        <div class="flex items-center gap-4 min-w-0">
                                            <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 @(isCheckpointEp ? "bg-primary text-background" : "bg-surface-container-high text-primary border border-secondary/20")">
                                                <span class="material-symbols-outlined text-[18px]">@(isCheckpointEp ? "pause" : "play_arrow")</span>
                                            </div>
                                            <div class="flex flex-col min-w-0">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-label-caps text-[11px] uppercase @(isCheckpointEp ? "text-primary font-bold" : "text-secondary")">
                                                        EPISODE @ep.Number.ToString("D2") @(isCheckpointEp ? "— Active Checkpoint" : "")
                                                    </span>
                                                    <span class="w-1 h-1 rounded-full bg-secondary/40"></span>
                                                    <span class="font-label-sm text-[12px] text-secondary">@ep.RuntimeMinutes mins</span>
                                                    @if (ep.AirDate.HasValue)
                                                    {
                                                        <span class="w-1 h-1 rounded-full bg-secondary/40"></span>
                                                        <span class="font-label-sm text-[12px] text-secondary">@ep.AirDate.Value.ToString("dd.MM.yyyy")</span>
                                                    }
                                                </div>
                                                <span class="font-title-md text-[15px] text-on-surface truncate">@ep.Title</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }       
            <!-- Soundtracks -->
            @if (MediaItem.Soundtracks != null && MediaItem.Soundtracks.Count > 0)
            {
                <div class="flex flex-col gap-4 bg-surface-container p-6 rounded-xl shadow-sm">
                    <div class="flex items-center justify-between">
                        <div>
                            <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">Auditory Palette</span>
                            <h3 class="font-headline-md text-headline-md text-on-surface">Curated Soundtrack</h3>
                        </div>
                        <span class="material-symbols-outlined text-primary text-[20px]">music_note</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 my-2">
                        @foreach (var song in MediaItem.Soundtracks)
                        {
                            <div class="flex items-center justify-between p-3 rounded-lg bg-surface-container-high hover:bg-surface-container-highest transition-colors">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-surface-container flex items-center justify-center text-primary">
                                        <span class="material-symbols-outlined text-[16px]">play_arrow</span>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-title-md text-title-md text-on-surface">@song.Title</span>
                                        <span class="font-label-sm text-label-sm text-on-surface-variant">@song.Artist</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(song.SpotifyUrl))
                                {
                                    <a href="@song.SpotifyUrl" target="_blank" class="text-on-surface-variant hover:text-primary">
                                        <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- TMDB Reviews -->
            <div class="flex flex-col gap-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="font-headline-lg text-headline-lg text-on-surface">TMDB Reviews</span>
                        <span class="font-label-caps text-label-caps px-2.5 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant">
                            @MediaItem.TmdbReviews.Count REVIEWS
                        </span>
                    </div>

                    @if (MediaItem.TmdbReviews.Count > 2)
                    {
                        <div class="flex items-center gap-3 text-secondary">
                            <button @onclick="PrevReviewPage" class="p-1 rounded-lg hover:text-primary hover:bg-secondary/10 transition-all flex items-center justify-center">
                                <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                            </button>
                            <span class="text-[13px] font-body-md select-none">
                                @(reviewPageIndex + 1) / @(Math.Ceiling(MediaItem.TmdbReviews.Count / 2.0))
                            </span>
                            <button @onclick="NextReviewPage" class="p-1 rounded-lg hover:text-primary hover:bg-secondary/10 transition-all flex items-center justify-center">
                                <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                            </button>
                        </div>
                    }
                </div>

                @if (MediaItem.TmdbReviews != null && MediaItem.TmdbReviews.Count > 0)
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        @foreach (var rev in VisibleTmdbReviews)
                        {
                            bool isExpanded = expandedReviews.Contains(rev);

                            <div class="group rounded-2xl bg-surface-container/50 hover:bg-surface-container p-6 flex flex-col justify-between shadow-sm border border-secondary/20 hover:border-primary/40 transition-all duration-300">
                                <div class="flex flex-col gap-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-primary/15 text-primary border border-primary/30 flex items-center justify-center font-bold text-xs uppercase shrink-0">
                                            @(string.IsNullOrEmpty(rev.Author) ? "U" : rev.Author[0].ToString())
                                        </div>
                                        <span class="font-title-md text-title-md text-on-surface font-semibold truncate">
                                            @rev.Author
                                        </span>
                                    </div>

                                    <div class="text-on-surface-variant/90 font-body-md text-[14px] leading-relaxed">
                                        <div class="transition-all duration-300 @(isExpanded ? "max-h-[350px] overflow-y-auto pr-2" : "line-clamp-5")">
                                            @rev.Content
                                        </div>

                                        @if (rev.Content.Length > 280)
                                        {
                                            <button @onclick="() => ToggleExpandReview(rev)" class="text-primary hover:text-primary/80 text-[13px] font-semibold mt-3 flex items-center gap-1 transition-all">
                                                <span>@(isExpanded ? "Show less" : "Read full review")</span>
                                                <span class="material-symbols-outlined text-[16px] @(isExpanded ? "rotate-180" : "")">expand_more</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Similar Titles -->
            @if (SimilarTitles.Count > 0)
            {
                <div class="flex flex-col gap-4 pb-12">
                    <span class="font-headline-lg text-headline-lg text-on-surface">Similar Titles</span>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        @foreach (var sim in SimilarTitles)
                        {
                            <a href="/media/@sim.Id" class="rounded-xl bg-surface-container overflow-hidden group hover:bg-surface-container-high transition-all">
                                <div class="aspect-[16/10] w-full overflow-hidden relative bg-surface-container-highest">
                                    @if (!string.IsNullOrEmpty(sim.PosterUrl))
                                    {
                                        <img src="@sim.PosterUrl" alt="@sim.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                    }
                                </div>
                                <div class="p-3 flex flex-col gap-1">
                                    <span class="font-title-md text-title-md text-on-surface group-hover:text-primary transition-colors truncate">@sim.Title</span>
                                    <span class="font-label-sm text-label-sm text-on-surface-variant">@sim.ReleaseYear</span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

        </div>
    </div>
}

@if (showCheckpointModal)
{
    <div class="fixed inset-0 bg-background/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-surface-container border border-secondary/20 rounded-2xl p-6 w-full max-w-md shadow-2xl flex flex-col gap-5">
            <div class="flex items-center justify-between border-b border-secondary/20 pb-3">
                <h3 class="font-headline-md text-headline-md text-white font-serif">Set Watch Checkpoint</h3>
                <button @onclick="() => showCheckpointModal = false" class="text-secondary hover:text-white">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <div class="flex flex-col gap-4">
                @if (MediaItem is Series)
                {
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="font-label-sm text-secondary mb-1 block">Season</label>
                            <input type="number" min="1" @bind="inputSeason" class="w-full bg-surface-container-high text-white p-2.5 rounded-lg border border-secondary/30 focus:outline-none focus:border-primary" />
                        </div>
                        <div>
                            <label class="font-label-sm text-secondary mb-1 block">Episode</label>
                            <input type="number" min="1" @bind="inputEpisode" class="w-full bg-surface-container-high text-white p-2.5 rounded-lg border border-secondary/30 focus:outline-none focus:border-primary" />
                        </div>
                    </div>
                }

                <div>
                    <label class="font-label-sm text-secondary mb-1 block">Timecode (e.g. 32:14)</label>
                    <input type="text" placeholder="32:14" @bind="inputTimecode" class="w-full bg-surface-container-high text-white placeholder:text-secondary/50 p-2.5 rounded-lg border border-secondary/30 focus:outline-none focus:border-primary" />
                </div>

                <div>
                    <label class="font-label-sm text-secondary mb-1 block">Reason / Note (optional)</label>
                    <input type="text" placeholder="Late night session..." @bind="inputReason" class="w-full bg-surface-container-high text-white placeholder:text-secondary/50 p-2.5 rounded-lg border border-secondary/30 focus:outline-none focus:border-primary" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button @onclick="() => showCheckpointModal = false" class="px-4 py-2 rounded-lg bg-secondary/15 border border-secondary/30 text-secondary font-title-md hover:bg-secondary/25 transition-colors">Cancel</button>
                <button @onclick="SaveCheckpoint" class="px-5 py-2 rounded-lg bg-primary text-background font-bold font-title-md hover:opacity-90 transition-colors">Save</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private static readonly CultureInfo En = new CultureInfo("en-US");

    private Media? MediaItem { get; set; }
    private User Me => DataService.CurrentUser;

    private Watchlist? ContainingWatchlist
    {
        get
        {
            if (MediaItem == null) return null;
            foreach (var w in Me.Watchlists)
            {
                foreach (var e in w.Entries)
                {
                    if (e.Item.Id == MediaItem.Id) return w;
                }
            }
            return null;
        }
    }

    private WatchCheckpoint? ActiveCheckpoint => MediaItem != null ? Me.GetActiveCheckpoint(MediaItem) : null;
    private bool IsWatched => MediaItem != null && Me.IsWatched(MediaItem);

    private List<Media> SimilarTitles = new();
    private int activeSeasonIndex = 0;
    private int reviewPageIndex = 0;
    private HashSet<TmdbReview> expandedReviews = new();

    private int vibeCharacters = 8;
    private int vibePlot = 8;
    private int vibeVisuals = 8;
    private int vibePacing = 8;
    private int vibeVibe = 8;
    private int vibeSoundtrack = 8;

    private double CurrentVibeAverage => (vibeCharacters + vibePlot + vibeVisuals + vibePacing + vibeVibe + vibeSoundtrack) / 6.0;

    private bool showCheckpointModal = false;
    private string inputTimecode = "";
    private string? inputReason = "";
    private int inputSeason = 1;
    private int inputEpisode = 1;

    private string activeTab = "cast";

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    protected override async Task OnParametersSetAsync()
    {
        MediaItem = DataService.GetById(Id);

        if (MediaItem != null)
        {
            Me.RecordDetailsView(MediaItem);

            var recEngine = new MediaRecommendation();
            SimilarTitles = recEngine.FindSimilar(DataService.GetAllMedia(), MediaItem, 4);

            if (MediaItem.Vibe != null)
            {
                vibeCharacters = MediaItem.Vibe.Characters;
                vibePlot = MediaItem.Vibe.Plot;
                vibeVisuals = MediaItem.Vibe.Visuals;
                vibePacing = MediaItem.Vibe.Pacing;
                vibeVibe = MediaItem.Vibe.Vibe;
                vibeSoundtrack = MediaItem.Vibe.Soundtrack;
            }

            if (MediaItem.TmdbId.HasValue)
            {
                await TmdbService.EnrichMediaDetailsAsync(MediaItem);
                StateHasChanged();
            }
        }
    }

    private bool IsFav => Me.IsFavorite(MediaItem);

    private void ToggleFavorite()
    {
        if (MediaItem != null)
        {
            Me.ToggleFavorite(MediaItem);
            StateHasChanged();
        }
    }

    private void ClearUserStatus()
    {
        if (MediaItem == null) return;
        Me.ClearStatus(MediaItem);
        StateHasChanged();
    }

    private void SaveVibeRating()
    {
        if (MediaItem == null) return;
        var newVibe = new VibeRating(vibeCharacters, vibePlot, vibeVisuals, vibePacing, vibeVibe, vibeSoundtrack);
        MediaItem.SetVibeRating(newVibe);
    }

    private void ToggleWatched()
    {
        if (MediaItem == null) return;
        if (!IsWatched)
        {
            Me.CompleteWatching(MediaItem);
        }
    }

    private void AddToList(Watchlist watchlist)
    {
        if (MediaItem == null) return;
        Me.AddMediaToWatchlist(watchlist, MediaItem, "Added from details page");
    }

    private void OpenCheckpointModal()
    {
        if (ActiveCheckpoint != null)
        {
            inputTimecode = ActiveCheckpoint.Timecode;
            inputReason = ActiveCheckpoint.Reason;
            inputSeason = ActiveCheckpoint.Season ?? 1;
            inputEpisode = ActiveCheckpoint.Episode ?? 1;
        }
        else
        {
            inputTimecode = "";
            inputReason = "";
            inputSeason = 1;
            inputEpisode = 1;
        }
        showCheckpointModal = true;
    }

    private List<TmdbReview> VisibleTmdbReviews
    {
        get
        {
            if (MediaItem?.TmdbReviews == null || MediaItem.TmdbReviews.Count == 0)
                return new List<TmdbReview>();

            return MediaItem.TmdbReviews
                .Skip(reviewPageIndex * 2)
                .Take(2)
                .ToList();
        }
    }

    private void NextReviewPage()
    {
        if (MediaItem?.TmdbReviews == null) return;
        int maxPages = (int)Math.Ceiling(MediaItem.TmdbReviews.Count / 2.0);

        reviewPageIndex++;
        if (reviewPageIndex >= maxPages) reviewPageIndex = 0;
    }

    private void PrevReviewPage()
    {
        if (MediaItem?.TmdbReviews == null) return;
        int maxPages = (int)Math.Ceiling(MediaItem.TmdbReviews.Count / 2.0);

        reviewPageIndex--;
        if (reviewPageIndex < 0) reviewPageIndex = maxPages - 1;
    }

    private void ToggleExpandReview(TmdbReview rev)
    {
        if (expandedReviews.Contains(rev))
            expandedReviews.Remove(rev);
        else
            expandedReviews.Add(rev);
    }

    private void SaveCheckpoint()
    {
        if (MediaItem == null || string.IsNullOrWhiteSpace(inputTimecode)) return;

        WatchCheckpoint cp;
        if (MediaItem is Series series)
        {
            cp = new WatchCheckpoint(series, inputSeason, inputEpisode, inputTimecode, inputReason);
        }
        else if (MediaItem is Movie movie)
        {
            cp = new WatchCheckpoint(movie, inputTimecode, inputReason);
        }
        else return;

        Me.SetCheckpoint(cp);
        showCheckpointModal = false;
    }

    private void ClearCheckpoint()
    {
        if (MediaItem == null) return;
        Me.ClearCheckpoint(MediaItem);
    }

    private UserMediaState? CurrentMediaState => MediaItem != null ? Me.MediaStates.FirstOrDefault(s => s.Item.Id == MediaItem.Id) : null;
    private WatchStatus? CurrentWatchStatus => CurrentMediaState?.Status;

    private void ChangeUserStatus(WatchStatus newStatus)
    {
        if (MediaItem == null) return;

        if (newStatus == WatchStatus.Watched)
        {
            Me.CompleteWatching(MediaItem);
        }
        else
        {
            Me.SetStatus(MediaItem, newStatus);
        }
        StateHasChanged();
    }
}