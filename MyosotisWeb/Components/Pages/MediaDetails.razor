    private void FormatCheckpointTimecode(ChangeEventArgs e)
    {
        var rawInput = e.Value?.ToString() ?? "";
        var digits = new string(rawInput.Where(char.IsDigit).ToArray());

        if (digits.Length > 6)
        {
            digits = digits.Substring(0, 6);
        }

        if (digits.Length >= 5)
        {
            inputTimecode = $"{digits.Substring(0, 2)}:{digits.Substring(2, 2)}:{digits.Substring(4)}";
        }
        else if (digits.Length == 4)
        {
            inputTimecode = $"{digits.Substring(0, 2)}:{digits.Substring(2, 2)}";
        }
        else if (digits.Length == 3)
        {
            inputTimecode = $"{digits.Substring(0, 2)}:{digits.Substring(2)}";
        }
        else
        {
            inputTimecode = digits;
        }
    }

