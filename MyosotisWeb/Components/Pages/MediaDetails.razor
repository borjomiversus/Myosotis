    protected override async Task OnParametersSetAsync()
    {
        MediaItem = null;
        SimilarTitles.Clear();
        activeSeasonIndex = 0;
        reviewPageIndex = 0;
        similarPageIndex = 0;
        expandedReviews.Clear();
        isCastExpanded = false;
        isCrewExpanded = false;
        isTagsExpanded = false;
        activeTab = "tags";
        MediaItem = DataService.GetById(Id);
        await DataService.SaveStateAsync();

        if (MediaItem == null) return;

        Me.RecordDetailsView(MediaItem);

        if (MediaItem.Vibe != null)
        {
            vibeCharacters = MediaItem.Vibe.Characters;
            vibePlot = MediaItem.Vibe.Plot;
            vibeVisuals = MediaItem.Vibe.Visuals;
            vibePacing = MediaItem.Vibe.Pacing;
            vibeVibe = MediaItem.Vibe.Vibe;
            vibeSoundtrack = MediaItem.Vibe.Soundtrack;
        }
        else
        {
            vibeCharacters = 0;
            vibePlot = 0;
            vibeVisuals = 0;
            vibePacing = 0;
            vibeVibe = 0;
            vibeSoundtrack = 0;
        }

        if (MediaItem.TmdbId.HasValue)
        {
            await TmdbService.EnrichMediaDetailsAsync(MediaItem);
            SimilarTitles = await TmdbService.GetSimilarMediaAsync(MediaItem);

            if (SimilarTitles != null)
            {
                foreach (var sim in SimilarTitles)
                {
                    bool existsInLibrary = DataService.Library.Any(libItem =>
                        (libItem.TmdbId.HasValue && sim.TmdbId.HasValue && libItem.TmdbId == sim.TmdbId) ||
                        (libItem.Title.Equals(sim.Title, StringComparison.OrdinalIgnoreCase) && libItem.ReleaseYear == sim.ReleaseYear));

                    if (!existsInLibrary)
                    {
                        DataService.GetOrAddToLibrary(sim);
                    }
                }
            }
        }

        StateHasChanged();
    }

