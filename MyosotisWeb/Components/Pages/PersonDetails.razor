@page "/person/{Id:int}"
@inject MyosotisWeb.ServicesWeb.TmdbApiService TmdbService
@inject MyosotisWeb.ServicesWeb.DemoDataService DataService
@inject NavigationManager Navigation
@using System.Globalization
@using MyosotisWeb.ServicesWeb

<PageTitle>Myosotis · @(person?.Name ?? "Person Details")</PageTitle>

<div class="w-full px-margin py-margin flex flex-col gap-10">

    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center py-24 gap-3">
            <span class="w-8 h-8 border-2 border-primary border-t-transparent rounded-full animate-spin"></span>
            <span class="font-title-md text-[13px] text-secondary-text">Loading person details…</span>
        </div>
    }
    else if (person == null)
    {
        <div class="py-20 flex flex-col items-start gap-4 max-w-xl">
            <h1 class="font-headline-xl text-headline-xl text-on-surface leading-none">Person not found.</h1>
            <p class="font-body-md text-[14px] text-secondary-text">
                Could not retrieve information for this person from TMDB.
            </p>
            <button @onclick='() => Navigation.NavigateTo("/search")'
                    class="mt-2 px-5 py-2.5 rounded-lg bg-primary text-on-primary font-title-md font-semibold text-[13px] hover:opacity-90 transition-opacity">
                Back to catalog
            </button>
        </div>
    }
    else
    {
        <!-- Шапка персони -->
        <header class="flex flex-col gap-6 pb-8 border-b border-secondary/25">
            <!-- Навігація -->
            <nav class="flex items-center gap-2 font-title-md text-[13px] text-secondary-text">
                <a href="/search" class="hover:text-primary transition-colors">Catalog</a>
                <span class="material-symbols-outlined text-[15px]">chevron_right</span>
                <span class="text-on-surface truncate">@person.Name</span>
            </nav>

            <div class="flex flex-col md:flex-row gap-8 items-start">
                <!-- Фото профілю -->
                <div class="w-48 sm:w-56 shrink-0">
                    <div class="aspect-[2/3] w-full rounded-xl overflow-hidden bg-background border border-secondary/30">
                        @if (!string.IsNullOrEmpty(person.ProfileUrl))
                        {
                            <img src="@person.ProfileUrl" alt="@person.Name" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-secondary-text">
                                <span class="material-symbols-outlined text-[56px]">person</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Інформація та біографія -->
                <div class="flex flex-col flex-1 min-w-0 gap-5">
                    <div class="flex flex-col gap-3">
                        <!-- Бейджі метаданих -->
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-2.5 py-1 rounded-md bg-secondary-fill text-primary font-title-md text-[12px]">
                                @(person.KnownForDepartment ?? "Film Industry")
                            </span>

                            @if (!string.IsNullOrEmpty(person.PlaceOfBirth))
                            {
                                <span class="px-2.5 py-1 rounded-md bg-background border border-secondary/30 font-body-md text-[12px] text-secondary-text inline-flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[14px] text-primary">location_on</span>
                                    <span>@person.PlaceOfBirth</span>
                                </span>
                            }

                            @if (!string.IsNullOrEmpty(person.Birthday))
                            {
                                <span class="px-2.5 py-1 rounded-md bg-background border border-secondary/30 font-body-md text-[12px] text-secondary-text inline-flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[14px] text-primary">cake</span>
                                    <span>Born @person.Birthday</span>
                                </span>

                                @if (CalculateAge(person.Birthday, person.Deathday) is int age)
                                {
                                    <span class="px-2.5 py-1 rounded-md bg-background border border-secondary/30 font-body-md text-[12px] text-on-surface inline-flex items-center gap-1.5">
                                        <span>@(string.IsNullOrEmpty(person.Deathday) ? $"{age} years old" : $"Aged {age}")</span>
                                    </span>
                                }
                            }

                            @if (!string.IsNullOrEmpty(person.Deathday))
                            {
                                <span class="px-2.5 py-1 rounded-md bg-background border border-secondary/30 font-body-md text-[12px] text-secondary-text inline-flex items-center gap-1.5">
                                    <span>Died @person.Deathday</span>
                                </span>
                            }
                        </div>

                        <h1 class="font-headline-xl text-headline-xl text-on-surface leading-tight">
                            @person.Name
                        </h1>

                        @if (!string.IsNullOrWhiteSpace(person.Biography))
                        {
                            <div class="flex flex-col items-start gap-2 mt-1">
                                <p class="font-body-md text-[14px] text-on-surface/90 leading-relaxed max-w-4xl @(isBioExpanded ? "" : "line-clamp-4")">
                                    @person.Biography
                                </p>
                                @if (person.Biography.Length > 280)
                                {
                                    <button @onclick="() => isBioExpanded = !isBioExpanded"
                                            class="text-primary hover:opacity-80 font-title-md text-[13px] inline-flex items-center gap-1 transition-opacity">
                                        <span>@(isBioExpanded ? "Show less" : "Read full biography")</span>
                                        <span class="material-symbols-outlined text-[16px]">@(isBioExpanded ? "expand_less" : "expand_more")</span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="font-body-md text-[13px] text-secondary-text">
                                No biography available for @person.Name yet.
                            </p>
                        }
                    </div>

                    <!-- Посилання на IMDb -->
                    @if (!string.IsNullOrEmpty(person.ImdbId))
                    {
                        <div class="pt-2">
                            <a href="https://www.imdb.com/name/@person.ImdbId"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-background border border-secondary/35 text-on-surface hover:border-primary hover:text-primary font-title-md text-[13px] transition-colors">
                                <span>IMDb profile</span>
                                <span class="material-symbols-outlined text-[15px]">open_in_new</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Фільмографія -->
        <section class="flex flex-col gap-6 pb-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-secondary/25 pb-3">
                <h2 class="font-serif text-[24px] text-on-surface">Filmography</h2>

                <!-- Вкладки підрозділів -->
                <div class="flex items-center gap-2">
                    <button @onclick='() => activeTab = "cast"'
                            class="px-4 py-1.5 rounded-lg font-title-md text-[13px] transition-colors border @(activeTab == "cast" ? "bg-primary text-on-primary font-semibold border-primary" : "bg-background text-secondary-text border-secondary/35 hover:text-on-surface")">
                        Acting (@(credits?.Cast.Count ?? 0))
                    </button>

                    @if (credits?.Crew.Count > 0)
                    {
                        <button @onclick='() => activeTab = "crew"'
                                class="px-4 py-1.5 rounded-lg font-title-md text-[13px] transition-colors border @(activeTab == "crew" ? "bg-primary text-on-primary font-semibold border-primary" : "bg-background text-secondary-text border-secondary/35 hover:text-on-surface")">
                            Crew & directing (@credits.Crew.Count)
                        </button>
                    }
                </div>
            </div>

            @{
                var activeList = (activeTab == "cast" ? credits?.Cast : credits?.Crew)
                    ?.OrderByDescending(x => x.DisplayYear)
                    .ToList() ?? new List<TmdbCreditItemDto>();
            }

            @if (activeList.Count > 0)
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5">
                    @foreach (var item in activeList)
                    {
                        <div @onclick="() => OpenMediaAsync(item)"
                             class="cursor-pointer group flex flex-col gap-2.5">
                            <div class="relative w-full aspect-[2/3] rounded-lg overflow-hidden bg-background border border-secondary/30 group-hover:border-primary/60 transition-colors">
                                @if (!string.IsNullOrEmpty(item.PosterUrl))
                                {
                                    <img src="@item.PosterUrl" alt="@item.DisplayTitle" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary-text">
                                        <span class="material-symbols-outlined text-[36px]">@item.IconName</span>
                                    </div>
                                }

                                @if (item.VoteAverage.HasValue && item.VoteAverage > 0)
                                {
                                    <div class="absolute bottom-2 left-2 inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-background/90 text-primary font-title-md text-[11px] border border-secondary/30">
                                        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                        <span>@item.VoteAverage.Value.ToString("0.0", En)</span>
                                    </div>
                                }
                            </div>

                            <div class="flex flex-col gap-0.5">
                                <span class="font-serif font-semibold text-[15px] text-on-surface group-hover:text-primary transition-colors line-clamp-1" title="@item.DisplayTitle">
                                    @item.DisplayTitle
                                </span>

                                <div class="flex items-center justify-between font-body-md text-[12px] text-secondary-text">
                                    <span>@(item.DisplayYear ?? "TBA")</span>
                                    <span>@(string.Equals(item.MediaType, "tv", StringComparison.OrdinalIgnoreCase) ? "Series" : "Movie")</span>
                                </div>

                                @if (!string.IsNullOrEmpty(item.Character))
                                {
                                    <span class="font-body-md text-[12px] text-secondary-text line-clamp-1 mt-0.5" title="@item.Character">
                                        as <span class="text-on-surface">@item.Character</span>
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(item.Job))
                                {
                                    <span class="font-body-md text-[12px] text-primary line-clamp-1 mt-0.5" title="@item.Job">
                                        @item.Job
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="font-body-md text-[13px] text-secondary-text py-4">
                    No credits recorded in this category.
                </p>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private TmdbPersonDetailsDto? person;
    private TmdbCombinedCreditsDto? credits;
    private bool isLoading = true;
    private bool isBioExpanded = false;
    private string activeTab = "cast";
    private static readonly CultureInfo En = new CultureInfo("en-US");

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        isBioExpanded = false;
        activeTab = "cast";

        var personTask = TmdbService.GetPersonDetailsAsync(Id);
        var creditsTask = TmdbService.GetPersonCombinedCreditsAsync(Id);

        await Task.WhenAll(personTask, creditsTask);

        person = await personTask;
        credits = await creditsTask;

        if (credits?.Cast.Count == 0 && credits?.Crew.Count > 0)
        {
            activeTab = "crew";
        }

        isLoading = false;
    }

    private async Task OpenMediaAsync(TmdbCreditItemDto item)
    {
        var media = DataService.Library.FirstOrDefault(m => m.TmdbId == item.Id);

        if (media == null)
        {
            media = string.Equals(item.MediaType, "tv", StringComparison.OrdinalIgnoreCase)
                ? await TmdbService.GetSeriesDetailsAsync(item.Id)
                : await TmdbService.GetMovieDetailsAsync(item.Id);

            if (media == null)
                return;

            media = DataService.GetOrAddToLibrary(media);
            await DataService.SaveStateAsync();
        }

        Navigation.NavigateTo($"/media/{media.Id}");
    }

    private int? CalculateAge(string birthdayStr, string? deathdayStr)
    {
        if (DateTime.TryParse(birthdayStr, out var birthday))
        {
            var endDate = DateTime.TryParse(deathdayStr, out var deathday) ? deathday : DateTime.Now;
            var age = endDate.Year - birthday.Year;
            if (birthday.Date > endDate.AddYears(-age)) age--;
            return age;
        }
        return null;
    }
}
