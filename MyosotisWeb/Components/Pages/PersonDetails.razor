@page "/person/{Id:int}"
@inject MyosotisWeb.ServicesWeb.TmdbApiService TmdbService
@inject MyosotisWeb.ServicesWeb.DemoDataService DataService
@inject NavigationManager Navigation
@using System.Globalization
@using MyosotisWeb.ServicesWeb

<PageTitle>@(person?.Name ?? "Person Details") · Myosotis</PageTitle>

<div class="relative w-full overflow-hidden px-margin py-space-xl">
    <div class="absolute -top-32 -left-20 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center py-space-xl gap-3">
            <span class="w-8 h-8 border-2 border-primary border-t-transparent rounded-full animate-spin"></span>
            <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">Loading Person Details...</span>
        </div>
    }
    else if (person == null)
    {
        <div class="flex flex-col items-center justify-center py-space-xl text-center">
            <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40 mb-2">person_off</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">Person not found</h2>
            <p class="font-body-md text-on-surface-variant mt-1 mb-4">Could not retrieve information from TMDB.</p>
            <button @onclick='() => Navigation.NavigateTo("/search")' class="px-space-lg py-space-xs rounded-full bg-primary text-on-primary font-title-md hover:bg-primary/80 transition-colors">
                Back to Search
            </button>
        </div>
    }
    else
    {
        <!-- Header Info -->
        <article class="relative bg-gradient-to-r from-prussian-blue via-prussian-blue/90 to-prussian-blue/70 rounded-2xl p-space-lg sm:p-space-xl border border-secondary/20 shadow-xl mb-space-xl">
            <div class="flex flex-col md:flex-row gap-space-lg items-start">
                <!-- Profile Image -->
                <div class="relative w-full md:w-56 shrink-0 aspect-[2/3] rounded-xl overflow-hidden bg-prussian-blue/90 border border-secondary/20 shadow-md">
                    @if (!string.IsNullOrEmpty(person.ProfileUrl))
                    {
                        <img src="@person.ProfileUrl" alt="@person.Name" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center text-secondary">
                            <span class="material-symbols-outlined text-[64px]">person</span>
                        </div>
                    }
                </div>

                <!-- Meta & Biography -->
                <div class="flex flex-col flex-1 min-w-0 justify-between gap-space-md">
                    <div class="flex flex-col gap-space-xs">
                        <div class="flex flex-wrap items-center gap-space-xs">
                            <span class="px-space-sm py-0.5 rounded bg-primary/10 border border-primary/20 font-label-caps text-label-caps text-primary tracking-wider uppercase">
                                @(person.KnownForDepartment ?? "Film Industry")
                            </span>

                            @if (!string.IsNullOrEmpty(person.PlaceOfBirth))
                            {
                                <span class="px-space-sm py-0.5 rounded bg-prussian-blue border border-secondary/30 font-label-caps text-label-caps text-on-surface flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[13px] text-secondary">location_on</span>
                                    <span>@person.PlaceOfBirth</span>
                                </span>
                            }

                            <!-- Відокремлена дата народження -->
                            @if (!string.IsNullOrEmpty(person.Birthday))
                            {
                                <span class="px-space-sm py-0.5 rounded bg-prussian-blue border border-secondary/30 font-label-caps text-label-caps text-on-surface flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[13px] text-primary">cake</span>
                                    <span>Born @person.Birthday</span>
                                </span>

                                @if (CalculateAge(person.Birthday, person.Deathday) is int age)
                                {
                                    <span class="px-space-sm py-0.5 rounded bg-prussian-blue border border-secondary/30 font-label-caps text-label-caps text-on-surface flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[13px] text-secondary">hourglass_top</span>
                                        <span>@(string.IsNullOrEmpty(person.Deathday) ? $"{age} yrs old" : $"Aged {age}")</span>
                                    </span>
                                }
                            }

                            <!-- Дата смерті (якщо є) -->
                            @if (!string.IsNullOrEmpty(person.Deathday))
                            {
                                <span class="px-space-sm py-0.5 rounded bg-prussian-blue border border-secondary/30 font-label-caps text-label-caps text-on-surface-variant flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[13px] text-on-surface-variant">sentiment_dissatisfied</span>
                                    <span>Died @person.Deathday</span>
                                </span>
                            }
                        </div>

                        <h1 class="font-headline-xl text-headline-xl text-on-surface mt-1">@person.Name</h1>

                        @if (!string.IsNullOrWhiteSpace(person.Biography))
                        {
                            <div class="mt-space-xs">
                                <p class="font-body-lg text-body-lg text-on-surface-variant/90 leading-relaxed max-w-4xl @(isBioExpanded ? "" : "line-clamp-4")">
                                    @person.Biography
                                </p>
                                @if (person.Biography.Length > 280)
                                {
                                    <button @onclick="() => isBioExpanded = !isBioExpanded" class="mt-2 text-primary font-title-md text-title-md hover:underline flex items-center gap-1">
                                        <span>@(isBioExpanded ? "Show Less" : "Read Full Bio")</span>
                                        <span class="material-symbols-outlined text-[16px]">@(isBioExpanded ? "expand_less" : "expand_more")</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- IMDb Profile Link (стилізовано під палітру проєкту) -->
                    @if (!string.IsNullOrEmpty(person.ImdbId))
                    {
                        <div class="flex items-center gap-space-sm pt-space-sm border-t border-secondary/20">
                            <a href="https://www.imdb.com/name/@person.ImdbId" target="_blank" rel="noopener noreferrer"
                               class="px-space-md py-1 rounded-lg bg-primary/10 border border-primary/30 text-primary font-label-caps text-label-caps hover:bg-primary/20 hover:border-primary transition-all flex items-center gap-1.5 shadow-sm">
                                <span>IMDb Profile</span>
                                <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </article>

        <!-- Filmography Section -->
        <section class="flex flex-col gap-space-lg">
            <div class="flex items-center justify-between border-b border-secondary/20 pb-space-xs">
                <div class="flex items-center gap-space-sm">
                    <span class="material-symbols-outlined text-primary text-[22px]">video_library</span>
                    <h2 class="font-headline-lg text-headline-lg text-on-surface">Filmography</h2>
                </div>

                <!-- Department Tabs -->
                <div class="flex items-center gap-space-xs">
                    <button @onclick='() => activeTab = "cast"' class="px-space-md py-1 rounded-full font-title-md text-title-md transition-all @(activeTab == "cast" ? "bg-primary text-on-primary" : "bg-prussian-blue text-on-surface-variant hover:text-on-surface border border-secondary/20")">
                        Acting (@credits?.Cast.Count)
                    </button>
                    @if (credits?.Crew.Count > 0)
                    {
                        <button @onclick='() => activeTab = "crew"' class="px-space-md py-1 rounded-full font-title-md text-title-md transition-all @(activeTab == "crew" ? "bg-primary text-on-primary" : "bg-prussian-blue text-on-surface-variant hover:text-on-surface border border-secondary/20")">
                            Crew / Directing (@credits?.Crew.Count)
                        </button>
                    }
                </div>
            </div>

            @{
                var activeList = (activeTab == "cast" ? credits?.Cast : credits?.Crew)
                    ?.OrderByDescending(x => x.DisplayYear)
                    .ToList() ?? new List<TmdbCreditItemDto>();
            }

            @if (activeList.Count > 0)
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-space-md">
                    @foreach (var item in activeList)
                    {
                        <div class="group flex flex-col gap-1 bg-prussian-blue/70 rounded-xl p-2 border border-secondary/15 hover:border-secondary/40 transition-all shadow-sm">
                            <button @onclick="() => OpenMediaAsync(item)" class="relative w-full aspect-[2/3] rounded-lg overflow-hidden bg-prussian-blue block border border-secondary/10 text-left">
                                @if (!string.IsNullOrEmpty(item.PosterUrl))
                                {
                                    <img src="@item.PosterUrl" alt="@item.DisplayTitle" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary/40">
                                        <span class="material-symbols-outlined text-[36px]">@item.IconName</span>
                                    </div>
                                }
                                @if (item.VoteAverage.HasValue && item.VoteAverage > 0)
                                {
                                    <div class="absolute bottom-1.5 left-1.5 flex items-center gap-0.5 px-1.5 py-0.5 rounded-full bg-prussian-blue/90 backdrop-blur-sm text-primary font-label-caps text-[10px] border border-primary/20">
                                        <span class="material-symbols-outlined text-[11px]">star</span>
                                        <span>@item.VoteAverage.Value.ToString("0.0", En)</span>
                                    </div>
                                }
                            </button>

                            <!-- Контрастні та читабельні описи ролей -->
                            <div class="flex flex-col px-1 py-1">
                                <button @onclick="() => OpenMediaAsync(item)" class="font-title-md text-title-md text-on-surface group-hover:text-primary transition-colors line-clamp-1 text-left">
                                    @item.DisplayTitle
                                </button>
                                <div class="flex items-center justify-between text-label-sm font-label-sm text-on-surface-variant mt-0.5">
                                    <span class="text-on-surface/70">@(item.DisplayYear ?? "TBA")</span>
                                    <span class="capitalize text-[11px] text-secondary font-medium">@item.MediaType</span>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Character))
                                {
                                    <span class="text-[12px] font-body-md text-on-surface-variant/90 italic line-clamp-1 mt-0.5">
                                        as <span class="text-on-surface font-medium not-italic">@item.Character</span>
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(item.Job))
                                {
                                    <span class="text-[12px] font-body-md text-secondary font-medium italic line-clamp-1 mt-0.5">@item.Job</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-on-surface-variant font-body-md italic py-4">No credits recorded in this category.</p>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private TmdbPersonDetailsDto? person;
    private TmdbCombinedCreditsDto? credits;
    private bool isLoading = true;
    private bool isBioExpanded = false;
    private string activeTab = "cast";
    private static readonly CultureInfo En = new CultureInfo("en-US");

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        var personTask = TmdbService.GetPersonDetailsAsync(Id);
        var creditsTask = TmdbService.GetPersonCombinedCreditsAsync(Id);

        await Task.WhenAll(personTask, creditsTask);

        person = await personTask;
        credits = await creditsTask;

        if (credits?.Cast.Count == 0 && credits?.Crew.Count > 0)
        {
            activeTab = "crew";
        }

        isLoading = false;
    }

    private async Task OpenMediaAsync(TmdbCreditItemDto item)
    {
        var media = DataService.Library.FirstOrDefault(m => m.TmdbId == item.Id);

        if (media == null)
        {
            media = string.Equals(item.MediaType, "tv", StringComparison.OrdinalIgnoreCase)
                ? await TmdbService.GetSeriesDetailsAsync(item.Id)
                : await TmdbService.GetMovieDetailsAsync(item.Id);

            if (media == null)
                return;

            media = DataService.GetOrAddToLibrary(media);
        }

        Navigation.NavigateTo($"/media/{media.Id}");
    }

    private int? CalculateAge(string birthdayStr, string? deathdayStr)
    {
        if (DateTime.TryParse(birthdayStr, out var birthday))
        {
            var endDate = DateTime.TryParse(deathdayStr, out var deathday) ? deathday : DateTime.Now;
            var age = endDate.Year - birthday.Year;
            if (birthday.Date > endDate.AddYears(-age)) age--;
            return age;
        }
        return null;
    }
}