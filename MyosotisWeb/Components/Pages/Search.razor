@page "/search"
@inject MyosotisWeb.ServicesWeb.TmdbApiService TmdbService
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@using Newtonsoft.Json
@inject DemoDataService DataService
@inject MediaSearch SearchService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Catalog</PageTitle>

<div class="w-full px-margin py-margin flex flex-col gap-10">

    <!-- Шапка та панель пошуку -->
    <section class="flex flex-col gap-6 pb-6 border-b border-secondary/25">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div class="flex flex-col gap-2">
                <h1 class="font-headline-xl text-headline-xl text-on-surface leading-none">Catalog</h1>
                <p class="font-body-md text-[14px] text-secondary-text">Search films, series, actors, and directors across TMDB.</p>
            </div>

            <button @onclick="ToggleAdvancedPanel"
                    type="button"
                    class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border transition-colors font-title-md text-[13px] self-start md:self-auto @(showAdvancedPanel || isAdvancedMode ? "bg-secondary-fill border-primary/50 text-primary" : "bg-background border-secondary/35 text-secondary-text hover:text-on-surface")">
                <span class="material-symbols-outlined text-[17px]">tune</span>
                <span>Advanced filters</span>
            </button>
        </div>

        <!-- Рядок пошуку -->
        <form @onsubmit="ExecuteSearch" @onsubmit:preventDefault class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="relative flex-1 group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-secondary-text group-focus-within:text-primary transition-colors">
                    <span class="material-symbols-outlined text-[20px]">search</span>
                </div>

                <input class="w-full pl-11 pr-11 py-3 bg-surface-variant/25 border border-secondary/35 rounded-xl text-[14px] font-body-md text-on-surface placeholder:text-secondary-text focus:outline-none focus:border-primary transition-colors"
                       placeholder="Search films, series, actors, directors…"
                       type="text"
                       @bind="searchInput" />

                @if (!string.IsNullOrEmpty(searchInput))
                {
                    <button @onclick="ClearSearch"
                            aria-label="Clear query"
                            class="absolute inset-y-0 right-0 pr-4 flex items-center text-secondary-text hover:text-on-surface transition-colors"
                            type="button">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                }
            </div>

            <button type="submit"
                    class="px-6 py-3 rounded-xl bg-primary text-on-primary font-title-md font-semibold text-[13px] hover:opacity-90 transition-opacity whitespace-nowrap">
                Search
            </button>
        </form>

        <!-- Розширені фільтри -->
        @if (showAdvancedPanel)
        {
            <div class="p-6 bg-surface-variant/25 border border-secondary/35 rounded-xl flex flex-col gap-5">
                <div class="flex items-center justify-between border-b border-secondary/20 pb-3">
                    <h2 class="font-serif text-[18px] text-on-surface">Advanced search</h2>
                    <button type="button"
                            @onclick="ToggleAdvancedPanel"
                            class="text-secondary-text hover:text-on-surface transition-colors p-1"
                            title="Close filters">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                </div>

                <!-- Тип контенту -->
                <div class="flex flex-col gap-2">
                    <label class="font-title-md text-[12px] text-secondary-text">Content type</label>
                    <div class="flex flex-wrap gap-2">
                        <button type="button"
                                @onclick='() => ChangeAdvancedMediaType(SearchMediaType.All)'
                                class="px-4 py-1.5 rounded-lg text-[13px] font-title-md transition-colors @(advancedFilters.MediaType == SearchMediaType.All ? "bg-primary text-on-primary font-semibold" : "bg-background border border-secondary/35 text-secondary-text hover:text-on-surface")">
                            All
                        </button>
                        <button type="button"
                                @onclick='() => ChangeAdvancedMediaType(SearchMediaType.Movies)'
                                class="px-4 py-1.5 rounded-lg text-[13px] font-title-md transition-colors @(advancedFilters.MediaType == SearchMediaType.Movies ? "bg-primary text-on-primary font-semibold" : "bg-background border border-secondary/35 text-secondary-text hover:text-on-surface")">
                            Movies
                        </button>
                        <button type="button"
                                @onclick='() => ChangeAdvancedMediaType(SearchMediaType.Series)'
                                class="px-4 py-1.5 rounded-lg text-[13px] font-title-md transition-colors @(advancedFilters.MediaType == SearchMediaType.Series ? "bg-primary text-on-primary font-semibold" : "bg-background border border-secondary/35 text-secondary-text hover:text-on-surface")">
                            TV Series
                        </button>
                    </div>
                </div>

                <!-- Роки та рейтинг -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="font-title-md text-[12px] text-secondary-text">Year from</label>
                        <input type="number"
                               placeholder="e.g. 1990"
                               @bind="advancedFilters.YearFrom"
                               class="px-3.5 py-2 bg-background border border-secondary/35 rounded-lg text-on-surface placeholder:text-secondary-text font-body-md text-[13px] focus:border-primary outline-none transition-colors" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="font-title-md text-[12px] text-secondary-text">Year to</label>
                        <input type="number"
                               placeholder="e.g. 2026"
                               @bind="advancedFilters.YearTo"
                               class="px-3.5 py-2 bg-background border border-secondary/35 rounded-lg text-on-surface placeholder:text-secondary-text font-body-md text-[13px] focus:border-primary outline-none transition-colors" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="font-title-md text-[12px] text-secondary-text">Min rating (TMDB)</label>
                        <input type="number"
                               step="0.5"
                               min="0"
                               max="10"
                               placeholder="e.g. 6.0"
                               @bind="advancedFilters.RatingFrom"
                               class="px-3.5 py-2 bg-background border border-secondary/35 rounded-lg text-on-surface placeholder:text-secondary-text font-body-md text-[13px] focus:border-primary outline-none transition-colors" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="font-title-md text-[12px] text-secondary-text">Max rating (TMDB)</label>
                        <input type="number"
                               step="0.5"
                               min="0"
                               max="10"
                               placeholder="e.g. 9.0"
                               @bind="advancedFilters.RatingTo"
                               class="px-3.5 py-2 bg-background border border-secondary/35 rounded-lg text-on-surface placeholder:text-secondary-text font-body-md text-[13px] focus:border-primary outline-none transition-colors" />
                    </div>
                </div>

                <!-- Жанри -->
                @if (availableGenres.Count > 0)
                {
                    <div class="flex flex-col gap-2">
                        <label class="font-title-md text-[12px] text-secondary-text">Genres</label>
                        <div class="flex flex-wrap gap-2 max-h-36 overflow-y-auto pr-1">
                            @foreach (var genre in availableGenres)
                            {
                                bool isSelected = advancedFilters.SelectedGenreIds.Contains(genre.Id);
                                <button type="button"
                                        @onclick="() => ToggleGenre(genre.Id)"
                                        class="px-3 py-1 rounded-lg text-[12px] font-title-md border transition-colors @(isSelected ? "bg-secondary-fill border-primary/60 text-primary" : "bg-background border-secondary/30 text-secondary-text hover:text-on-surface")">
                                    @genre.Name
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Ключові слова -->
                <div class="flex flex-col gap-2">
                    <label class="font-title-md text-[12px] text-secondary-text">Keywords</label>

                    <input type="text"
                           value="@keywordInput"
                           @oninput="OnKeywordInput"
                           placeholder="Search keywords…"
                           class="w-full px-3.5 py-2 bg-background border border-secondary/35 rounded-lg text-on-surface placeholder:text-secondary-text font-body-md text-[13px] outline-none focus:border-primary transition-colors" />

                    @if (keywordSuggestions.Count > 0)
                    {
                        <div class="flex flex-col rounded-lg border border-secondary/35 overflow-hidden bg-background">
                            @foreach (var keyword in keywordSuggestions)
                            {
                                <button type="button"
                                        @onclick="() => AddKeyword(keyword)"
                                        class="text-left px-3.5 py-2 hover:bg-surface-variant/40 text-on-surface font-body-md text-[13px] border-b border-secondary/15 last:border-b-0 transition-colors">
                                    @keyword.Name
                                </button>
                            }
                        </div>
                    }

                    @if (advancedFilters.SelectedKeywords.Count > 0)
                    {
                        <div class="flex flex-wrap gap-2 pt-1">
                            @foreach (var keyword in advancedFilters.SelectedKeywords)
                            {
                                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-secondary-fill border border-primary/40 text-primary font-title-md text-[12px]">
                                    <span>@keyword.Name</span>
                                    <button type="button"
                                            @onclick="() => RemoveKeyword(keyword.Id)"
                                            class="text-on-surface hover:text-error transition-colors"
                                            aria-label="Remove keyword">
                                        ×
                                    </button>
                                </span>
                            }
                        </div>
                    }
                </div>

                <!-- Кнопки дій -->
                <div class="flex items-center justify-end gap-3 pt-3 border-t border-secondary/20">
                    <button type="button"
                            @onclick="ResetAdvancedFilters"
                            class="px-4 py-2 rounded-lg text-secondary-text hover:text-on-surface text-[13px] font-title-md transition-colors">
                        Reset
                    </button>
                    <button type="button"
                            @onclick="ApplyAdvancedFilters"
                            class="px-5 py-2 rounded-lg bg-primary text-on-primary text-[13px] font-title-md font-semibold hover:opacity-90 transition-opacity">
                        Apply filters
                    </button>
                </div>
            </div>
        }

        <!-- Підзаголовок результатів і таби -->
        @if (!string.IsNullOrWhiteSpace(Query) || isAdvancedMode)
        {
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pt-2">
                <h2 class="font-serif text-[22px] text-on-surface">
                    @if (isAdvancedMode)
                    {
                        <span>Filtered results</span>
                    }
                    else
                    {
                        <span>Results for </span>
                        <span class="text-primary">“@Query”</span>
                    }
                </h2>
                <p class="font-body-md text-[13px] text-secondary-text">
                    <strong class="text-on-surface font-semibold">@(totalResults > 0 ? totalResults : GetFilteredResults().Count)</strong> entries found
                </p>
            </div>
        }

        @if (!isAdvancedMode && (results.Count > 0 || peopleResults.Count > 0 || !string.IsNullOrWhiteSpace(Query)))
        {
            <div class="flex items-center gap-2 overflow-x-auto pb-1">
                <button @onclick='() => SelectFilter("All")'
                        class="px-3.5 py-1.5 rounded-lg font-title-md text-[13px] transition-colors inline-flex items-center gap-1.5 @(selectedFilter == "All" ? "bg-primary text-on-primary font-semibold" : "bg-background border border-secondary/35 text-secondary-text hover:text-on-surface")">
                    <span>All</span>
                    <span class="text-[11px] opacity-80">(@(totalMovies + totalSeries + totalPeople > 0 ? totalMovies + totalSeries + totalPeople : results.Count + peopleResults.Count))</span>
                </button>
                <button @onclick='() => SelectFilter("Movies")'
                        class="px-3.5 py-1.5 rounded-lg font-title-md text-[13px] transition-colors inline-flex items-center gap-1.5 @(selectedFilter == "Movies" ? "bg-primary text-on-primary font-semibold" : "bg-background border border-secondary/35 text-secondary-text hover:text-on-surface")">
                    <span>Movies</span>
                    <span class="text-[11px] opacity-80">(@(totalMovies > 0 ? totalMovies : CountMovies()))</span>
                </button>
                <button @onclick='() => SelectFilter("Series")'
                        class="px-3.5 py-1.5 rounded-lg font-title-md text-[13px] transition-colors inline-flex items-center gap-1.5 @(selectedFilter == "Series" ? "bg-primary text-on-primary font-semibold" : "bg-background border border-secondary/35 text-secondary-text hover:text-on-surface")">
                    <span>TV Series</span>
                    <span class="text-[11px] opacity-80">(@(totalSeries > 0 ? totalSeries : CountSeries()))</span>
                </button>
                <button @onclick='() => SelectFilter("People")'
                        class="px-3.5 py-1.5 rounded-lg font-title-md text-[13px] transition-colors inline-flex items-center gap-1.5 @(selectedFilter == "People" ? "bg-primary text-on-primary font-semibold" : "bg-background border border-secondary/35 text-secondary-text hover:text-on-surface")">
                    <span>People</span>
                    <span class="text-[11px] opacity-80">(@(totalPeople > 0 ? totalPeople : peopleResults.Count))</span>
                </button>
                <button @onclick='() => SelectFilter("Watchlist")'
                        class="px-3.5 py-1.5 rounded-lg font-title-md text-[13px] transition-colors inline-flex items-center gap-1.5 @(selectedFilter == "Watchlist" ? "bg-primary text-on-primary font-semibold" : "bg-background border border-secondary/35 text-secondary-text hover:text-on-surface")">
                    <span>In Watchlists</span>
                    <span class="text-[11px] opacity-80">(@CountInWatchlist())</span>
                </button>
            </div>
        }
    </section>

    <!-- Результати пошуку -->
    @if (isSearching)
    {
        <div class="flex flex-col items-center justify-center py-20 gap-4">
            <div class="w-8 h-8 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
            <span class="font-body-md text-[13px] text-secondary-text">Searching catalog…</span>
        </div>
    }
    else if (HasAnyDisplayResults())
    {
        <div class="flex flex-col gap-5">
            <!-- Фільми та серіали -->
            @if (selectedFilter != "People")
            {
                @foreach (var m in GetFilteredResults())
                {
                    var containingList = GetContainingWatchlist(m);
                    bool isWatched = Me.IsWatched(m);
                    int searchTimeDebt = m.CalculateTimeDebt();

                    <article class="group bg-surface-variant/20 hover:bg-surface-variant/35 rounded-xl p-5 transition-colors border border-secondary/25">
                        <div class="flex flex-col md:flex-row gap-6 items-start">
                            <!-- Постер -->
                            <a href="/media/@m.Id"
                               class="w-28 sm:w-32 shrink-0 aspect-[2/3] rounded-lg overflow-hidden bg-background block border border-secondary/30 group-hover:border-primary/50 transition-colors">
                                @if (!string.IsNullOrEmpty(m.PosterUrl))
                                {
                                    <img src="@m.PosterUrl" alt="@m.Title" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary-text text-[12px]">
                                        —
                                    </div>
                                }
                            </a>

                            <!-- Інформація -->
                            <div class="flex flex-col flex-1 min-w-0 justify-between gap-4 w-full">
                                <div class="flex flex-col gap-2">
                                    <div class="flex flex-wrap items-center gap-2 w-full">
                                        <span class="px-2.5 py-0.5 rounded-md bg-secondary-fill text-primary font-title-md text-[11px]">
                                            @(m is Series ? "TV Series" : "Movie")
                                        </span>

                                        <span class="font-body-md text-[12px] text-secondary-text">
                                            @m.ReleaseYear
                                        </span>

                                        @if (searchTimeDebt > 1)
                                        {
                                            <span class="text-secondary/40">·</span>
                                            <span class="font-body-md text-[12px] text-secondary-text">
                                                @UiHelpers.FormatMinutes(searchTimeDebt)
                                            </span>
                                        }

                                        @if (m.Genres != null && m.Genres.Count > 0)
                                        {
                                            <span class="text-secondary/40">·</span>
                                            <span class="font-body-md text-[12px] text-secondary-text">@string.Join(", ", m.Genres)</span>
                                        }

                                        <!-- Користувацькі мітки -->
                                        <div class="flex items-center gap-2 ml-auto flex-wrap">
                                            @if (Me.IsFavorite(m))
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-tertiary/15 text-tertiary text-[11px] font-title-md border border-tertiary/30">
                                                    <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">favorite</span>
                                                    <span>Favorite</span>
                                                </span>
                                            }

                                            @if (containingList != null)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-secondary-fill text-primary text-[11px] font-title-md border border-primary/30">
                                                    <span>In list: @containingList.Name</span>
                                                </span>
                                            }

                                            @if (isWatched)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-background text-on-surface text-[11px] font-title-md border border-secondary/35">
                                                    <span class="material-symbols-outlined text-[13px] text-primary">check_circle</span>
                                                    <span>Watched</span>
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Назва та рейтинги -->
                                    <div class="flex items-center gap-3 flex-wrap">
                                        <a href="/media/@m.Id"
                                           class="font-serif font-semibold text-[22px] text-on-surface group-hover:text-primary transition-colors">
                                            @m.Title
                                        </a>

                                        @if (m.TmdbRating.HasValue)
                                        {
                                            <div class="inline-flex items-center gap-1 text-[13px] font-title-md text-on-surface" title="TMDB Rating">
                                                <span class="material-symbols-outlined text-[15px] text-primary" style="font-variation-settings: 'FILL' 1;">star</span>
                                                <span>@m.TmdbRating.Value.ToString("0.0", En)</span>
                                                <span class="text-[11px] text-secondary-text font-normal">TMDB</span>
                                            </div>
                                        }

                                        @if (m.Vibe != null)
                                        {
                                            var vibeAverage = m.Vibe.CalculateAverage();
                                            @if (vibeAverage > 0)
                                            {
                                                <div class="inline-flex items-center gap-1 text-[13px] font-title-md text-tertiary" title="Your Vibe Rating">
                                                    <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                                    <span>@vibeAverage.ToString("0.0", En)</span>
                                                    <span class="text-[11px] text-secondary-text font-normal">Vibe</span>
                                                </div>
                                            }
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(m.Description))
                                    {
                                        <p class="font-body-md text-[13px] text-secondary-text line-clamp-2 max-w-4xl leading-relaxed">
                                            @m.Description
                                        </p>
                                    }
                                </div>

                                <!-- Дії -->
                                <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-secondary/15">
                                    <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                                        <a href="/media/@m.Id"
                                           class="px-4 py-1.5 rounded-lg bg-primary text-on-primary font-title-md font-semibold text-[12px] hover:opacity-90 transition-opacity inline-flex items-center gap-1.5">
                                            <span>Details</span>
                                            <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                                        </a>

                                        @if (Me.Watchlists.Count > 0)
                                        {
                                            <div class="flex items-center gap-2">
                                                <select @onchange="e => PickList(m, e.Value?.ToString())"
                                                        aria-label="Choose watchlist"
                                                        class="bg-background border border-secondary/35 rounded-lg px-3 py-1.5 text-on-surface font-body-md text-[12px] outline-none focus:border-primary cursor-pointer transition-colors">
                                                    @foreach (var list in Me.Watchlists)
                                                    {
                                                        <option value="@list.Name" class="bg-background text-on-surface">@list.Name</option>
                                                    }
                                                </select>
                                                <button @onclick="async () => await AddToList(m)"
                                                        class="px-3.5 py-1.5 rounded-lg border border-primary/50 text-primary hover:bg-primary hover:text-on-primary font-title-md font-semibold text-[12px] transition-colors whitespace-nowrap">
                                                    Add
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }

            <!-- Персони -->
            @if (selectedFilter == "All" || selectedFilter == "People")
            {
                @foreach (var p in peopleResults)
                {
                    <article class="group bg-surface-variant/20 hover:bg-surface-variant/35 rounded-xl p-5 transition-colors border border-secondary/25">
                        <div class="flex flex-col sm:flex-row gap-6 items-start">
                            <a href="/person/@p.Id"
                               class="w-24 sm:w-28 shrink-0 aspect-[2/3] rounded-lg overflow-hidden bg-background block border border-secondary/30 group-hover:border-primary/50 transition-colors">
                                @if (!string.IsNullOrEmpty(p.ProfileUrl))
                                {
                                    <img src="@p.ProfileUrl" alt="@p.Name" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary-text">
                                        <span class="material-symbols-outlined text-[32px]">person</span>
                                    </div>
                                }
                            </a>

                            <div class="flex flex-col flex-1 min-w-0 justify-between gap-3">
                                <div class="flex flex-col gap-1.5">
                                    <span class="px-2.5 py-0.5 rounded-md bg-secondary-fill text-primary font-title-md text-[11px] w-fit">
                                        @(p.KnownForDepartment ?? "Film Industry")
                                    </span>

                                    <a href="/person/@p.Id"
                                       class="font-serif font-semibold text-[22px] text-on-surface group-hover:text-primary transition-colors">
                                        @p.Name
                                    </a>

                                    @if (!string.IsNullOrWhiteSpace(p.KnownForTitles))
                                    {
                                        <p class="font-body-md text-[13px] text-secondary-text">
                                            <span class="text-on-surface font-medium">Known for:</span> @p.KnownForTitles
                                        </p>
                                    }
                                </div>

                                <div class="pt-2">
                                    <a href="/person/@p.Id"
                                       class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg border border-secondary/35 text-on-surface hover:text-primary hover:border-primary/60 font-title-md text-[12px] transition-colors">
                                        <span>View profile</span>
                                        <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>

        <!-- Пагінація -->
        @if (totalPages > 1 && selectedFilter != "Watchlist")
        {
            <div class="flex items-center justify-center gap-4 pt-6 border-t border-secondary/25">
                <button disabled="@(currentPage <= 1)"
                        @onclick="PrevPage"
                        class="px-4 py-2 rounded-lg bg-background border border-secondary/35 text-on-surface hover:border-primary/60 hover:text-primary transition-colors disabled:opacity-40 inline-flex items-center gap-1.5 font-title-md text-[13px]">
                    <span class="material-symbols-outlined text-[17px]">chevron_left</span>
                    <span>Previous</span>
                </button>

                <div class="font-body-md text-[13px] text-secondary-text flex gap-2 items-center">
                    <span>Page</span>
                    <span class="text-on-surface font-semibold">@currentPage</span>
                    <span>of @totalPages</span>
                </div>

                <button disabled="@(currentPage >= totalPages)"
                        @onclick="NextPage"
                        class="px-4 py-2 rounded-lg bg-background border border-secondary/35 text-on-surface hover:border-primary/60 hover:text-primary transition-colors disabled:opacity-40 inline-flex items-center gap-1.5 font-title-md text-[13px]">
                    <span>Next</span>
                    <span class="material-symbols-outlined text-[17px]">chevron_right</span>
                </button>
            </div>
        }
    }
    else if (!string.IsNullOrWhiteSpace(Query) || isAdvancedMode)
    {
        <!-- Порожній результат пошуку -->
        <div class="flex flex-col items-center justify-center py-20 text-center max-w-md mx-auto gap-3">
            <h2 class="font-serif text-[22px] text-on-surface">
                Nothing matched your search
            </h2>
            <p class="font-body-md text-[14px] text-secondary-text leading-relaxed">
                Try adjusting your keywords or clearing active filters.
            </p>
            <button @onclick="ClearSearch"
                    class="mt-2 px-5 py-2 rounded-lg border border-primary/50 text-primary hover:bg-primary hover:text-on-primary font-title-md font-semibold text-[13px] transition-colors">
                Reset search
            </button>
        </div>
    }
    else
    {
        <!-- Тренди тижня -->
        @if (trendingMedia.Count > 0)
        {
            <section class="flex flex-col gap-5">
                <div class="flex items-baseline justify-between pb-2.5 border-b border-secondary/25">
                    <h2 class="font-serif text-[22px] text-on-surface">Trending this week</h2>
                    <span class="font-body-md text-[12px] text-secondary-text">Popular on TMDB</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5">
                    @foreach (var media in trendingMedia.Take(18))
                    {
                        <a href="/media/@media.Id" class="group flex flex-col gap-2.5">
                            <div class="aspect-[2/3] w-full rounded-lg overflow-hidden bg-background relative border border-secondary/30 group-hover:border-primary/60 transition-colors">
                                @if (!string.IsNullOrEmpty(media.PosterUrl))
                                {
                                    <img src="@media.PosterUrl" alt="@media.Title" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary-text text-[12px]">
                                        —
                                    </div>
                                }
                                @if (media.TmdbRating.HasValue)
                                {
                                    <div class="absolute top-2 right-2 px-1.5 py-0.5 rounded bg-background/90 border border-secondary/35 text-primary text-[11px] font-title-md font-semibold inline-flex items-center gap-0.5">
                                        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                        <span>@media.TmdbRating.Value.ToString("0.0", En)</span>
                                    </div>
                                }
                            </div>
                            <div class="flex flex-col gap-0.5">
                                <span class="font-serif font-semibold text-[15px] text-on-surface truncate group-hover:text-primary transition-colors">@media.Title</span>
                                <span class="font-body-md text-[12px] text-secondary-text">@media.ReleaseYear</span>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "p")]
    public int PageParam { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "f")]
    public string? FilterParam { get; set; }

    [SupplyParameterFromQuery(Name = "adv")]
    public bool AdvParam { get; set; } = false;

    [SupplyParameterFromQuery(Name = "type")]
    public string? AdvTypeParam { get; set; }

    [SupplyParameterFromQuery(Name = "yFrom")]
    public int? AdvYearFromParam { get; set; }

    [SupplyParameterFromQuery(Name = "yTo")]
    public int? AdvYearToParam { get; set; }

    [SupplyParameterFromQuery(Name = "rFrom")]
    public double? AdvRatingFromParam { get; set; }

    [SupplyParameterFromQuery(Name = "rTo")]
    public double? AdvRatingToParam { get; set; }

    [SupplyParameterFromQuery(Name = "genres")]
    public string? AdvGenresParam { get; set; }

    [SupplyParameterFromQuery(Name = "kw")]
    public string? AdvKeywordsParam { get; set; }

    private SearchMediaType? loadedGenresForType = null;

    private string searchInput = "";
    private string selectedFilter = "All";
    private List<Media> results = new List<Media>();
    private List<TmdbPersonSearchDto> peopleResults = new List<TmdbPersonSearchDto>();
    private List<Media> trendingMedia = new List<Media>();
    private bool isSearching = false;
    private string? lastLogged;
    private readonly Dictionary<Media, string> pickedLists = new Dictionary<Media, string>();
    private static readonly CultureInfo En = new CultureInfo("en-US");

    private bool showAdvancedPanel = false;
    private bool isAdvancedMode = false;
    private AdvancedSearchFilters advancedFilters = new AdvancedSearchFilters();
    private List<TmdbGenreDto> availableGenres = new List<TmdbGenreDto>();
    private AdvancedSearchFilters? appliedAdvancedFilters;
    private string keywordInput = "";
    private List<TmdbKeywordItemDto> keywordSuggestions = new();

    private int currentPage = 1;
    private int totalPages = 1;
    private int totalResults = 0;
    private int totalMovies = 0;
    private int totalSeries = 0;
    private int totalPeople = 0;

    private User Me => DataService.CurrentUser;

    protected override async Task OnInitializedAsync()
    {
        var rawTrending = await TmdbService.GetTrendingMediaAsync();
        trendingMedia.Clear();

        foreach (var media in rawTrending)
        {
            var existing = DataService.Library.FirstOrDefault(libItem =>
                (libItem.TmdbId.HasValue && media.TmdbId.HasValue && libItem.TmdbId == media.TmdbId) ||
                (libItem.Title.Equals(media.Title, StringComparison.OrdinalIgnoreCase) && libItem.ReleaseYear == media.ReleaseYear));

            if (existing != null)
            {
                trendingMedia.Add(existing);
            }
            else
            {
                DataService.GetOrAddToLibrary(media);
                trendingMedia.Add(media);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        searchInput = Query ?? "";
        currentPage = PageParam > 0 ? PageParam : 1;
        selectedFilter = !string.IsNullOrWhiteSpace(FilterParam) ? FilterParam : "All";
        isAdvancedMode = AdvParam;

        if (isAdvancedMode)
        {
            RestoreAdvancedFiltersFromQuery();
            await EnsureGenresLoadedAsync(advancedFilters.MediaType);
            await LoadAdvancedResultsAsync(currentPage);
            return;
        }

        await EnsureGenresLoadedAsync(SearchMediaType.All);

        if (string.IsNullOrWhiteSpace(Query))
        {
            results.Clear();
            peopleResults.Clear();
            return;
        }

        isSearching = true;
        results = new List<Media>();
        peopleResults = new List<TmdbPersonSearchDto>();

        if (currentPage == 1 && selectedFilter != "People")
        {
            var allMedia = DataService.GetAllMedia();
            AddUnique(SearchService.SearchByTitle(allMedia, Query));
            AddUnique(SearchService.FilterByGenre(allMedia, Query));
            AddUnique(SearchService.SearchByActor(allMedia, Query));
        }

        try
        {
            PagedMediaResult tmdbResponse;

            switch (selectedFilter)
            {
                case "Movies":
                    tmdbResponse = await TmdbService.SearchMoviesPagedAsync(Query, currentPage);
                    break;
                case "Series":
                    tmdbResponse = await TmdbService.SearchTvPagedAsync(Query, currentPage);
                    break;
                case "People":
                    tmdbResponse = await TmdbService.SearchPeoplePagedAsync(Query, currentPage);
                    break;
                case "Watchlist":
                    var watchlistMedia = DataService.GetAllMedia()
                        .Where(m => IsInAnyWatchlist(m) && m.Title.Contains(Query, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    results = watchlistMedia;
                    totalPages = 1;
                    totalResults = watchlistMedia.Count;
                    isSearching = false;
                    return;
                case "All":
                default:
                    tmdbResponse = await TmdbService.SearchMediaPagedAsync(Query, currentPage);
                    break;
            }

            ApplyPagedResult(tmdbResponse);
        }
        catch { }

        isSearching = false;

        if (Query != lastLogged && currentPage == 1)
        {
            Me.LogSearch(Query);
            lastLogged = Query;
        }
    }

    private async Task EnsureGenresLoadedAsync(SearchMediaType mediaType)
    {
        if (availableGenres.Count > 0 && loadedGenresForType == mediaType)
            return;

        availableGenres = mediaType switch
        {
            SearchMediaType.Movies => await TmdbService.GetMovieGenresAsync(),
            SearchMediaType.Series => await TmdbService.GetTvGenresAsync(),
            _ => await TmdbService.GetAllGenresAsync()
        };

        loadedGenresForType = mediaType;
    }

    private string BuildAdvancedSearchUrl(int page)
    {
        var filters = appliedAdvancedFilters ?? advancedFilters;

        var queryParts = new List<string>
        {
            "adv=true",
            $"p={page}"
        };

        if (filters.MediaType != SearchMediaType.All)
            queryParts.Add($"type={filters.MediaType}");

        if (filters.YearFrom.HasValue)
            queryParts.Add($"yFrom={filters.YearFrom.Value}");

        if (filters.YearTo.HasValue)
            queryParts.Add($"yTo={filters.YearTo.Value}");

        if (filters.RatingFrom.HasValue)
            queryParts.Add($"rFrom={filters.RatingFrom.Value.ToString(CultureInfo.InvariantCulture)}");

        if (filters.RatingTo.HasValue)
            queryParts.Add($"rTo={filters.RatingTo.Value.ToString(CultureInfo.InvariantCulture)}");

        if (filters.SelectedGenreIds.Count > 0)
            queryParts.Add($"genres={string.Join(",", filters.SelectedGenreIds)}");

        if (filters.SelectedKeywords.Count > 0)
        {
            var json = JsonConvert.SerializeObject(
                filters.SelectedKeywords.Select(k => new { k.Id, k.Name }));
            queryParts.Add($"kw={Uri.EscapeDataString(json)}");
        }

        return "/search?" + string.Join("&", queryParts);
    }

    private void RestoreAdvancedFiltersFromQuery()
    {
        advancedFilters.Clear();

        if (Enum.TryParse<SearchMediaType>(AdvTypeParam, true, out var parsedType) &&
            Enum.IsDefined(typeof(SearchMediaType), parsedType))
        {
            advancedFilters.MediaType = parsedType;
        }

        advancedFilters.YearFrom = AdvYearFromParam;
        advancedFilters.YearTo = AdvYearToParam;
        advancedFilters.RatingFrom = AdvRatingFromParam;
        advancedFilters.RatingTo = AdvRatingToParam;

        if (!string.IsNullOrWhiteSpace(AdvGenresParam))
        {
            foreach (var part in AdvGenresParam.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                if (int.TryParse(part, out int id))
                    advancedFilters.SelectedGenreIds.Add(id);
            }
        }

        if (!string.IsNullOrWhiteSpace(AdvKeywordsParam))
        {
            try
            {
                var keywords = JsonConvert.DeserializeObject<List<SelectedKeyword>>(AdvKeywordsParam);
                if (keywords != null)
                {
                    advancedFilters.SelectedKeywords = keywords
                        .Where(k => k.Id > 0 && !string.IsNullOrWhiteSpace(k.Name))
                        .ToList();
                }
            }
            catch (JsonException)
            {
                advancedFilters.SelectedKeywords.Clear();
            }
        }

        appliedAdvancedFilters = advancedFilters.Clone();
    }

    private void ApplyPagedResult(PagedMediaResult tmdbResponse)
    {
        totalPages = tmdbResponse.TotalPages;
        totalResults = tmdbResponse.TotalResults;
        totalMovies = tmdbResponse.TotalMovies;
        totalSeries = tmdbResponse.TotalSeries;
        totalPeople = tmdbResponse.TotalPeople;
        peopleResults = tmdbResponse.People;

        results.Clear();

        foreach (var item in tmdbResponse.Results)
        {
            var libraryItem = DataService.GetOrAddToLibrary(item);
            AddUnique(new List<Media> { libraryItem });
        }
    }

    private async Task ToggleAdvancedPanel()
    {
        showAdvancedPanel = !showAdvancedPanel;
        if (showAdvancedPanel)
        {
            await EnsureGenresLoadedAsync(advancedFilters.MediaType);
        }
    }

    private async Task ChangeAdvancedMediaType(SearchMediaType type)
    {
        if (advancedFilters.MediaType == type)
            return;

        advancedFilters.MediaType = type;
        advancedFilters.SelectedGenreIds.Clear();
        await EnsureGenresLoadedAsync(type);
    }

    private void ToggleGenre(int genreId)
    {
        if (advancedFilters.SelectedGenreIds.Contains(genreId))
            advancedFilters.SelectedGenreIds.Remove(genreId);
        else
            advancedFilters.SelectedGenreIds.Add(genreId);
    }

    private async Task OnKeywordInput(ChangeEventArgs e)
    {
        keywordInput = e.Value?.ToString() ?? "";

        if (keywordInput.Trim().Length < 2)
        {
            keywordSuggestions.Clear();
            return;
        }

        try
        {
            keywordSuggestions = await TmdbService.SearchKeywordsAutocompleteAsync(
                keywordInput.Trim());

            keywordSuggestions = keywordSuggestions
                .Where(k => !advancedFilters.SelectedKeywords.Any(s => s.Id == k.Id))
                .ToList();
        }
        catch
        {
            keywordSuggestions.Clear();
        }
    }

    private void AddKeyword(TmdbKeywordItemDto keyword)
    {
        if (!advancedFilters.SelectedKeywords.Any(k => k.Id == keyword.Id))
        {
            advancedFilters.SelectedKeywords.Add(new SelectedKeyword
            {
                Id = keyword.Id,
                Name = keyword.Name
            });
        }

        keywordInput = "";
        keywordSuggestions.Clear();
    }

    private void RemoveKeyword(int id)
    {
        advancedFilters.SelectedKeywords.RemoveAll(k => k.Id == id);
    }

    private async Task ApplyAdvancedFilters()
    {
        if (advancedFilters.YearFrom.HasValue &&
            advancedFilters.YearTo.HasValue &&
            advancedFilters.YearFrom > advancedFilters.YearTo)
        {
            Snackbar.Add(
                "Starting year cannot be greater than ending year.",
                Severity.Warning);
            return;
        }

        if (advancedFilters.RatingFrom.HasValue &&
            advancedFilters.RatingTo.HasValue &&
            advancedFilters.RatingFrom > advancedFilters.RatingTo)
        {
            Snackbar.Add(
                "Minimum rating cannot be greater than maximum rating.",
                Severity.Warning);
            return;
        }

        appliedAdvancedFilters = advancedFilters.Clone();
        isAdvancedMode = true;
        showAdvancedPanel = false;

        var targetUrl = BuildAdvancedSearchUrl(1);
        var currentRelativeUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

        if (string.Equals(currentRelativeUrl, targetUrl, StringComparison.OrdinalIgnoreCase))
        {
            await LoadAdvancedResultsAsync(1);
        }
        else
        {
            Navigation.NavigateTo(targetUrl);
        }
    }

    private async Task LoadAdvancedResultsAsync(int page)
    {
        if (appliedAdvancedFilters == null)
            return;

        isSearching = true;

        try
        {
            var response = await TmdbService.DiscoverMediaPagedAsync(
                appliedAdvancedFilters,
                page);

            results.Clear();
            peopleResults.Clear();

            ApplyPagedResult(response);
            currentPage = response.CurrentPage;
            totalPages = response.TotalPages;
            totalResults = response.TotalResults;
            totalMovies = response.TotalMovies;
            totalSeries = response.TotalSeries;
            totalPeople = response.TotalPeople;
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Advanced search failed: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            isSearching = false;
        }
    }

    private void ResetAdvancedFilters()
    {
        advancedFilters.Clear();
        appliedAdvancedFilters = null;

        keywordInput = "";
        keywordSuggestions.Clear();

        results.Clear();
        peopleResults.Clear();

        totalResults = 0;
        totalPages = 1;
        currentPage = 1;

        isAdvancedMode = false;
        Navigation.NavigateTo("/search");
    }

    private void ExecuteSearch()
    {
        isAdvancedMode = false;
        if (string.IsNullOrWhiteSpace(searchInput))
        {
            Navigation.NavigateTo("/search");
        }
        else
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchInput)}&p=1&f={selectedFilter}");
        }
    }

    private void ClearSearch()
    {
        searchInput = "";
        isAdvancedMode = false;
        advancedFilters.Clear();
        appliedAdvancedFilters = null;
        Navigation.NavigateTo("/search");
    }

    private void PrevPage()
    {
        if (currentPage <= 1)
            return;

        if (isAdvancedMode)
        {
            Navigation.NavigateTo(BuildAdvancedSearchUrl(currentPage - 1));
            return;
        }

        Navigation.NavigateTo(
            $"/search?q={Uri.EscapeDataString(Query ?? "")}&p={currentPage - 1}&f={selectedFilter}");
    }

    private void NextPage()
    {
        if (currentPage >= totalPages)
            return;

        if (isAdvancedMode)
        {
            Navigation.NavigateTo(BuildAdvancedSearchUrl(currentPage + 1));
            return;
        }

        Navigation.NavigateTo(
            $"/search?q={Uri.EscapeDataString(Query ?? "")}&p={currentPage + 1}&f={selectedFilter}");
    }

    private void SelectFilter(string filter)
    {
        if (selectedFilter == filter) return;

        selectedFilter = filter;
        if (!string.IsNullOrWhiteSpace(Query))
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(Query!)}&p=1&f={filter}");
        }
    }

    private void AddUnique(List<Media> found)
    {
        foreach (var media in found)
        {
            bool exists = results.Any(existing =>
                (existing.TmdbId.HasValue && media.TmdbId.HasValue && existing.TmdbId == media.TmdbId) ||
                (existing.Title.Equals(media.Title, StringComparison.OrdinalIgnoreCase) && existing.ReleaseYear == media.ReleaseYear));

            if (!exists) results.Add(media);
        }
    }

    private bool HasAnyDisplayResults()
    {
        if (selectedFilter == "All") return results.Count > 0 || peopleResults.Count > 0;
        if (selectedFilter == "People") return peopleResults.Count > 0;

        return GetFilteredResults().Count > 0;
    }

    private List<Media> GetFilteredResults()
    {
        if (selectedFilter == "All") return results;

        var filtered = new List<Media>();
        foreach (var m in results)
        {
            bool isSeries = m is Series;

            if (selectedFilter == "Movies" && !isSeries)
                filtered.Add(m);
            else if (selectedFilter == "Series" && isSeries)
                filtered.Add(m);
            else if (selectedFilter == "Watchlist" && IsInAnyWatchlist(m))
                filtered.Add(m);
        }
        return filtered;
    }

    private int CountMovies() => results.Count(m => m is Movie);
    private int CountSeries() => results.Count(m => m is Series);
    private int CountInWatchlist() => results.Count(m => IsInAnyWatchlist(m));
    private bool IsInAnyWatchlist(Media m) => Me.Watchlists.Any(w => w.Entries.Any(e => e.Item.Id == m.Id));
    private Watchlist? GetContainingWatchlist(Media m) => Me.Watchlists.FirstOrDefault(w => w.Entries.Any(e => e.Item.Id == m.Id));
    private void PickList(Media media, string? listName) => pickedLists[media] = listName ?? "";

    private async Task AddToList(Media media)
    {
        string listName;
        if (!pickedLists.TryGetValue(media, out listName!) || string.IsNullOrEmpty(listName))
        {
            if (Me.Watchlists.Count > 0) listName = Me.Watchlists[0].Name;
            else return;
        }

        Watchlist? targetList = Me.Watchlists.FirstOrDefault(w => w.Name == listName);
        if (targetList == null) return;

        if (targetList.Entries.Any(entry => entry.Item.Id == media.Id))
        {
            Snackbar.Add($"Already in \"{listName}\"", Severity.Warning);
            return;
        }

        if (media.TmdbId.HasValue) await TmdbService.EnrichMediaDetailsAsync(media);

        DataService.GetOrAddToLibrary(media);
        Me.AddMediaToWatchlist(targetList, media, null);
        await DataService.SaveStateAsync();
        Snackbar.Add($"Added to \"{listName}\"", Severity.Success);
    }
}