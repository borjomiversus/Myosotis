@page "/search"
@inject MyosotisWeb.ServicesWeb.TmdbApiService TmdbService
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject MediaSearch SearchService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Search Archive</PageTitle>

<div class="relative w-full overflow-hidden px-margin py-space-xl">
    <div class="absolute -top-32 -left-20 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-48 right-10 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header -->
    <section class="relative z-10 flex flex-col gap-space-lg mb-space-xl">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-space-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">Search Catalog</span>
            </div>
            <div class="hidden sm:flex items-center gap-space-sm text-on-surface-variant/60 font-label-caps text-label-caps">
                <span>SORT: RELEVANCE</span>
                <span class="material-symbols-outlined text-[14px]">tune</span>
            </div>
        </div>

        <!-- Search Bar -->
        <form @onsubmit="ExecuteSearch" @onsubmit:preventDefault class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-md">
            <div class="relative flex-1 group">
                <div class="absolute inset-y-0 left-0 pl-space-md flex items-center pointer-events-none text-on-surface-variant group-focus-within:text-primary transition-colors">
                    <span class="material-symbols-outlined text-[20px]">search</span>
                </div>

                <input class="w-full pl-12 pr-12 py-space-md bg-prussian-blue/90 border border-secondary/30 rounded-lg text-body-lg font-body-lg text-on-surface placeholder:text-on-surface-variant/40 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/40 shadow-inner transition-all"
                       placeholder="Search films, actors, directors, TMDB database..."
                       type="text"
                       @bind="searchInput"
                       @bind:event="oninput" />

                @if (!string.IsNullOrEmpty(searchInput))
                {
                    <button @onclick="ClearSearch" aria-label="Clear active query" class="absolute inset-y-0 right-0 pr-space-md flex items-center text-on-surface-variant hover:text-on-surface transition-colors" type="button">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                }
            </div>
            <div class="flex items-center gap-space-sm">
                <button type="submit" class="flex items-center gap-space-xs px-space-lg py-space-md rounded-lg bg-primary text-on-primary font-title-md hover:bg-primary/80 transition-all shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">search</span>
                    <span>Search</span>
                </button>
            </div>
        </form>

        <!-- Result Stats -->
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-space-xs">
            <h1 class="font-headline-lg text-headline-lg text-on-surface">
                @(string.IsNullOrWhiteSpace(Query) ? "Catalog Archive" : "Results for ")
                @if (!string.IsNullOrWhiteSpace(Query))
                {
                    <span class="italic text-primary">“@Query”</span>
                }
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant">
                <span class="text-on-surface font-title-md">@(totalResults > 0 ? totalResults : GetFilteredResults().Count)</span> entries discovered
            </p>
        </div>

        <!-- Filter Bar -->
        @if (results.Count > 0 || peopleResults.Count > 0 || !string.IsNullOrWhiteSpace(Query))
        {
            <div class="flex items-center gap-space-xs overflow-x-auto pb-space-xs">
                <button @onclick='() => SelectFilter("All")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all shadow-sm flex items-center gap-1.5 @(selectedFilter == "All" ? "bg-primary text-on-primary" : "bg-prussian-blue/80 border border-secondary/20 text-on-surface-variant hover:border-space-indigo/50 hover:text-on-surface")">
                    <span>All</span>
                    <span class="text-[11px] opacity-75 font-label-sm">(@(totalResults > 0 ? totalResults : results.Count + peopleResults.Count))</span>
                </button>
                <button @onclick='() => SelectFilter("Movies")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all flex items-center gap-1.5 @(selectedFilter == "Movies" ? "bg-primary text-on-primary" : "bg-prussian-blue/80 border border-secondary/20 text-on-surface-variant hover:border-space-indigo/50 hover:text-on-surface")">
                    <span>Movies</span>
                    <span class="text-[11px] opacity-60 font-label-sm">(@(totalMovies > 0 ? totalMovies : CountMovies()))</span>
                </button>
                <button @onclick='() => SelectFilter("Series")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all flex items-center gap-1.5 @(selectedFilter == "Series" ? "bg-primary text-on-primary" : "bg-prussian-blue/80 border border-secondary/20 text-on-surface-variant hover:border-space-indigo/50 hover:text-on-surface")">
                    <span>TV Series</span>
                    <span class="text-[11px] opacity-60 font-label-sm">(@(totalSeries > 0 ? totalSeries : CountSeries()))</span>
                </button>
                <button @onclick='() => SelectFilter("People")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all flex items-center gap-1.5 @(selectedFilter == "People" ? "bg-primary text-on-primary" : "bg-prussian-blue/80 border border-secondary/20 text-on-surface-variant hover:border-space-indigo/50 hover:text-on-surface")">
                    <span>Actors & Directors</span>
                    <span class="text-[11px] opacity-60 font-label-sm">(@(totalPeople > 0 ? totalPeople : peopleResults.Count))</span>
                </button>
                <button @onclick='() => SelectFilter("Watchlist")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all flex items-center gap-1.5 @(selectedFilter == "Watchlist" ? "bg-primary text-on-primary" : "bg-prussian-blue/80 border border-secondary/20 text-secondary hover:border-space-indigo/50 hover:text-on-surface")">
                    <span class="material-symbols-outlined text-[14px]">bookmark</span>
                    <span>In Watchlists</span>
                    <span class="text-[11px] opacity-60 font-label-sm">(@CountInWatchlist())</span>
                </button>
            </div>
        }
    </section>

    @if (isSearching)
    {
        <div class="flex flex-col items-center justify-center py-space-xl gap-3">
            <span class="w-8 h-8 border-2 border-primary border-t-transparent rounded-full animate-spin"></span>
            <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">Querying TMDB Global Archive...</span>
        </div>
    }
    else if (HasAnyDisplayResults())
    {
        <div class="flex flex-col gap-space-lg transition-all duration-300">
            <!-- Media Cards -->
            @if (selectedFilter != "People")
            {
                @foreach (var m in GetFilteredResults())
                {
                    var containingList = GetContainingWatchlist(m);
                    bool isWatched = Me.IsWatched(m);
                    int searchTimeDebt = m.CalculateTimeDebt();
                    double? userRating = GetUserRating(m);

                    <article class="group relative bg-gradient-to-r from-prussian-blue via-prussian-blue/90 to-prussian-blue/70 rounded-xl p-space-lg sm:p-space-xl hover:border-secondary/50 transition-all duration-300 shadow-lg border border-secondary/20">
                        <div class="flex flex-col lg:flex-row gap-space-lg items-start">
                            <!-- Poster -->
                            <a href="/media/@m.Id" class="relative w-full lg:w-48 shrink-0 aspect-[2/3] rounded-lg overflow-hidden bg-prussian-blue/90 shadow-md block border border-secondary/10">
                                @if (!string.IsNullOrEmpty(m.PosterUrl))
                                {
                                    <img src="@m.PosterUrl" alt="@m.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary">
                                        <span class="material-symbols-outlined text-[48px]">movie</span>
                                    </div>
                                }
                                <div class="absolute inset-0 bg-gradient-to-t from-prussian-blue via-transparent to-transparent opacity-80"></div>
                                @if (m.TmdbRating.HasValue)
                                {
                                    <div class="absolute bottom-2 left-2 flex items-center gap-1 px-2 py-0.5 rounded-full bg-prussian-blue/90 backdrop-blur-sm text-primary font-label-caps text-label-caps border border-primary/20">
                                        <span class="material-symbols-outlined text-[12px]">star</span>
                                        <span>@m.TmdbRating.Value.ToString("0.0", En)</span>
                                    </div>
                                }
                            </a>

                            <!-- Content Column -->
                            <div class="flex flex-col flex-1 min-w-0 justify-between gap-space-md">
                                <div class="flex flex-col gap-space-xs">
                                    <div class="flex flex-wrap items-center gap-space-xs">
                                        <span class="px-space-sm py-0.5 rounded bg-prussian-blue border border-secondary/30 font-label-caps text-label-caps text-primary tracking-wider uppercase">
                                            @(m is Series ? "TV Series" : "Feature Film")
                                        </span>

                                        <span class="px-space-sm py-0.5 rounded bg-primary/10 border border-primary/20 font-label-caps text-label-caps text-primary tracking-wider uppercase flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[12px]">database</span>
                                            <span>TMDB Canon</span>
                                        </span>

                                        <span class="px-space-sm py-0.5 rounded bg-prussian-blue/50 border border-white/5 font-label-caps text-label-caps text-on-surface-variant">@m.ReleaseYear</span>

                                        @if (searchTimeDebt > 1)
                                        {
                                            <span class="px-space-sm py-0.5 rounded bg-prussian-blue/50 border border-white/5 font-label-caps text-label-caps text-on-surface-variant">
                                                @UiHelpers.FormatMinutes(searchTimeDebt)
                                            </span>
                                        }

                                        @if (m.Genres != null && m.Genres.Count > 0)
                                        {
                                            <span class="text-on-surface-variant/40 font-body-md">•</span>
                                            <span class="font-label-sm text-label-sm text-secondary tracking-wide">@string.Join(" • ", m.Genres)</span>
                                        }

                                        @if (containingList != null)
                                        {
                                            <span class="flex items-center gap-1 px-space-sm py-0.5 rounded bg-secondary/20 text-secondary text-label-sm font-label-sm border border-secondary/30 ml-auto">
                                                <span class="material-symbols-outlined text-[13px]">collections_bookmark</span>
                                                <span>In Watchlist: @containingList.Name</span>
                                            </span>
                                        }
                                        @if (isWatched)
                                        {
                                            <span class="flex items-center gap-1 px-space-sm py-0.5 rounded bg-prussian-blue text-on-surface-variant text-label-sm font-label-sm border border-secondary/20 ml-auto">
                                                <span class="material-symbols-outlined text-[13px] text-primary">check_circle</span>
                                                <span>Watched</span>
                                            </span>
                                        }
                                    </div>

                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs mt-1">
                                        <div class="flex items-center gap-space-md flex-wrap">
                                            <a href="/media/@m.Id" class="font-headline-lg text-headline-lg text-on-surface group-hover:text-primary transition-colors">
                                                @m.Title
                                            </a>

                                            @if (m.TmdbRating.HasValue)
                                            {
                                                <div class="flex items-center gap-1 text-label-sm font-label-sm text-on-surface-variant" title="TMDB Rating">
                                                    <span class="material-symbols-outlined text-[16px] text-primary">star</span>
                                                    <span class="text-on-surface font-title-md">@m.TmdbRating.Value.ToString("0.0", En)</span>
                                                    <span class="text-[10px] text-on-surface-variant/60 uppercase font-medium">TMDB</span>
                                                </div>
                                            }

                                            @if (userRating.HasValue)
                                            {
                                                <div class="flex items-center gap-1 text-label-sm font-label-sm text-tertiary" title="Your Rating">
                                                    <span class="material-symbols-outlined text-[16px] text-tertiary">grade</span>
                                                    <span class="text-tertiary font-title-md">@userRating.Value.ToString("0.0", En)</span>
                                                    <span class="text-[10px] text-tertiary/80 uppercase font-semibold">Your Rating</span>
                                                </div>
                                            }
                                        </div>

                                        @if (m.MediaDirector != null)
                                        {
                                            <span class="font-body-md text-body-md text-on-surface-variant italic">Dir. @m.MediaDirector.FullName</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(m.Description))
                                    {
                                        <p class="font-body-lg text-body-lg text-on-surface-variant/90 line-clamp-2 max-w-3xl mt-1">
                                            @m.Description
                                        </p>
                                    }
                                </div>

                                <div class="flex flex-wrap items-center justify-between gap-space-sm pt-space-md border-t border-secondary/20">
                                    <div class="flex flex-wrap items-center gap-space-sm">
                                        <a href="/media/@m.Id" class="px-space-md py-space-xs rounded-full bg-primary text-on-primary font-title-md text-title-md hover:bg-primary/80 transition-all flex items-center gap-1.5 shadow-sm">
                                            <span>View Details</span>
                                            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                        </a>

                                        @if (Me.Watchlists.Count > 0)
                                        {
                                            <div class="flex items-center gap-2">
                                                <select @onchange="e => PickList(m, e.Value?.ToString())"
                                                        class="bg-prussian-blue border border-secondary/40 rounded-lg px-3 py-1.5 text-primary font-title-md text-title-md outline-none focus:border-primary cursor-pointer transition-colors">
                                                    @foreach (var list in Me.Watchlists)
                                                    {
                                                        <option value="@list.Name" class="bg-prussian-blue text-on-surface">@list.Name</option>
                                                    }
                                                </select>
                                                <button @onclick="async () => await AddToList(m)" class="px-space-md py-space-xs rounded-lg bg-prussian-blue hover:bg-space-indigo/30 text-on-surface hover:text-primary font-title-md text-title-md transition-colors flex items-center gap-1.5 border border-secondary/40">
                                                    <span class="material-symbols-outlined text-[16px] text-primary">bookmark_add</span>
                                                    <span>+ Add</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }

            <!-- Person Cards -->
            @if (selectedFilter == "All" || selectedFilter == "People")
            {
                @if (selectedFilter == "All" && peopleResults.Count > 0)
                {
                    <div class="flex items-center gap-space-sm pt-space-md border-t border-secondary/20 mt-space-sm">
                        <span class="material-symbols-outlined text-primary text-[22px]">person_search</span>
                        <h2 class="font-headline-lg text-headline-lg text-on-surface">Actors & Directors</h2>
                    </div>
                }

                @foreach (var p in peopleResults)
                {
                    <article class="group relative bg-gradient-to-r from-prussian-blue via-prussian-blue/90 to-prussian-blue/70 rounded-xl p-space-lg sm:p-space-xl hover:border-secondary/50 transition-all duration-300 shadow-lg border border-secondary/20">
                        <div class="flex flex-col sm:flex-row gap-space-lg items-start">
                            <!-- Profile Avatar -->
                            <a href="/person/@p.Id" class="relative w-full sm:w-36 shrink-0 aspect-[2/3] rounded-lg overflow-hidden bg-prussian-blue/90 shadow-md block border border-secondary/10">
                                @if (!string.IsNullOrEmpty(p.ProfileUrl))
                                {
                                    <img src="@p.ProfileUrl" alt="@p.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary/40">
                                        <span class="material-symbols-outlined text-[48px]">person</span>
                                    </div>
                                }
                            </a>

                            <!-- Info -->
                            <div class="flex flex-col flex-1 min-w-0 justify-between gap-space-sm h-full">
                                <div class="flex flex-col gap-space-xs">
                                    <div class="flex flex-wrap items-center gap-space-xs">
                                        <span class="px-space-sm py-0.5 rounded bg-primary/10 border border-primary/20 font-label-caps text-label-caps text-primary tracking-wider uppercase">
                                            @(p.KnownForDepartment ?? "Film Industry")
                                        </span>
                                    </div>

                                    <a href="/person/@p.Id" class="font-headline-lg text-headline-lg text-on-surface group-hover:text-primary transition-colors mt-1">
                                        @p.Name
                                    </a>

                                    @if (!string.IsNullOrWhiteSpace(p.KnownForTitles))
                                    {
                                        <p class="font-body-md text-body-md text-on-surface-variant/80 mt-1">
                                            <span class="text-secondary font-medium">Known for:</span> @p.KnownForTitles
                                        </p>
                                    }
                                </div>

                                <div class="pt-space-md border-t border-secondary/20 mt-2">
                                    <a href="/person/@p.Id" class="inline-flex items-center gap-1.5 px-space-md py-space-xs rounded-full bg-primary text-on-primary font-title-md text-title-md hover:bg-primary/80 transition-all shadow-sm">
                                        <span>View Profile</span>
                                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1 && selectedFilter != "Watchlist")
        {
            <div class="flex items-center justify-center gap-space-md mt-space-xl pt-space-lg border-t border-secondary/20">
                <button disabled="@(currentPage <= 1)" @onclick="PrevPage"
                        class="px-space-md py-space-xs rounded-lg bg-prussian-blue text-on-surface hover:bg-primary hover:text-on-primary transition-all disabled:opacity-40 flex items-center gap-2 border border-secondary/30">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    <span class="font-title-md">Prev</span>
                </button>

                <div class="font-body-md text-on-surface-variant flex gap-2 items-center mx-2">
                    <span>Page</span>
                    <span class="text-on-surface font-title-md bg-prussian-blue px-3 py-1 rounded border border-secondary/40">@currentPage</span>
                    <span>of @totalPages</span>
                </div>

                <button disabled="@(currentPage >= totalPages)" @onclick="NextPage"
                        class="px-space-md py-space-xs rounded-lg bg-prussian-blue text-on-surface hover:bg-primary hover:text-on-primary transition-all disabled:opacity-40 flex items-center gap-2 border border-secondary/30">
                    <span class="font-title-md">Next</span>
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </button>
            </div>
        }
    }
    else if (!string.IsNullOrWhiteSpace(Query))
    {
        <!-- Catalog empty -->
        <div class="flex flex-col items-center justify-center py-space-xl px-space-md text-center transition-all duration-300">
            <div class="relative w-24 h-24 mb-space-md flex items-center justify-center">
                <div class="absolute inset-0 bg-primary/10 rounded-full blur-xl"></div>
                <div class="relative w-16 h-16 rounded-full bg-prussian-blue flex items-center justify-center text-on-surface-variant/50 border border-secondary/20">
                    <span class="material-symbols-outlined text-[36px] text-primary/70">hourglass_empty</span>
                </div>
            </div>
            <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase mb-space-xs">NO RESULTS FOUND</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface max-w-xl">
                The archive is silent.
            </h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md mt-space-sm mb-space-lg">
                No matches found for “<span class="text-on-surface font-semibold">@Query</span>” in your personal journal or the global TMDB catalog.
            </p>

            <div class="w-full max-w-lg p-space-md bg-prussian-blue rounded-lg text-left mb-space-lg flex flex-col gap-space-xs border border-secondary/20">
                <div class="flex items-center gap-space-xs text-secondary font-title-md text-title-md">
                    <span class="material-symbols-outlined text-[16px]">lightbulb</span>
                    <span>Search Tips</span>
                </div>
                <ul class="font-body-md text-body-md text-on-surface-variant flex flex-col gap-1 pl-5 list-disc">
                    <li>Search by atmospheric mood: <span class="text-primary italic">“Sci-Fi”</span>, <span class="text-primary italic">“Drama”</span></li>
                    <li>Query a specific auteur or actor: <span class="text-on-surface">“Christopher Nolan”</span>, <span class="text-on-surface">“Cillian Murphy”</span></li>
                    <li>Narrow by chronological eras or production year: <span class="text-on-surface">“2010”</span>, <span class="text-on-surface">“2024”</span></li>
                </ul>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-space-sm">
                <button @onclick="ClearSearch" class="px-space-lg py-space-xs rounded-full bg-primary/20 text-primary font-title-md text-title-md hover:bg-primary hover:text-on-primary transition-colors flex items-center gap-1.5 shadow-sm border border-primary/30">
                    <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                    <span>Reset Search</span>
                </button>
                <a href="/watchlists" class="px-space-lg py-space-xs rounded-lg bg-prussian-blue text-on-surface font-title-md text-title-md hover:border-space-indigo/50 transition-colors border border-secondary/30">
                    Browse Your Watchlists
                </a>
            </div>
        </div>
    }

    <footer class="mt-space-xl pt-space-md border-t border-secondary/20 flex flex-col sm:flex-row items-center justify-between gap-space-sm text-on-surface-variant/60 font-label-sm text-label-sm">
        <div class="flex items-center gap-space-xs">
            <span class="w-1 h-1 rounded-full bg-primary/70"></span>
            <span>Myosotis • @(totalResults > 0 ? totalResults : results.Count + peopleResults.Count) Active Query Matches</span>
        </div>
        <div>
            <span>Personal Journal</span>
        </div>
    </footer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "p")]
    public int PageParam { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "f")]
    public string? FilterParam { get; set; }

    private string searchInput = "";
    private string selectedFilter = "All";
    private List<Media> results = new List<Media>();
    private List<TmdbPersonSearchDto> peopleResults = new List<TmdbPersonSearchDto>();
    private bool isSearching = false;
    private string? lastLogged;
    private readonly Dictionary<Media, string> pickedLists = new Dictionary<Media, string>();
    private static readonly CultureInfo En = new CultureInfo("en-US");

    private int currentPage = 1;
    private int totalPages = 1;
    private int totalResults = 0;
    private int totalMovies = 0;
    private int totalSeries = 0;
    private int totalPeople = 0;

    private User Me => DataService.CurrentUser;

    protected override async Task OnParametersSetAsync()
    {
        results = new List<Media>();
        peopleResults = new List<TmdbPersonSearchDto>();
        searchInput = Query ?? "";
        currentPage = PageParam > 0 ? PageParam : 1;
        selectedFilter = !string.IsNullOrWhiteSpace(FilterParam) ? FilterParam : "All";

        if (string.IsNullOrWhiteSpace(Query)) return;

        isSearching = true;

        if (currentPage == 1 && selectedFilter != "People")
        {
            var allMedia = DataService.GetAllMedia();
            AddUnique(SearchService.SearchByTitle(allMedia, Query));
            AddUnique(SearchService.FilterByGenre(allMedia, Query));
            AddUnique(SearchService.SearchByActor(allMedia, Query));
        }

        try
        {
            PagedMediaResult tmdbResponse;

            switch (selectedFilter)
            {
                case "Movies":
                    tmdbResponse = await TmdbService.SearchMoviesPagedAsync(Query, currentPage);
                    break;
                case "Series":
                    tmdbResponse = await TmdbService.SearchTvPagedAsync(Query, currentPage);
                    break;
                case "People":
                    tmdbResponse = await TmdbService.SearchPeoplePagedAsync(Query, currentPage);
                    break;
                case "Watchlist":
                    // Фільтрація збережених медіа з локальної бази
                    var watchlistMedia = DataService.GetAllMedia()
                        .Where(m => IsInAnyWatchlist(m) && m.Title.Contains(Query, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    results = watchlistMedia;
                    totalPages = 1;
                    totalResults = watchlistMedia.Count;
                    isSearching = false;
                    return;
                case "All":
                default:
                    tmdbResponse = await TmdbService.SearchMediaPagedAsync(Query, currentPage);
                    break;
            }

            totalPages = tmdbResponse.TotalPages;
            totalResults = tmdbResponse.TotalResults;
            totalMovies = tmdbResponse.TotalMovies;
            totalSeries = tmdbResponse.TotalSeries;
            totalPeople = tmdbResponse.TotalPeople;
            peopleResults = tmdbResponse.People;

            foreach (var item in tmdbResponse.Results)
            {
                AddUnique(new List<Media> { item });

                bool existsInLibrary = DataService.Library.Any(libItem =>
                    (libItem.TmdbId.HasValue && item.TmdbId.HasValue && libItem.TmdbId == item.TmdbId) ||
                    (libItem.Title.Equals(item.Title, StringComparison.OrdinalIgnoreCase) && libItem.ReleaseYear == item.ReleaseYear));

                if (!existsInLibrary)
                {
                    DataService.GetOrAddToLibrary(item);
                }
            }
        }
        catch { }

        isSearching = false;

        if (Query != lastLogged && currentPage == 1)
        {
            Me.LogSearch(Query);
            lastLogged = Query;
        }
    }

    private void ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchInput))
        {
            Navigation.NavigateTo("/search");
        }
        else
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchInput)}&p=1&f={selectedFilter}");
        }
    }

    private void ClearSearch()
    {
        searchInput = "";
        Navigation.NavigateTo("/search");
    }

    private void PrevPage()
    {
        if (currentPage > 1)
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(Query!)}&p={currentPage - 1}&f={selectedFilter}");
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(Query!)}&p={currentPage + 1}&f={selectedFilter}");
    }

    private void SelectFilter(string filter)
    {
        if (selectedFilter == filter) return;

        selectedFilter = filter;
        if (!string.IsNullOrWhiteSpace(Query))
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(Query!)}&p=1&f={filter}");
        }
    }

    private void AddUnique(List<Media> found)
    {
        foreach (var media in found)
        {
            bool exists = results.Any(existing =>
                (existing.TmdbId.HasValue && media.TmdbId.HasValue && existing.TmdbId == media.TmdbId) ||
                (existing.Title.Equals(media.Title, StringComparison.OrdinalIgnoreCase) && existing.ReleaseYear == media.ReleaseYear));

            if (!exists) results.Add(media);
        }
    }

    private bool HasAnyDisplayResults()
    {
        if (selectedFilter == "All") return results.Count > 0 || peopleResults.Count > 0;
        if (selectedFilter == "People") return peopleResults.Count > 0;

        return GetFilteredResults().Count > 0;
    }

    private List<Media> GetFilteredResults()
    {
        if (selectedFilter == "All") return results;

        var filtered = new List<Media>();
        foreach (var m in results)
        {
            if (selectedFilter == "Movies" && m is Movie) filtered.Add(m);
            else if (selectedFilter == "Series" && m is Series) filtered.Add(m);
            else if (selectedFilter == "Watchlist" && IsInAnyWatchlist(m)) filtered.Add(m);
        }
        return filtered;
    }

    private double? GetUserRating(Media m)
    {
        return (double?)m.GetType().GetProperty("UserRating")?.GetValue(m)
            ?? (double?)m.GetType().GetProperty("PersonalRating")?.GetValue(m);
    }

    private int CountMovies() => results.Count(m => m is Movie);
    private int CountSeries() => results.Count(m => m is Series);
    private int CountInWatchlist() => results.Count(m => IsInAnyWatchlist(m));
    private bool IsInAnyWatchlist(Media m) => Me.Watchlists.Any(w => w.Entries.Any(e => e.Item.Id == m.Id));
    private Watchlist? GetContainingWatchlist(Media m) => Me.Watchlists.FirstOrDefault(w => w.Entries.Any(e => e.Item.Id == m.Id));
    private void PickList(Media media, string? listName) => pickedLists[media] = listName ?? "";

    private async Task AddToList(Media media)
    {
        string listName;
        if (!pickedLists.TryGetValue(media, out listName!) || string.IsNullOrEmpty(listName))
        {
            if (Me.Watchlists.Count > 0) listName = Me.Watchlists[0].Name;
            else return;
        }

        Watchlist? targetList = Me.Watchlists.FirstOrDefault(w => w.Name == listName);
        if (targetList == null) return;

        if (targetList.Entries.Any(entry => entry.Item.Id == media.Id))
        {
            Snackbar.Add($"Already in \"{listName}\"", Severity.Warning);
            return;
        }

        if (media.TmdbId.HasValue) await TmdbService.EnrichMediaDetailsAsync(media);

        DataService.GetOrAddToLibrary(media);
        Me.AddMediaToWatchlist(targetList, media, null);
        Snackbar.Add($"Added to \"{listName}\"", Severity.Success);
    }
}