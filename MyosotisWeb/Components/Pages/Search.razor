@page "/search"
@inject MyosotisWeb.ServicesWeb.TmdbApiService TmdbService
@using System.Globalization
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject MediaSearch SearchService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Myosotis · Search Archive</PageTitle>

<div class="relative w-full min-h-screen overflow-hidden px-margin py-space-xl bg-surface text-on-surface">
    <!-- Soft Background Accents (Optimized GPU rendering) -->
    <div class="absolute -top-32 -left-20 w-96 h-96 bg-primary/10 rounded-full blur-2xl pointer-events-none opacity-60"></div>
    <div class="absolute top-48 right-10 w-80 h-80 bg-secondary/10 rounded-full blur-2xl pointer-events-none opacity-60"></div>

    <!-- Header -->
    <section class="relative z-10 flex flex-col gap-space-lg mb-space-xl">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-space-sm">
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse shadow-[0_0_8px_rgba(var(--color-primary-rgb),0.8)]"></span>
                <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">Global TMDB Catalog</span>
            </div>
            <button @onclick="ToggleAdvancedPanel" type="button" class="flex items-center gap-space-xs text-on-surface-variant hover:text-primary transition-colors font-label-caps text-label-caps cursor-pointer">
                <span>ADVANCED FILTERS</span>
                <span class="material-symbols-outlined text-[16px]">tune</span>
            </button>
        </div>

        <!-- Search Bar -->
        <form @onsubmit="ExecuteSearch" @onsubmit:preventDefault class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-md">
            <div class="relative flex-1 group">
                <div class="absolute inset-y-0 left-0 pl-space-md flex items-center pointer-events-none text-on-surface-variant group-focus-within:text-primary transition-colors">
                    <span class="material-symbols-outlined text-[20px]">search</span>
                </div>

                <input class="w-full pl-12 pr-12 py-space-md bg-prussian-blue/95 border border-secondary/30 rounded-xl text-body-lg font-body-lg text-on-surface placeholder:text-on-surface-variant/40 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/40 shadow-inner transition-all"
                       placeholder="Search films, actors, directors, TMDB database..."
                       type="text"
                       @bind="searchInput" />

                @if (!string.IsNullOrEmpty(searchInput))
                {
                    <button @onclick="ClearSearch" aria-label="Clear active query" class="absolute inset-y-0 right-0 pr-space-md flex items-center text-on-surface-variant hover:text-on-surface transition-colors" type="button">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                }
            </div>
            <div class="flex items-center gap-space-sm">
                <button type="submit" class="flex items-center gap-space-xs px-space-lg py-space-md rounded-xl bg-primary text-on-primary font-title-md hover:bg-primary/80 transition-all shadow-md active:scale-95">
                    <span class="material-symbols-outlined text-[18px]">search</span>
                    <span>Search</span>
                </button>
            </div>
        </form>

        <!-- Advanced Search Panel -->
        @if (showAdvancedPanel)
        {
            <div class="mt-space-sm p-space-lg bg-prussian-blue/95 border border-primary/30 rounded-2xl shadow-2xl flex flex-col gap-space-md transition-all animate-fadeIn">
                <div class="flex items-center justify-between border-b border-secondary/20 pb-space-xs">
                    <div class="flex items-center gap-2 text-primary font-title-md">
                        <span class="material-symbols-outlined text-[18px]">tune</span>
                        <span>Advanced Search</span>
                    </div>
                    <button type="button" @onclick="ToggleAdvancedPanel" class="text-on-surface-variant hover:text-on-surface transition-colors">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                </div>

                <!-- Media Type Selection -->
                <div class="flex flex-col gap-1">
                    <label class="text-label-caps text-on-surface-variant font-label-caps">Target Content</label>
                    <div class="flex gap-2">
                        <button type="button" @onclick='() => ChangeAdvancedMediaType(SearchMediaType.All)' class="px-space-md py-1.5 rounded-lg text-title-md font-title-md transition-all @(advancedFilters.MediaType == SearchMediaType.All ? "bg-primary text-on-primary shadow-sm" : "bg-prussian-blue border border-secondary/30 text-on-surface-variant hover:text-on-surface")">All</button>
                        <button type="button" @onclick='() => ChangeAdvancedMediaType(SearchMediaType.Movies)' class="px-space-md py-1.5 rounded-lg text-title-md font-title-md transition-all @(advancedFilters.MediaType == SearchMediaType.Movies ? "bg-primary text-on-primary shadow-sm" : "bg-prussian-blue border border-secondary/30 text-on-surface-variant hover:text-on-surface")">Movies</button>
                        <button type="button" @onclick='() => ChangeAdvancedMediaType(SearchMediaType.Series)' class="px-space-md py-1.5 rounded-lg text-title-md font-title-md transition-all @(advancedFilters.MediaType == SearchMediaType.Series ? "bg-primary text-on-primary shadow-sm" : "bg-prussian-blue border border-secondary/30 text-on-surface-variant hover:text-on-surface")">TV Series</button>
                    </div>
                </div>

                <!-- Year & Rating Range Inputs -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
                    <div class="flex flex-col gap-1">
                        <label class="text-label-caps text-on-surface-variant font-label-caps">Year From</label>
                        <input type="number" placeholder="e.g. 1990" @bind="advancedFilters.YearFrom" class="px-space-md py-1.5 bg-prussian-blue border border-secondary/30 rounded-lg text-on-surface text-body-md focus:border-primary focus:ring-1 focus:ring-primary/40 outline-none" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-label-caps text-on-surface-variant font-label-caps">Year To</label>
                        <input type="number" placeholder="e.g. 2026" @bind="advancedFilters.YearTo" class="px-space-md py-1.5 bg-prussian-blue border border-secondary/30 rounded-lg text-on-surface text-body-md focus:border-primary focus:ring-1 focus:ring-primary/40 outline-none" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-label-caps text-on-surface-variant font-label-caps">Min Rating (TMDB)</label>
                        <input type="number" step="0.5" min="0" max="10" placeholder="0.0 - 10.0" @bind="advancedFilters.RatingFrom" class="px-space-md py-1.5 bg-prussian-blue border border-secondary/30 rounded-lg text-on-surface text-body-md focus:border-primary focus:ring-1 focus:ring-primary/40 outline-none" />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label class="text-label-caps text-on-surface-variant font-label-caps">Max Rating (TMDB)</label>
                        <input type="number" step="0.5" min="0" max="10" placeholder="0.0 - 10.0" @bind="advancedFilters.RatingTo" class="px-space-md py-1.5 bg-prussian-blue border border-secondary/30 rounded-lg text-on-surface text-body-md focus:border-primary focus:ring-1 focus:ring-primary/40 outline-none" />
                    </div>
                </div>

                <!-- Genres Selection -->
                @if (availableGenres.Count > 0)
                {
                    <div class="flex flex-col gap-1">
                        <label class="text-label-caps text-on-surface-variant font-label-caps">Genres</label>
                        <div class="flex flex-wrap gap-1.5 max-h-36 overflow-y-auto pr-1 custom-scrollbar">
                            @foreach (var genre in availableGenres)
                            {
                                bool isSelected = advancedFilters.SelectedGenreIds.Contains(genre.Id);
                                <button type="button" @onclick="() => ToggleGenre(genre.Id)" class="px-3 py-1 rounded-full text-label-sm font-label-sm border transition-all @(isSelected ? "bg-primary/20 border-primary text-primary font-semibold" : "bg-prussian-blue/60 border-secondary/20 text-on-surface-variant hover:border-secondary/50 hover:text-on-surface")">
                                    @genre.Name
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Keywords -->
                <div class="flex flex-col gap-2">
                    <label class="text-label-caps text-on-surface-variant font-label-caps">Keywords</label>

                    <input type="text"
                           value="@keywordInput"
                           @oninput="OnKeywordInput"
                           placeholder="Search keywords..."
                           class="w-full px-space-md py-2 bg-prussian-blue border border-secondary/30 rounded-lg text-on-surface outline-none focus:border-primary" />

                    @if (keywordSuggestions.Count > 0)
                    {
                        <div class="flex flex-col rounded-lg border border-secondary/30 overflow-hidden bg-prussian-blue/95">
                            @foreach (var keyword in keywordSuggestions)
                            {
                                <button type="button"
                                        @onclick="() => AddKeyword(keyword)"
                                        class="text-left px-3 py-2 hover:bg-primary/10 text-on-surface">
                                    @keyword.Name
                                </button>
                            }
                        </div>
                    }

                    <div class="flex flex-wrap gap-2">
                        @foreach (var keyword in advancedFilters.SelectedKeywords)
                        {
                            <span class="flex items-center gap-2 px-3 py-1 rounded-full bg-primary/15 border border-primary/30 text-primary text-sm">
                                @keyword.Name
                                <button type="button" @onclick="() => RemoveKeyword(keyword.Id)">
                                    ×
                                </button>
                            </span>
                        }
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-space-sm pt-space-xs border-t border-secondary/20">
                    <button type="button" @onclick="ResetAdvancedFilters" class="px-space-md py-space-xs rounded-lg text-on-surface-variant hover:text-on-surface text-title-md font-title-md transition-colors">
                        Reset Filters
                    </button>
                    <button type="button" @onclick="ApplyAdvancedFilters" class="px-space-lg py-space-xs rounded-lg bg-primary text-on-primary text-title-md font-title-md hover:bg-primary/80 transition-all flex items-center gap-1 shadow-md">
                        <span class="material-symbols-outlined text-[16px]">done</span>
                        <span>Apply Filters</span>
                    </button>
                </div>
            </div>
        }

        <!-- Result Stats & Heading -->
        @if (!string.IsNullOrWhiteSpace(Query) || isAdvancedMode)
        {
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-space-xs border-b border-secondary/15 pb-space-sm mt-space-md">
                <h1 class="font-headline-lg text-headline-lg text-on-surface">
                    @if (isAdvancedMode)
                    {
                        <span>Advanced Discover Results</span>
                    }
                    else
                    {
                        <span>Results for </span>
                        <span class="italic text-primary font-serif">“@Query”</span>
                    }
                </h1>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    <span class="text-on-surface font-title-md">@(totalResults > 0 ? totalResults : GetFilteredResults().Count)</span> entries discovered
                </p>
            </div>
        }

        <!-- Filter Bar -->
        @if (!isAdvancedMode && (results.Count > 0 || peopleResults.Count > 0 || !string.IsNullOrWhiteSpace(Query)))
        {
            <div class="flex items-center gap-space-xs overflow-x-auto pb-space-xs custom-scrollbar">
                <button @onclick='() => SelectFilter("All")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all shadow-sm flex items-center gap-1.5 @(selectedFilter == "All" ? "bg-primary text-on-primary" : "bg-prussian-blue/90 border border-secondary/20 text-on-surface-variant hover:border-primary/40 hover:text-on-surface")">
                    <span>All</span>
                    <span class="text-[11px] opacity-75 font-label-sm">(@(totalMovies + totalSeries + totalPeople > 0 ? totalMovies + totalSeries + totalPeople : results.Count + peopleResults.Count))</span>
                </button>
                <button @onclick='() => SelectFilter("Movies")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all flex items-center gap-1.5 @(selectedFilter == "Movies" ? "bg-primary text-on-primary" : "bg-prussian-blue/90 border border-secondary/20 text-on-surface-variant hover:border-primary/40 hover:text-on-surface")">
                    <span>Movies</span>
                    <span class="text-[11px] opacity-60 font-label-sm">(@(totalMovies > 0 ? totalMovies : CountMovies()))</span>
                </button>
                <button @onclick='() => SelectFilter("Series")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all flex items-center gap-1.5 @(selectedFilter == "Series" ? "bg-primary text-on-primary" : "bg-prussian-blue/90 border border-secondary/20 text-on-surface-variant hover:border-primary/40 hover:text-on-surface")">
                    <span>TV Series</span>
                    <span class="text-[11px] opacity-60 font-label-sm">(@(totalSeries > 0 ? totalSeries : CountSeries()))</span>
                </button>
                <button @onclick='() => SelectFilter("People")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all flex items-center gap-1.5 @(selectedFilter == "People" ? "bg-primary text-on-primary" : "bg-prussian-blue/90 border border-secondary/20 text-on-surface-variant hover:border-primary/40 hover:text-on-surface")">
                    <span>Actors & Directors</span>
                    <span class="text-[11px] opacity-60 font-label-sm">(@(totalPeople > 0 ? totalPeople : peopleResults.Count))</span>
                </button>
                <button @onclick='() => SelectFilter("Watchlist")' class="px-space-md py-1.5 rounded-full font-title-md text-title-md transition-all flex items-center gap-1.5 @(selectedFilter == "Watchlist" ? "bg-primary text-on-primary" : "bg-prussian-blue/90 border border-secondary/20 text-secondary hover:border-primary/40 hover:text-on-surface")">
                    <span class="material-symbols-outlined text-[14px]">bookmark</span>
                    <span>In Watchlists</span>
                    <span class="text-[11px] opacity-60 font-label-sm">(@CountInWatchlist())</span>
                </button>
            </div>
        }
    </section>

    <!-- Main Results Section -->
    @if (isSearching)
    {
        <div class="flex flex-col items-center justify-center py-space-xl gap-4">
            <div class="w-10 h-10 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
            <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">Querying TMDB Global Archive...</span>
        </div>
    }
    else if (HasAnyDisplayResults())
    {
        <div class="flex flex-col gap-space-lg transition-all duration-300">
            <!-- Media Cards -->
            @if (selectedFilter != "People")
            {
                @foreach (var m in GetFilteredResults())
                {
                    var containingList = GetContainingWatchlist(m);
                    bool isWatched = Me.IsWatched(m);
                    int searchTimeDebt = m.CalculateTimeDebt();
                    double? userRating = GetUserRating(m);

                    <article class="group relative bg-prussian-blue/90 rounded-2xl p-space-lg sm:p-space-xl hover:border-primary/50 transition-all duration-300 shadow-lg border border-secondary/25">
                        <div class="flex flex-col lg:flex-row gap-space-lg items-start">
                            <!-- Poster -->
                            <a href="/media/@m.Id" class="relative w-full lg:w-48 shrink-0 aspect-[2/3] rounded-xl overflow-hidden bg-prussian-blue shadow-md block border border-secondary/20 group/poster">
                                @if (!string.IsNullOrEmpty(m.PosterUrl))
                                {
                                    <img src="@m.PosterUrl" alt="@m.Title" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover/poster:scale-105 transition-transform duration-500 ease-out" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary/40">
                                        <span class="material-symbols-outlined text-[48px]">movie</span>
                                    </div>
                                }
                                <div class="absolute inset-0 bg-gradient-to-t from-prussian-blue via-transparent to-transparent opacity-80"></div>
                            </a>

                            <!-- Content Column -->
                            <div class="flex flex-col flex-1 min-w-0 justify-between gap-space-md w-full">
                                <div class="flex flex-col gap-space-xs">
                                    <!-- Badges & Tags -->
                                    <div class="flex flex-wrap items-center gap-space-xs w-full">
                                        <span class="px-space-sm py-0.5 rounded-md bg-primary/15 border border-primary/30 font-label-caps text-label-caps text-primary tracking-wider uppercase">
                                            @(m is Series ? "TV Series" : "Feature Film")
                                        </span>

                                        <span class="px-space-sm py-0.5 rounded-md bg-prussian-blue border border-secondary/30 font-label-caps text-label-caps text-on-surface font-semibold">
                                            @m.ReleaseYear
                                        </span>

                                        @if (searchTimeDebt > 1)
                                        {
                                            <span class="px-space-sm py-0.5 rounded-md bg-prussian-blue border border-secondary/30 font-label-caps text-label-caps text-on-surface-variant font-medium">
                                                @UiHelpers.FormatMinutes(searchTimeDebt)
                                            </span>
                                        }

                                        @if (m.Genres != null && m.Genres.Count > 0)
                                        {
                                            <span class="text-on-surface-variant/40 font-body-md">•</span>
                                            <span class="font-label-sm text-label-sm text-secondary tracking-wide">@string.Join(" • ", m.Genres)</span>
                                        }

                                        <!-- User Status Badges -->
                                        <div class="flex items-center gap-2 ml-auto flex-wrap">
                                            @if (Me.IsFavorite(m))
                                            {
                                                <span class="flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-tertiary/15 text-tertiary text-label-sm font-label-sm border border-tertiary/30 shadow-sm" title="Favorite">
                                                    <span class="material-symbols-outlined text-[14px] text-tertiary" style="font-variation-settings: 'FILL' 1;">favorite</span>
                                                    <span>Favorite</span>
                                                </span>
                                            }

                                            @if (containingList != null)
                                            {
                                                <span class="flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-primary/15 text-primary text-label-sm font-label-sm border border-primary/30 shadow-sm">
                                                    <span class="material-symbols-outlined text-[14px] text-primary">bookmark</span>
                                                    <span>In Watchlist: @containingList.Name</span>
                                                </span>
                                            }

                                            @if (isWatched)
                                            {
                                                <span class="flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-secondary/20 text-on-surface text-label-sm font-label-sm border border-secondary/40 shadow-sm">
                                                    <span class="material-symbols-outlined text-[14px] text-secondary">check_circle</span>
                                                    <span>Watched</span>
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Title & Ratings -->
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs mt-1">
                                        <div class="flex items-center gap-space-md flex-wrap">
                                            <a href="/media/@m.Id" class="font-headline-lg text-headline-lg text-on-surface group-hover:text-primary transition-colors">
                                                @m.Title
                                            </a>

                                            @if (m.TmdbRating.HasValue)
                                            {
                                                <div class="flex items-center gap-1 px-2 py-0.5 rounded-md bg-prussian-blue/90 border border-secondary/30 text-label-sm font-label-sm" title="TMDB Rating">
                                                    <span class="material-symbols-outlined text-[16px] text-primary" style="font-variation-settings: 'FILL' 1;">star</span>
                                                    <span class="text-on-surface font-title-md font-bold">@m.TmdbRating.Value.ToString("0.0", En)</span>
                                                    <span class="text-[10px] text-on-surface-variant/60 uppercase font-medium">TMDB</span>
                                                </div>
                                            }

                                            @if (m.Vibe != null)
                                            {
                                                var vibeAverage = m.Vibe.CalculateAverage();
                                                @if (vibeAverage > 0)
                                                {
                                                    <div class="flex items-center gap-1 px-2 py-0.5 rounded-md bg-tertiary/10 border border-tertiary/30 text-label-sm font-label-sm" title="Personal Vibe Rating">
                                                        <span class="material-symbols-outlined text-[16px] text-tertiary">star_shine</span>
                                                        <span class="text-tertiary font-title-md font-bold">@vibeAverage.ToString("0.0", En)</span>
                                                        <span class="text-[10px] text-tertiary/80 uppercase font-semibold">Vibe</span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(m.Description))
                                    {
                                        <p class="font-body-lg text-body-lg text-on-surface-variant/90 line-clamp-2 max-w-3xl mt-1 leading-relaxed">
                                            @m.Description
                                        </p>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="flex flex-wrap items-center justify-between gap-space-sm pt-space-md border-t border-secondary/20 mt-space-xs">
                                    <div class="flex flex-wrap items-center gap-space-sm w-full sm:w-auto justify-between sm:justify-start">
                                        <a href="/media/@m.Id" class="px-space-md py-space-xs rounded-xl bg-primary text-on-primary font-title-md text-title-md hover:bg-primary/80 transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                                            <span>View Details</span>
                                            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                        </a>

                                        @if (Me.Watchlists.Count > 0)
                                        {
                                            <div class="flex items-center gap-2">
                                                <select @onchange="e => PickList(m, e.Value?.ToString())"
                                                        class="bg-prussian-blue border border-secondary/40 rounded-xl px-3 py-1.5 text-primary font-title-md text-title-md outline-none focus:border-primary cursor-pointer transition-colors">
                                                    @foreach (var list in Me.Watchlists)
                                                    {
                                                        <option value="@list.Name" class="bg-prussian-blue text-on-surface">@list.Name</option>
                                                    }
                                                </select>
                                                <button @onclick="async () => await AddToList(m)" class="px-space-md py-space-xs rounded-xl bg-prussian-blue hover:bg-primary/20 text-on-surface hover:text-primary font-title-md text-title-md transition-all flex items-center gap-1.5 border border-secondary/40 active:scale-95">
                                                    <span class="material-symbols-outlined text-[16px] text-primary">bookmark_add</span>
                                                    <span>+ Add</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }

            <!-- Person Cards -->
            @if (selectedFilter == "All" || selectedFilter == "People")
            {
                @foreach (var p in peopleResults)
                {
                    <article class="group relative bg-prussian-blue/90 rounded-2xl p-space-lg sm:p-space-xl hover:border-primary/50 transition-all duration-300 shadow-lg border border-secondary/25">
                        <div class="flex flex-col sm:flex-row gap-space-lg items-start">
                            <!-- Profile Avatar -->
                            <a href="/person/@p.Id" class="relative w-full sm:w-36 shrink-0 aspect-[2/3] rounded-xl overflow-hidden bg-prussian-blue shadow-md block border border-secondary/20 group/avatar">
                                @if (!string.IsNullOrEmpty(p.ProfileUrl))
                                {
                                    <img src="@p.ProfileUrl" alt="@p.Name" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover/avatar:scale-105 transition-transform duration-500 ease-out" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary/40">
                                        <span class="material-symbols-outlined text-[48px]">person</span>
                                    </div>
                                }
                            </a>

                            <!-- Info -->
                            <div class="flex flex-col flex-1 min-w-0 justify-between gap-space-sm h-full">
                                <div class="flex flex-col gap-space-xs">
                                    <div class="flex flex-wrap items-center gap-space-xs">
                                        <span class="px-space-sm py-0.5 rounded-md bg-primary/10 border border-primary/20 font-label-caps text-label-caps text-primary tracking-wider uppercase">
                                            @(p.KnownForDepartment ?? "Film Industry")
                                        </span>
                                    </div>

                                    <a href="/person/@p.Id" class="font-headline-lg text-headline-lg text-on-surface group-hover:text-primary transition-colors mt-1">
                                        @p.Name
                                    </a>

                                    @if (!string.IsNullOrWhiteSpace(p.KnownForTitles))
                                    {
                                        <p class="font-body-md text-body-md text-on-surface-variant/80 mt-1">
                                            <span class="text-secondary font-medium">Known for:</span> @p.KnownForTitles
                                        </p>
                                    }
                                </div>

                                <div class="pt-space-md border-t border-secondary/20 mt-2">
                                    <a href="/person/@p.Id" class="inline-flex items-center gap-1.5 px-space-md py-space-xs rounded-xl bg-primary text-on-primary font-title-md text-title-md hover:bg-primary/80 transition-all shadow-sm active:scale-95">
                                        <span>View Profile</span>
                                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1 && selectedFilter != "Watchlist")
        {
            <div class="flex items-center justify-center gap-space-md mt-space-xl pt-space-lg border-t border-secondary/20">
                <button disabled="@(currentPage <= 1)" @onclick="PrevPage"
                        class="px-space-md py-space-xs rounded-xl bg-prussian-blue text-on-surface hover:bg-primary hover:text-on-primary transition-all disabled:opacity-40 flex items-center gap-2 border border-secondary/30 active:scale-95">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    <span class="font-title-md">Prev</span>
                </button>

                <div class="font-body-md text-on-surface-variant flex gap-2 items-center mx-2">
                    <span>Page</span>
                    <span class="text-on-surface font-title-md bg-prussian-blue px-3 py-1 rounded-lg border border-secondary/40 shadow-inner">@currentPage</span>
                    <span>of @totalPages</span>
                </div>

                <button disabled="@(currentPage >= totalPages)" @onclick="NextPage"
                        class="px-space-md py-space-xs rounded-xl bg-prussian-blue text-on-surface hover:bg-primary hover:text-on-primary transition-all disabled:opacity-40 flex items-center gap-2 border border-secondary/30 active:scale-95">
                    <span class="font-title-md">Next</span>
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </button>
            </div>
        }
    }
    else if (!string.IsNullOrWhiteSpace(Query) || isAdvancedMode)
    {
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center py-space-xl px-space-md text-center transition-all duration-300 mb-space-xl">
            <div class="relative w-24 h-24 mb-space-md flex items-center justify-center">
                <div class="absolute inset-0 bg-primary/20 rounded-full blur-xl"></div>
                <div class="relative w-16 h-16 rounded-2xl bg-prussian-blue/90 flex items-center justify-center text-on-surface-variant/50 border border-secondary/20 shadow-lg">
                    <span class="material-symbols-outlined text-[36px] text-primary/70">hourglass_empty</span>
                </div>
            </div>
            <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase mb-space-xs">NO RESULTS FOUND</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface max-w-xl">
                The archive is silent.
            </h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md mt-space-sm mb-space-lg">
                No matches found for your active criteria in the catalog.
            </p>

            <div class="flex flex-wrap items-center justify-center gap-space-sm">
                <button @onclick="ClearSearch" class="px-space-lg py-space-xs rounded-xl bg-primary/20 text-primary font-title-md text-title-md hover:bg-primary hover:text-on-primary transition-all flex items-center gap-1.5 shadow-sm border border-primary/30 active:scale-95">
                    <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                    <span>Reset Search</span>
                </button>
            </div>
        </div>
    }
    else
    {
        @if (trendingMedia.Count > 0)
        {
            <div class="mt-space-md">
                <div class="flex items-center justify-between mb-space-md">
                    <div class="flex items-center gap-space-sm">
                        <span class="material-symbols-outlined text-primary text-[24px]">trending_up</span>
                        <h2 class="font-headline-lg text-headline-lg text-on-surface">Trending Now</h2>
                    </div>
                    <span class="font-label-caps text-label-caps text-on-surface-variant">Popular this week</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-space-md">
                    @foreach (var media in trendingMedia.Take(18))
                    {
                        <a href="/media/@media.Id" class="group flex flex-col gap-2 bg-prussian-blue/60 border border-secondary/20 rounded-xl p-2 hover:border-primary/50 transition-all duration-300">
                            <div class="aspect-[2/3] w-full rounded-lg overflow-hidden bg-prussian-blue relative">
                                @if (!string.IsNullOrEmpty(media.PosterUrl))
                                {
                                    <img src="@media.PosterUrl" alt="@media.Title" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-secondary/40">
                                        <span class="material-symbols-outlined text-[32px]">movie</span>
                                    </div>
                                }
                                @if (media.TmdbRating.HasValue)
                                {
                                    <div class="absolute top-2 right-2 px-1.5 py-0.5 rounded bg-prussian-blue/95 border border-secondary/30 text-primary text-[11px] font-bold flex items-center gap-0.5">
                                        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                        <span>@media.TmdbRating.Value.ToString("0.0", En)</span>
                                    </div>
                                }
                            </div>
                            <div class="flex flex-col">
                                <span class="font-title-md text-title-md text-on-surface truncate group-hover:text-primary transition-colors">@media.Title</span>
                                <span class="font-label-sm text-label-sm text-on-surface-variant">@media.ReleaseYear</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    }

    <!-- Footer -->
    <footer class="mt-space-xl pt-space-md border-t border-secondary/20 flex flex-col sm:flex-row items-center justify-between gap-space-sm text-on-surface-variant/60 font-label-sm text-label-sm">
        <div class="flex items-center gap-space-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-primary/70"></span>
            <span>Myosotis • @(totalResults > 0 ? totalResults : results.Count + peopleResults.Count) Active Query Matches</span>
        </div>
        <div>
            <span>Personal Journal</span>
        </div>
    </footer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "p")]
    public int PageParam { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "f")]
    public string? FilterParam { get; set; }

    [SupplyParameterFromQuery(Name = "adv")]
    public bool AdvParam { get; set; } = false;

    private string searchInput = "";
    private string selectedFilter = "All";
    private List<Media> results = new List<Media>();
    private List<TmdbPersonSearchDto> peopleResults = new List<TmdbPersonSearchDto>();
    private List<Media> trendingMedia = new List<Media>();
    private bool isSearching = false;
    private string? lastLogged;
    private readonly Dictionary<Media, string> pickedLists = new Dictionary<Media, string>();
    private static readonly CultureInfo En = new CultureInfo("en-US");

    // Advanced Search state
    private bool showAdvancedPanel = false;
    private bool isAdvancedMode = false;
    private AdvancedSearchFilters advancedFilters = new AdvancedSearchFilters();
    private List<TmdbGenreDto> availableGenres = new List<TmdbGenreDto>();
    private AdvancedSearchFilters? appliedAdvancedFilters;
    private string keywordInput = "";
    private List<TmdbKeywordItemDto> keywordSuggestions = new();

    private int currentPage = 1;
    private int totalPages = 1;
    private int totalResults = 0;
    private int totalMovies = 0;
    private int totalSeries = 0;
    private int totalPeople = 0;

    private User Me => DataService.CurrentUser;

    protected override async Task OnInitializedAsync()
    {
        var rawTrending = await TmdbService.GetTrendingMediaAsync();
        trendingMedia.Clear();

        foreach (var media in rawTrending)
        {
            var existing = DataService.Library.FirstOrDefault(libItem =>
                (libItem.TmdbId.HasValue && media.TmdbId.HasValue && libItem.TmdbId == media.TmdbId) ||
                (libItem.Title.Equals(media.Title, StringComparison.OrdinalIgnoreCase) && libItem.ReleaseYear == media.ReleaseYear));

            if (existing != null)
            {
                trendingMedia.Add(existing);
            }
            else
            {
                DataService.GetOrAddToLibrary(media);
                trendingMedia.Add(media);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        results = new List<Media>();
        peopleResults = new List<TmdbPersonSearchDto>();
        searchInput = Query ?? "";
        currentPage = PageParam > 0 ? PageParam : 1;
        selectedFilter = !string.IsNullOrWhiteSpace(FilterParam) ? FilterParam : "All";
        isAdvancedMode = AdvParam;

        if (availableGenres.Count == 0)
        {
            availableGenres = await TmdbService.GetAllGenresAsync();
        }

        if (isAdvancedMode)
        {
            if (appliedAdvancedFilters == null)
            {
                isAdvancedMode = false;
                return;
            }

            await LoadAdvancedResultsAsync(currentPage);
            return;
        }

        if (string.IsNullOrWhiteSpace(Query)) return;

        isSearching = true;

        if (currentPage == 1 && selectedFilter != "People")
        {
            var allMedia = DataService.GetAllMedia();
            AddUnique(SearchService.SearchByTitle(allMedia, Query));
            AddUnique(SearchService.FilterByGenre(allMedia, Query));
            AddUnique(SearchService.SearchByActor(allMedia, Query));
        }

        try
        {
            PagedMediaResult tmdbResponse;

            switch (selectedFilter)
            {
                case "Movies":
                    tmdbResponse = await TmdbService.SearchMoviesPagedAsync(Query, currentPage);
                    break;
                case "Series":
                    tmdbResponse = await TmdbService.SearchTvPagedAsync(Query, currentPage);
                    break;
                case "People":
                    tmdbResponse = await TmdbService.SearchPeoplePagedAsync(Query, currentPage);
                    break;
                case "Watchlist":
                    var watchlistMedia = DataService.GetAllMedia()
                        .Where(m => IsInAnyWatchlist(m) && m.Title.Contains(Query, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    results = watchlistMedia;
                    totalPages = 1;
                    totalResults = watchlistMedia.Count;
                    isSearching = false;
                    return;
                case "All":
                default:
                    tmdbResponse = await TmdbService.SearchMediaPagedAsync(Query, currentPage);
                    break;
            }

            ApplyPagedResult(tmdbResponse);
        }
        catch { }

        isSearching = false;

        if (Query != lastLogged && currentPage == 1)
        {
            Me.LogSearch(Query);
            lastLogged = Query;
        }
    }

    private void ApplyPagedResult(PagedMediaResult tmdbResponse)
    {
        totalPages = tmdbResponse.TotalPages;
        totalResults = tmdbResponse.TotalResults;
        totalMovies = tmdbResponse.TotalMovies;
        totalSeries = tmdbResponse.TotalSeries;
        totalPeople = tmdbResponse.TotalPeople;
        peopleResults = tmdbResponse.People;

        foreach (var item in tmdbResponse.Results)
        {
            AddUnique(new List<Media> { item });

            bool existsInLibrary = DataService.Library.Any(libItem =>
                (libItem.TmdbId.HasValue && item.TmdbId.HasValue && libItem.TmdbId == item.TmdbId) ||
                (libItem.Title.Equals(item.Title, StringComparison.OrdinalIgnoreCase) && libItem.ReleaseYear == item.ReleaseYear));

            if (!existsInLibrary)
            {
                DataService.GetOrAddToLibrary(item);
            }
        }
    }

    private async Task ToggleAdvancedPanel()
    {
        showAdvancedPanel = !showAdvancedPanel;
        if (showAdvancedPanel && availableGenres.Count == 0)
        {
            availableGenres = await TmdbService.GetAllGenresAsync();
        }
    }

    private async Task ChangeAdvancedMediaType(SearchMediaType type)
    {
        if (advancedFilters.MediaType == type)
            return;

        advancedFilters.MediaType = type;
        advancedFilters.SelectedGenreIds.Clear();

        if (type == SearchMediaType.Movies)
            availableGenres = await TmdbService.GetMovieGenresAsync();
        else if (type == SearchMediaType.Series)
            availableGenres = await TmdbService.GetTvGenresAsync();
        else
            availableGenres = await TmdbService.GetAllGenresAsync();

        StateHasChanged();
    }

    private void ToggleGenre(int genreId)
    {
        if (advancedFilters.SelectedGenreIds.Contains(genreId))
            advancedFilters.SelectedGenreIds.Remove(genreId);
        else
            advancedFilters.SelectedGenreIds.Add(genreId);
    }

    private async Task OnKeywordInput(ChangeEventArgs e)
    {
        keywordInput = e.Value?.ToString() ?? "";

        if (keywordInput.Trim().Length < 2)
        {
            keywordSuggestions.Clear();
            return;
        }

        try
        {
            keywordSuggestions = await TmdbService.SearchKeywordsAutocompleteAsync(
                keywordInput.Trim());

            keywordSuggestions = keywordSuggestions
                .Where(k => !advancedFilters.SelectedKeywords.Any(s => s.Id == k.Id))
                .ToList();
        }
        catch
        {
            keywordSuggestions.Clear();
        }
    }

    private void AddKeyword(TmdbKeywordItemDto keyword)
    {
        if (!advancedFilters.SelectedKeywords.Any(k => k.Id == keyword.Id))
        {
            advancedFilters.SelectedKeywords.Add(new SelectedKeyword
            {
                Id = keyword.Id,
                Name = keyword.Name
            });
        }

        keywordInput = "";
        keywordSuggestions.Clear();
    }

    private void RemoveKeyword(int id)
    {
        advancedFilters.SelectedKeywords.RemoveAll(k => k.Id == id);
    }

    private async Task ApplyAdvancedFilters()
    {
        if (advancedFilters.YearFrom.HasValue &&
            advancedFilters.YearTo.HasValue &&
            advancedFilters.YearFrom > advancedFilters.YearTo)
        {
            Snackbar.Add(
                "Starting year cannot be greater than ending year.",
                Severity.Warning);
            return;
        }

        if (advancedFilters.RatingFrom.HasValue &&
            advancedFilters.RatingTo.HasValue &&
            advancedFilters.RatingFrom > advancedFilters.RatingTo)
        {
            Snackbar.Add(
                "Minimum rating cannot be greater than maximum rating.",
                Severity.Warning);
            return;
        }

        appliedAdvancedFilters = advancedFilters.Clone();

        isAdvancedMode = true;
        showAdvancedPanel = false;

        await LoadAdvancedResultsAsync(1);
    }

    private async Task LoadAdvancedResultsAsync(int page)
    {
        if (appliedAdvancedFilters == null)
            return;

        isSearching = true;

        try
        {
            var response = await TmdbService.DiscoverMediaPagedAsync(
                appliedAdvancedFilters,
                page);

            results.Clear();
            peopleResults.Clear();

            ApplyPagedResult(response);

            currentPage = response.CurrentPage;
            totalPages = response.TotalPages;
            totalResults = response.TotalResults;
            totalMovies = response.TotalMovies;
            totalSeries = response.TotalSeries;
            totalPeople = response.TotalPeople;
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Advanced search failed: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            isSearching = false;
        }
    }

    private void ResetAdvancedFilters()
    {
        advancedFilters.Clear();
        appliedAdvancedFilters = null;

        keywordInput = "";
        keywordSuggestions.Clear();

        results.Clear();
        peopleResults.Clear();

        totalResults = 0;
        totalPages = 1;
        currentPage = 1;

        isAdvancedMode = false;
    }

    private void ExecuteSearch()
    {
        isAdvancedMode = false;
        if (string.IsNullOrWhiteSpace(searchInput))
        {
            Navigation.NavigateTo("/search");
        }
        else
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchInput)}&p=1&f={selectedFilter}");
        }
    }

    private void ClearSearch()
    {
        searchInput = "";
        isAdvancedMode = false;
        advancedFilters.Clear();
        Navigation.NavigateTo("/search");
    }

    private async Task PrevPage()
    {
        if (currentPage <= 1)
            return;

        if (isAdvancedMode)
        {
            await LoadAdvancedResultsAsync(currentPage - 1);
            return;
        }

        Navigation.NavigateTo(
            $"/search?q={Uri.EscapeDataString(Query!)}&p={currentPage - 1}&f={selectedFilter}");
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages)
            return;

        if (isAdvancedMode)
        {
            await LoadAdvancedResultsAsync(currentPage + 1);
            return;
        }

        Navigation.NavigateTo(
            $"/search?q={Uri.EscapeDataString(Query!)}&p={currentPage + 1}&f={selectedFilter}");
    }

    private void SelectFilter(string filter)
    {
        if (selectedFilter == filter) return;

        selectedFilter = filter;
        if (!string.IsNullOrWhiteSpace(Query))
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(Query!)}&p=1&f={filter}");
        }
    }

    private void AddUnique(List<Media> found)
    {
        foreach (var media in found)
        {
            bool exists = results.Any(existing =>
                (existing.TmdbId.HasValue && media.TmdbId.HasValue && existing.TmdbId == media.TmdbId) ||
                (existing.Title.Equals(media.Title, StringComparison.OrdinalIgnoreCase) && existing.ReleaseYear == media.ReleaseYear));

            if (!exists) results.Add(media);
        }
    }

    private bool HasAnyDisplayResults()
    {
        if (selectedFilter == "All") return results.Count > 0 || peopleResults.Count > 0;
        if (selectedFilter == "People") return peopleResults.Count > 0;

        return GetFilteredResults().Count > 0;
    }

    private List<Media> GetFilteredResults()
    {
        if (selectedFilter == "All") return results;

        var filtered = new List<Media>();
        foreach (var m in results)
        {
            bool isSeries = m is Series;

            if (selectedFilter == "Movies" && !isSeries)
                filtered.Add(m);
            else if (selectedFilter == "Series" && isSeries)
                filtered.Add(m);
            else if (selectedFilter == "Watchlist" && IsInAnyWatchlist(m))
                filtered.Add(m);
        }
        return filtered;
    }

    private double? GetUserRating(Media m)
    {
        return (double?)m.GetType().GetProperty("UserRating")?.GetValue(m)
            ?? (double?)m.GetType().GetProperty("PersonalRating")?.GetValue(m);
    }

    private int CountMovies() => results.Count(m => m is Movie);
    private int CountSeries() => results.Count(m => m is Series);
    private int CountInWatchlist() => results.Count(m => IsInAnyWatchlist(m));
    private bool IsInAnyWatchlist(Media m) => Me.Watchlists.Any(w => w.Entries.Any(e => e.Item.Id == m.Id));
    private Watchlist? GetContainingWatchlist(Media m) => Me.Watchlists.FirstOrDefault(w => w.Entries.Any(e => e.Item.Id == m.Id));
    private void PickList(Media media, string? listName) => pickedLists[media] = listName ?? "";

    private async Task AddToList(Media media)
    {
        string listName;
        if (!pickedLists.TryGetValue(media, out listName!) || string.IsNullOrEmpty(listName))
        {
            if (Me.Watchlists.Count > 0) listName = Me.Watchlists[0].Name;
            else return;
        }

        Watchlist? targetList = Me.Watchlists.FirstOrDefault(w => w.Name == listName);
        if (targetList == null) return;

        if (targetList.Entries.Any(entry => entry.Item.Id == media.Id))
        {
            Snackbar.Add($"Already in \"{listName}\"", Severity.Warning);
            return;
        }

        if (media.TmdbId.HasValue) await TmdbService.EnrichMediaDetailsAsync(media);

        DataService.GetOrAddToLibrary(media);
        Me.AddMediaToWatchlist(targetList, media, null);
        Snackbar.Add($"Added to \"{listName}\"", Severity.Success);
    }
}