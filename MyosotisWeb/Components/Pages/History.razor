@page "/history"
@using System.Globalization
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService

<PageTitle>Myosotis · History</PageTitle>

<div class="w-full px-margin py-margin flex flex-col gap-10">


    @{
        var now = DateTime.Now;
        int monthMinutes = Me.GetMonthlyStats(now.Year, now.Month);
        int monthTitles = Me.GetMonthlyWatchCount(now.Year, now.Month);
        int totalTitles = Me.WatchHistory.Count(h => h.Action == ActivityAction.Watched);

        var groupedEntries = Me.WatchHistory
            .Where(h => h.Action == ActivityAction.Watched)
            .OrderByDescending(h => h.WatchDate)
            .GroupBy(h => h.WatchDate.Date)
            .Select(group => new
            {
                Date = group.Key,
                Entries = group.ToList()
            })
            .ToList();
    }

    <!-- Заголовок без дашборд-карток -->
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-secondary/25">
        <div class="flex flex-col gap-2">
            <h1 class="font-headline-xl-mobile md:font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-surface leading-none">
                History
            </h1>
            <p class="font-body-md text-[14px] text-secondary-text">
                Everything you’ve watched, all in one place.
            </p>
        </div>

        @if (totalTitles > 0)
        {
            <div class="font-body-md text-[13px] text-secondary-text flex flex-wrap items-center gap-2">
                <span>
                    <strong class="text-on-surface font-semibold">@monthTitles</strong> watched in @now.ToString("MMMM", En)
                </span>
                @if (monthMinutes > 0)
                {
                    <span class="text-secondary/40">·</span>
                    <span>@UiHelpers.FormatMinutes(monthMinutes)</span>
                }
                <span class="text-secondary/40">·</span>
                <span><strong class="text-on-surface font-semibold">@totalTitles</strong> all-time</span>
            </div>
        }
    </header>

    @if (groupedEntries.Count == 0)
    {
        <!-- Порожній стан (чистий текст, місце під власний SVG у майбутньому) -->
        <div class="flex flex-col items-center justify-center py-20 text-center max-w-md mx-auto">
            <p class="font-body-md text-[14px] text-secondary-text leading-relaxed">
                Nothing watched yet. Mark a title as watched from its details page.
            </p>
        </div>
    }
    else
    {
        <!-- Хронологічний каталог без важких коробок -->
        <div class="flex flex-col gap-10">
            @foreach (var group in groupedEntries)
            {
                <section class="flex flex-col">
                    <div class="flex items-baseline justify-between pb-2.5 mb-2 border-b border-secondary/25">
                        <h2 class="font-serif text-[18px] text-on-surface">
                            @group.Date.ToString("MMMM d, yyyy", En)
                        </h2>
                        <span class="font-label-sm text-[11px] text-secondary-text">
                            @group.Date.ToString("dddd", En)
                        </span>
                    </div>

                    <div class="flex flex-col divide-y divide-secondary/15">
                        @foreach (var h in group.Entries)
                        {
                            var item = h.WatchedItem;
                            int duration = item.TotalDurationMinutes > 0 ? item.TotalDurationMinutes : item.CalculateTimeDebt();

                            <div class="py-4 px-2 -mx-2 rounded-lg hover:bg-surface-variant/25 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4 group">

                                <a href="/media/@item.Id" class="flex items-center gap-4 min-w-0 flex-1">
                                    @if (!string.IsNullOrEmpty(item.PosterUrl))
                                    {
                                        <div class="w-12 h-[72px] flex-shrink-0 rounded bg-cover bg-center border border-secondary/30 group-hover:border-primary/60 transition-colors"
                                             style="@UiHelpers.CardBackground(item.PosterUrl)">
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-[72px] flex-shrink-0 rounded bg-surface-variant/30 border border-secondary/25 flex items-center justify-center text-secondary-text text-[11px] font-body-md">
                                            —
                                        </div>
                                    }

                                    <div class="flex flex-col min-w-0 gap-1">
                                        <div class="flex items-baseline gap-2 flex-wrap">
                                            <span class="font-serif font-semibold text-[18px] text-on-surface group-hover:text-primary transition-colors truncate">
                                                @item.Title
                                            </span>
                                            <span class="font-body-md text-[13px] text-secondary-text">
                                                (@item.ReleaseYear)
                                            </span>
                                            @if (Me.IsFavorite(item))
                                            {
                                                <span class="material-symbols-outlined text-[15px] text-tertiary self-center"
                                                      style="font-variation-settings: 'FILL' 1;"
                                                      title="Favorite">
                                                    favorite
                                                </span>
                                            }
                                        </div>

                                        <div class="flex items-center gap-2 text-secondary-text font-body-md text-[12px] flex-wrap">
                                            <span>@(item is Series ? "Series" : "Movie")</span>

                                            @if (duration > 1)
                                            {
                                                <span class="text-secondary/40">·</span>
                                                <span>@UiHelpers.FormatMinutes(duration)</span>
                                            }

                                            <span class="text-secondary/40">·</span>
                                            <span>Watched at @h.WatchDate.ToString("HH:mm")</span>
                                        </div>
                                    </div>
                                </a>

                                <div class="flex items-center justify-between sm:justify-end gap-4 flex-shrink-0 pt-1 sm:pt-0">
                                    @if (item.Vibe != null)
                                    {
                                        <div class="flex items-center gap-1 text-tertiary font-title-md text-[13px]" title="Your rating">
                                            <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                            <span>@item.Vibe.CalculateAverage().ToString("0.0", En)</span>
                                            <span class="text-secondary-text text-[11px] font-normal">/ 10</span>
                                        </div>
                                    }

                                    <a href="/media/@item.Id"
                                       class="px-3.5 py-1.5 rounded-lg border border-secondary/40 text-on-surface hover:text-primary hover:border-primary/60 font-title-md text-[12px] transition-colors">
                                        Details
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <!-- Маркер початку історії -->
        <div class="flex items-center justify-center py-8 text-secondary-text">
            <span class="font-label-sm text-[11px]">Beginning of journal</span>
        </div>
    }

    @if (Me.RecentSearches.Count > 0)
    {
        <div class="pt-6 border-t border-secondary/25">
            <h2 class="font-serif text-[20px] text-on-surface mb-4">Recent searches</h2>
            <div class="flex flex-wrap gap-2">
                @foreach (var query in Me.RecentSearches)
                {
                    <a href="@($"/search?q={Uri.EscapeDataString(query)}")"
                       class="px-3.5 py-1.5 rounded-lg border border-secondary/35 text-secondary-text hover:text-primary hover:border-primary/60 transition-colors font-body-md text-[13px]">
                        @query
                    </a>
                }
            </div>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo En = new CultureInfo("en-US");
    private User Me => DataService.CurrentUser;
}