<div class="bg-surface-container-high rounded-xl p-space-md hover:bg-surface-variant transition-all flex flex-col justify-between shadow-sm">
    <div class="flex items-center justify-between mb-space-sm">
        <span class="font-label-caps text-label-caps text-on-surface-variant">@Label</span>
        <span class="p-1 rounded-md bg-surface-container-low @IconClass flex items-center justify-center">
            <span class="material-symbols-outlined text-[16px]">@Icon</span>
        </span>
    </div>
    <div>
        <div class="font-stat-metric text-stat-metric text-on-surface leading-none mb-1">@Value</div>
        <p class="font-label-sm text-label-sm text-on-surface-variant/70">@Caption</p>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Caption { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string IconClass { get; set; } = "text-primary";
}

