@page "/watchlists/{ListName}"
@using MudBlazor
@using MyosotisWeb.ServicesWeb
@inject DemoDataService DataService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Myosotis · @DecodedName</PageTitle>

@if (CurrentList == null)
{
    <div class="w-full px-margin py-20 flex flex-col items-start gap-4 max-w-xl">
        <h1 class="font-headline-xl text-headline-xl text-on-surface leading-none">Watchlist not found.</h1>
        <p class="font-body-md text-[14px] text-secondary-text">
            This list may have been renamed or deleted.
        </p>
        <button @onclick='() => Navigation.NavigateTo("/watchlists")'
                class="mt-2 px-5 py-2.5 bg-primary text-on-primary rounded-lg font-title-md font-semibold text-[13px] hover:opacity-90 transition-opacity">
            Back to Watchlists
        </button>
    </div>
}
else
{
    var totalCount = CurrentList.Entries.Count;
    var watchedCount = CurrentList.Entries.Count(e => Me.IsWatched(e.Item));
    var unwatchedCount = totalCount - watchedCount;
    int progressPercent = totalCount > 0 ? (int)Math.Round((double)watchedCount / totalCount * 100) : 0;

    var timeDebtMinutes = CurrentList.Entries.Sum(e =>
    {
        if (Me.IsWatched(e.Item)) return 0;
        int debt = e.Item.CalculateTimeDebt();
        return debt > 1 ? debt : 0;
    });

    <div class="w-full px-margin py-margin flex flex-col gap-10" @onclick="CloseAllDropdowns">

        <!-- Шапка списку -->
        <header class="flex flex-col gap-6 pb-6 border-b border-secondary/25">
            <div class="flex items-center justify-between gap-4">
                <a href="/watchlists"
                   class="group inline-flex items-center gap-1.5 text-secondary-text hover:text-primary transition-colors font-title-md text-[13px]">
                    <span class="material-symbols-outlined text-[17px] transition-transform group-hover:-translate-x-1">arrow_back</span>
                    <span>Back to Watchlists</span>
                </a>

                <span class="px-2.5 py-1 rounded-md bg-background border border-secondary/30 font-title-md text-[11px] @(CurrentList.IsPrivate ? "text-on-surface" : "text-secondary-text")">
                    @(CurrentList.IsPrivate ? "Private" : "Public")
                </span>
            </div>

            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
                <div class="flex flex-col gap-3 max-w-3xl">
                    <h1 class="font-headline-xl text-headline-xl text-on-surface leading-none">
                        @CurrentList.Name
                    </h1>

                    <!-- Статистика в один рядок замість 4 коробок -->
                    <div class="flex flex-wrap items-center gap-2 font-body-md text-[13px] text-secondary-text">
                        <span>
                            <strong class="text-on-surface font-semibold">@totalCount</strong> @(totalCount == 1 ? "title" : "titles")
                        </span>
                        <span class="text-secondary/40">·</span>
                        <span>
                            <strong class="text-primary font-semibold">@watchedCount</strong> watched (@progressPercent%)
                        </span>
                        <span class="text-secondary/40">·</span>
                        <span>
                            <strong class="text-on-surface font-semibold">@unwatchedCount</strong> unwatched
                        </span>
                        @if (timeDebtMinutes > 0)
                        {
                            <span class="text-secondary/40">·</span>
                            <span>@UiHelpers.FormatMinutes(timeDebtMinutes) left</span>
                        }
                    </div>

                    @if (totalCount > 0)
                    {
                        <div class="flex items-center gap-3 w-full max-w-md mt-1">
                            <div class="flex-1 h-2.5 rounded-full bg-background/80 border border-secondary/35 p-0.5 overflow-hidden">
                                <div class="h-full bg-primary rounded-full transition-all duration-300" style="width: @progressPercent%;"></div>
                            </div>
                            <span class="font-title-md text-[12px] text-on-surface shrink-0">
                                @watchedCount / @totalCount
                            </span>
                        </div>
                    }
                </div>

                <div class="flex flex-wrap items-center gap-3 shrink-0">
                    <button @onclick='() => Navigation.NavigateTo("/search")'
                            class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg bg-primary text-on-primary font-title-md font-semibold text-[13px] hover:opacity-90 transition-opacity">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        <span>Add title</span>
                    </button>

                    <button @onclick="DeleteCurrentWatchlist"
                            class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg border border-secondary/35 text-secondary-text hover:text-error hover:border-error/50 font-title-md text-[13px] transition-colors">
                        <span class="material-symbols-outlined text-[17px]">delete</span>
                        <span>Delete list</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Список тайтлів -->
        <section class="flex flex-col gap-4">
            @if (CurrentList.Entries.Count == 0)
            {
                <div class="py-20 flex flex-col items-center justify-center text-center max-w-md mx-auto gap-4">
                    <h2 class="font-serif text-[22px] text-on-surface">This watchlist is empty</h2>
                    <p class="font-body-md text-[14px] text-secondary-text leading-relaxed">
                        Add movies or series from the catalog or from any title's details page.
                    </p>
                    <button @onclick='() => Navigation.NavigateTo("/search")'
                            class="mt-1 px-5 py-2.5 rounded-lg bg-primary text-on-primary font-title-md font-semibold text-[13px] hover:opacity-90 transition-opacity">
                        Browse catalog
                    </button>
                </div>
            }
            else
            {
                @foreach (var entry in CurrentList.Entries.ToList())
                {
                    var item = entry.Item;
                    var mediaState = Me.MediaStates.FirstOrDefault(s => s.Item.Id == item.Id);
                    var currentStatus = mediaState?.Status;
                    bool isOpen = activeDropdownId == item.Id;
                    int itemTimeDebt = item.CalculateTimeDebt();

                    <article class="bg-surface-variant/20 hover:bg-surface-variant/35 rounded-xl p-5 transition-colors relative group border border-secondary/25">
                        <div class="flex flex-col gap-4">
                            <div class="flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
                                <div class="flex items-start sm:items-center gap-5 min-w-0 flex-1">
                                    <!-- Постер -->
                                    <a href="/media/@item.Id"
                                       class="w-20 h-[120px] flex-shrink-0 rounded-lg overflow-hidden bg-background border border-secondary/30 group-hover:border-primary/50 transition-colors">
                                        @if (!string.IsNullOrEmpty(item.PosterUrl))
                                        {
                                            <img src="@item.PosterUrl" alt="@item.Title" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center text-secondary-text text-[12px]">
                                                —
                                            </div>
                                        }
                                    </a>

                                    <!-- Інформація про тайтл -->
                                    <div class="flex flex-col gap-1.5 min-w-0 flex-1">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            @if (currentStatus.HasValue && currentStatus != WatchStatus.None)
                                            {
                                                <span class="px-2.5 py-0.5 rounded-md bg-secondary-fill text-primary font-title-md text-[11px] inline-flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-[13px]">@GetStatusIcon(currentStatus.Value)</span>
                                                    <span>@currentStatus.Value</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="px-2.5 py-0.5 rounded-md bg-background border border-secondary/30 text-secondary-text font-title-md text-[11px]">
                                                    Unwatched
                                                </span>
                                            }

                                            <span class="font-body-md text-[12px] text-secondary-text">
                                                @(item is Series ? "TV Series" : "Movie") · @item.ReleaseYear
                                            </span>

                                            @if (itemTimeDebt > 1)
                                            {
                                                <span class="text-secondary/40">·</span>
                                                <span class="font-body-md text-[12px] text-secondary-text">@UiHelpers.FormatMinutes(itemTimeDebt)</span>
                                            }
                                        </div>

                                        <div class="flex items-center gap-2">
                                            <a href="/media/@item.Id"
                                               class="font-serif font-semibold text-[20px] text-on-surface hover:text-primary transition-colors truncate">
                                                @item.Title
                                            </a>
                                            @if (Me.IsFavorite(item))
                                            {
                                                <span class="material-symbols-outlined text-[16px] text-tertiary shrink-0"
                                                      style="font-variation-settings: 'FILL' 1;"
                                                      title="Favorite">
                                                    favorite
                                                </span>
                                            }
                                        </div>

                                        <p class="font-body-md text-[13px] text-secondary-text line-clamp-2 max-w-3xl">
                                            @(string.IsNullOrEmpty(item.Description) ? "No description available." : item.Description)
                                        </p>

                                        <!-- Особиста нотатка -->
                                        @if (!string.IsNullOrWhiteSpace(entry.PersonalNote) && !entry.PersonalNote.Contains("Added from details page", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="mt-1 px-3 py-1.5 rounded-lg bg-background/60 border border-secondary/20 w-fit max-w-full">
                                                <span class="font-body-md text-[12px] text-on-surface/90 break-words">“@entry.PersonalNote”</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Дії -->
                                <div class="flex items-center gap-2.5 w-full md:w-auto justify-end pt-3 md:pt-0 border-t md:border-t-0 border-secondary/15 shrink-0">
                                    <button @onclick:stopPropagation="true"
                                            @onclick="() => ToggleDropdown(item.Id)"
                                            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-background hover:border-primary/60 border border-secondary/35 text-on-surface font-title-md text-[12px] transition-colors">
                                        @if (currentStatus.HasValue && currentStatus != WatchStatus.None)
                                        {
                                            <span class="material-symbols-outlined text-[15px] text-primary">@GetStatusIcon(currentStatus.Value)</span>
                                            <span>@currentStatus.Value</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary-text">Set status</span>
                                        }
                                        <span class="material-symbols-outlined text-[16px] text-secondary-text">@(isOpen ? "expand_less" : "expand_more")</span>
                                    </button>

                                    <a href="/media/@item.Id"
                                       class="px-3.5 py-2 rounded-lg border border-secondary/35 text-on-surface hover:text-primary hover:border-primary/60 font-title-md text-[12px] transition-colors">
                                        Details
                                    </a>

                                    <button @onclick="() => Remove(item)"
                                            class="p-2 text-secondary-text hover:text-error rounded-lg border border-transparent hover:border-secondary/25 transition-colors"
                                            title="Remove from list">
                                        <span class="material-symbols-outlined text-[18px]">bookmark_remove</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Панель вибору статусу -->
                            @if (isOpen)
                            {
                                <div @onclick:stopPropagation="true"
                                     class="p-3 rounded-lg bg-background border border-secondary/30 flex flex-wrap items-center gap-2">
                                    <span class="text-[12px] font-title-md text-secondary-text mr-1">Status:</span>
                                    @foreach (WatchStatus st in Enum.GetValues(typeof(WatchStatus)))
                                    {
                                        if (st == WatchStatus.None) continue;

                                        bool isSelected = currentStatus == st;
                                        <button @onclick="() => ChangeStatus(item, st)"
                                                class="px-3 py-1.5 rounded-md text-[12px] font-title-md transition-colors inline-flex items-center gap-1.5 @(isSelected ? "bg-primary text-on-primary font-semibold" : "bg-surface-variant/30 text-on-surface hover:bg-surface-variant/60")">
                                            <span class="material-symbols-outlined text-[14px]">@GetStatusIcon(st)</span>
                                            <span>@st</span>
                                        </button>
                                    }

                                    @if (currentStatus.HasValue && currentStatus != WatchStatus.None)
                                    {
                                        <div class="w-px h-5 bg-secondary/25 mx-1"></div>
                                        <button @onclick="() => ClearItemStatus(item)"
                                                class="px-3 py-1.5 rounded-md text-[12px] font-title-md text-tertiary hover:bg-surface-variant/30 transition-colors inline-flex items-center gap-1"
                                                title="Clear status">
                                            <span class="material-symbols-outlined text-[14px]">close</span>
                                            <span>Clear</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </article>
                }
            }
        </section>
    </div>
}

@code {
    [Parameter] public string ListName { get; set; } = "";

    private string DecodedName => Uri.UnescapeDataString(ListName ?? "");
    private User Me => DataService.CurrentUser;
    private Watchlist? CurrentList => Me.Watchlists.FirstOrDefault(w => w.Name.Equals(DecodedName, StringComparison.OrdinalIgnoreCase));

    private Guid? activeDropdownId = null;

    private void ToggleDropdown(Guid itemId)
    {
        activeDropdownId = activeDropdownId == itemId ? null : itemId;
    }

    private void CloseAllDropdowns()
    {
        activeDropdownId = null;
    }

    private string GetStatusIcon(WatchStatus status)
    {
        return status switch
        {
            WatchStatus.Planned => "schedule",
            WatchStatus.Watching => "play_circle",
            WatchStatus.Watched => "check_circle",
            WatchStatus.Paused => "pause_circle",
            WatchStatus.Dropped => "cancel",
            WatchStatus.Rewatching => "replay",
            _ => "bookmark"
        };
    }

    private async Task ChangeStatus(Media item, WatchStatus newStatus)
    {
        if (newStatus == WatchStatus.Watched)
        {
            Me.CompleteWatching(item);
        }
        else
        {
            Me.SetStatus(item, newStatus);
        }
        activeDropdownId = null;
        await DataService.SaveStateAsync();
        Snackbar.Add($"Status updated to {newStatus}", Severity.Success);
        StateHasChanged();
    }

    private async Task Remove(Media item)
    {
        CurrentList?.RemoveEntry(item);
        await DataService.SaveStateAsync();
        Snackbar.Add("Item removed from list", Severity.Info);
        StateHasChanged();
    }

    private async Task ClearItemStatus(Media item)
    {
        Me.ClearStatus(item);
        activeDropdownId = null;
        await DataService.SaveStateAsync();
        Snackbar.Add("Status cleared", Severity.Info);
        StateHasChanged();
    }

    private async Task DeleteCurrentWatchlist()
    {
        if (CurrentList == null) return;

        string name = CurrentList.Name;
        bool success = Me.RemoveWatchlist(CurrentList.Id);

        if (success)
        {
            await DataService.SaveStateAsync();
            Snackbar.Add($"Watchlist \"{name}\" deleted", Severity.Info);
            Navigation.NavigateTo("/watchlists");
        }
    }
}