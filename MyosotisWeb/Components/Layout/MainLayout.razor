@inherits LayoutComponentBase
@using MudBlazor
@inject NavigationManager Navigation
@inject MyosotisWeb.ServicesWeb.DemoDataService DataService

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="bg-surface font-body-md text-body-md text-on-surface antialiased">

    <!-- БІЧНЕ МЕНЮ -->
    <aside class="fixed left-0 top-0 h-full w-[240px] bg-surface-container-low border-r border-surface-variant/40 z-50 flex flex-col justify-between">
        <div class="flex flex-col">
            <div class="h-16 px-space-md flex items-center gap-space-sm border-b border-surface-variant/30">
                <img src="images/myosotis-logo.png" alt="" class="w-7 h-7 object-contain" onerror="this.style.display='none'" />
                <span class="font-headline-md text-headline-md text-primary tracking-wide">Myosotis</span>
            </div>

            <nav class="flex flex-col gap-space-xs px-space-sm pt-space-lg">
                @foreach (var item in navItems)
                {
                    <NavLink href="@item.Href"
                             Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                             class="flex items-center gap-space-sm px-space-md py-space-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all"
                             ActiveClass="bg-surface-container-high text-on-surface">
                        <span class="material-symbols-outlined text-[18px]">@item.Icon</span>
                        <span>@item.Label</span>
                    </NavLink>
                }
            </nav>
        </div>

        <div class="p-space-md border-t border-surface-variant/30 bg-surface-container-lowest/40">
            <div class="flex items-center gap-space-sm">
                <div class="w-9 h-9 rounded-full bg-secondary text-on-primary-container flex items-center justify-center font-title-md text-title-md">@Initial</div>
                <div class="flex flex-col min-w-0">
                    <span class="font-title-md text-title-md text-on-surface truncate">@Me.Username</span>
                    <span class="font-label-sm text-label-sm text-on-surface-variant truncate">@Me.WatchHistory.Count titles logged</span>
                </div>
            </div>
        </div>
    </aside>

    <div class="pl-[240px]">

        <!-- ШАПКА -->
        <header class="fixed top-0 left-[240px] right-0 h-16 bg-surface/80 backdrop-blur-xl border-b border-surface-variant/30 z-40 flex items-center justify-between px-margin">
            <div class="flex items-center gap-space-sm w-80 bg-surface-container-low px-space-md py-space-xs rounded-lg border border-surface-variant/40">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">search</span>
                <input @bind="searchText"
                       @bind:event="oninput"
                       @onkeydown="OnSearchKey"
                       placeholder="Search your library…"
                       class="bg-transparent outline-none w-full text-on-surface placeholder:text-on-surface-variant/60" />
            </div>
        </header>

        <!-- СТОРІНКИ -->
        <main class="relative pt-16 bg-surface min-h-screen">
            @Body
        </main>
    </div>
</div>

@code {
    private readonly (string Href, string Icon, string Label)[] navItems =
    {
        ("/", "dashboard", "Overview"),
        ("/watchlists", "bookmark", "Watchlists"),
        ("/captures", "format_quote", "Captures"),
        ("/history", "schedule", "History")
    };

    private string searchText = "";

    private User Me => DataService.CurrentUser;

    private string Initial => string.IsNullOrEmpty(Me.Username) ? "?" : Me.Username.Substring(0, 1).ToUpper();

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(searchText)) return;
        Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchText.Trim())}");
    }

    private void GoToCaptures()
    {
        Navigation.NavigateTo("/captures");
    }


    private MudTheme _theme = new MudTheme
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#84DCC6",
            Secondary = "#5C80BC",
            Tertiary = "#D4915A",
            Background = "#1A2235",
            Surface = "#232A47",
            TextPrimary = "#E2E8F0",
            TextSecondary = "#A3ADC2"
        }
    };
}
