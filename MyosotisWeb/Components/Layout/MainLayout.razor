@inherits LayoutComponentBase
@using MudBlazor
@inject NavigationManager Navigation
@inject MyosotisWeb.ServicesWeb.DemoDataService DataService

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="bg-surface font-body-md text-body-md text-on-surface antialiased min-h-screen">

    <!-- БІЧНЕ МЕНЮ -->
    <aside class="fixed left-0 top-0 h-full w-[240px] bg-surface-container-low border-r border-secondary/30 z-50 flex flex-col justify-between">
        <div class="flex flex-col">
            <div class="h-16 px-4 flex items-center gap-3 border-b border-secondary/20">
                <img src="images/logo-icon.png" alt="Myosotis" class="w-7 h-7 object-contain drop-shadow-[0_0_8px_rgba(132,220,198,0.4)]" />
                <span class="font-headline-md text-headline-md text-primary tracking-wide">Myosotis</span>
            </div>

            <nav class="flex flex-col gap-1 px-3 pt-6">
                @foreach (var item in navItems)
                {
                    <NavLink href="@item.Href"
                             Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                             class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-on-surface-variant hover:bg-secondary/15 hover:text-on-surface transition-all"
                             ActiveClass="bg-secondary/20 text-white font-medium">
                        <span class="material-symbols-outlined text-[18px]">@item.Icon</span>
                        <span>@item.Label</span>
                    </NavLink>
                }
            </nav>
        </div>

        <div class="p-4 border-t border-secondary/20 bg-surface-container-lowest/40">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-secondary text-on-primary-container flex items-center justify-center font-title-md text-title-md font-bold">@Initial</div>
                <div class="flex flex-col min-w-0">
                    <span class="font-title-md text-title-md text-on-surface truncate">@Me.Username</span>
                    <span class="font-label-sm text-label-sm text-secondary truncate">@Me.WatchHistory.Count titles logged</span>
                </div>
            </div>
        </div>
    </aside>

    <div class="pl-[240px]">

        <header class="fixed top-0 left-[240px] right-0 h-16 bg-surface/80 backdrop-blur-xl border-b border-secondary/30 z-40 flex items-center justify-between px-8">
            <div class="flex items-center gap-3 w-80 bg-surface-container-low px-4 py-2 rounded-xl border border-secondary/30 focus-within:border-primary focus-within:bg-surface-container transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px] text-secondary">search</span>
                <input @bind="searchText"
                       @bind:event="oninput"
                       @onkeydown="OnSearchKey"
                       placeholder="Search your library…"
                       class="bg-transparent outline-none w-full text-on-surface placeholder:text-on-surface-variant/60" />
            </div>
        </header>

        <main class="relative pt-16 bg-surface min-h-screen">
            @Body
        </main>
    </div>
</div>

@code {
    private readonly (string Href, string Icon, string Label)[] navItems =
    {
        ("/search", "search", "Catalog"),
        ("/", "dashboard", "Overview"),
        ("/watchlists", "bookmark", "Watchlists"),
        ("/captures", "format_quote", "Captures"),
        ("/history", "schedule", "History")
    };

    private string searchText = "";

    private User Me => DataService.CurrentUser;

    private string Initial => string.IsNullOrEmpty(Me.Username) ? "?" : Me.Username.Substring(0, 1).ToUpper();

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(searchText)) return;
        Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchText.Trim())}");
    }

    private MudTheme _theme = new MudTheme
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#84DCC6",
            Secondary = "#5C80BC",
            Tertiary = "#D4915A",
            Background = "#1A2235",
            Surface = "#1A2235",
            TextPrimary = "#E2E8F0",
            TextSecondary = "#5C80BC"
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await DataService.InitializeAsync();
            StateHasChanged();
        }
    }
}